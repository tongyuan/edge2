APP_ENV=production
EDGE2_DB_NAME=edge2
EDGE2_DB_USER=edge2
EDGE2_DB_PASSWORD=
EDGE2_DB_PORT=5435
EDGE2_APP_PORT=8792
EDGE2_INGRESS_PORT=8793

REQUIRE_WEBHOOK_SECRET=true
WEBHOOK_SECRET=
MAX_REQUEST_BYTES=32768
LOG_LEVEL=INFO

# Optional until Web Push is enabled. Configure all three together. Keep the
# private key only in the remote .env; the public key is served to the browser.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Example: mailto:operator@example.com
WEB_PUSH_VAPID_SUBJECT=

# Optional authoritative tick overrides. Without an override, EDGE 2.0 uses
# the smallest decimal quantum represented by the confirming observations.
EDGE2_SYMBOL_TICKS_JSON={"SPXUSDT":"0.0001"}

# Host backup destination; must remain outside container filesystems.
EDGE2_BACKUP_DIR=/home/tony/edge2-backups
