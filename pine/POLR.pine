// ERL x IRL PO3 (M1D)
//
// Modules: dealing range on a higher timeframe (followed at chart scope, levels anchored on the bar
// that printed them) · failed push · sweep · MSS with displacement gate and NY session window ·
// arrays BISI / SIBI / VI / SB / IFVG / Breaker / OTE, graded · position in range · RR to draw ·
// NQ / ES / YM cross-check with catch-up gap · console · alerts.
//
// Notes: the dealing range forms once and holds until a close through a side; the raided side
// freezes as the spent sweep line, the other side is the draw; a side that breaks stays in grey
// while the range rebuilds from the leg's origin and the new side forms on price. Internal
// arrays draw only after the MSS. Breaker draws as levels by default (input for zone). A suspension
// block absorbs the gap and imbalance of its own triplet and a gap absorbs the imbalance on its own
// seams, so one leg counts once. SMT on chart: the line across the chart's two lows (or highs) when
// a peer held its own level through the sweep. Five request.security calls in total.

//@version=6
indicator('POLR', 'POLR', overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// The breaker and lookback-sweep searches walk bar history from the MSS back to the swings they
// reference; give the price series enough history for that walk on a wide range.
max_bars_back(open, 600)
max_bars_back(high, 600)
max_bars_back(low, 600)
max_bars_back(close, 600)
// `time` alone goes to the ceiling: every drawing here is anchored on a stored origin, and placing that
// x walks `time` back to it. 600 covered a 5m chart; on 1m yesterday's swing is ~1,400 bars back and the
// script would stop with "requested historical offset is beyond the historical buffer's limit".
max_bars_back(time, 5000)

// ============================================================================
// VISUAL STANDARD — see the indicator-visual-style skill
// ============================================================================
// Bullish purple, bearish magenta, everything neutral black, against a WHITE chart.
// Black is the hex. Pine's color.black is #363A45 slate grey and renders grey on white.
const color K_BULL = #7246CE
const color K_BEAR = #DB1D9C
const color K_INK  = #000000
const color K_GRAY = #787B86
const color C_NONE = color.new(#FFFFFF, 100)

// ============================================================================
// INPUTS
// ============================================================================
const string G_RANGE = 'Dealing range (higher timeframe)'
const string G_SETUP = 'Setup (chart timeframe)'
const string G_SESS  = 'Session (New York time)'
const string G_ARR   = 'PD arrays and grade'
const string G_ENTRY = 'Entry lifecycle (observation only)'
const string G_XC    = 'Cross-check NQ · ES · YM'
const string G_PO3   = 'PO3 candle (range timeframe)'
const string G_SHOW  = 'Display'
const string G_STYLE = 'Style'

string rangeTf      = input.timeframe('60', 'Range timeframe',                         group = G_RANGE,
    tooltip = 'The draw is found here, executed on the chart. 1H · 4H · 6H · Daily · Weekly.')
int    htfLen       = input.int(3,     'Range swing strength (candles each side)',       minval = 1,  maxval = 10,  group = G_RANGE)
bool   drHold       = input.bool(false, 'Hold the range until a close through a side',                         group = G_RANGE,
    tooltip = 'Off: each side is the latest swing the range timeframe has confirmed, so the range moves swing to swing. On: the range forms once from the widest swings in the lookback and holds until a close goes through a side.')
int    lookbackCdl  = input.int(60,    'Range lookback (range-timeframe candles)',       minval = 10, maxval = 300, group = G_RANGE,
    tooltip = 'Used when the range is held: the window the first range is built from, its highest and lowest swings. Also the window a failed push is judged against.')
float  minRangeAtr  = input.float(2.0, 'Minimum range (x ATR14)',                        minval = 0,  step = 0.5,   group = G_RANGE)
bool   requirePush  = input.bool(false, 'Require a failed push at the far side',                                    group = G_RANGE,
    tooltip = 'Off: the sweep is the trigger and whatever forms after it is tracked. On: the range must first have pushed at the far side and failed.')
int    pushReachPct = input.int(75,    'Failed push must reach (% of range)',            minval = 0,  maxval = 100, group = G_RANGE)

int   pivLen      = input.int(3,     'Execution swing strength (bars each side)',    minval = 1,  maxval = 20,   group = G_SETUP)
float minDispAtr  = input.float(1.0, 'MSS displacement from the sweep (x ATR14)',   minval = 0,  step = 0.25,   group = G_SETUP,
    tooltip = 'The V. The leg from the sweep extreme to the MSS close has to clear this, or the shift is a grind and the script keeps waiting.')
int   reclaimCdl  = input.int(1,     'Sweep must reclaim within (range-timeframe candles)', minval = 1, maxval = 10, group = G_SETUP,
    tooltip = 'A wick through the level is the sweep. The level belongs to the range timeframe, so the reclaim is judged there: price may close beyond the level on the chart, but not for longer than this many range candles — after that the raid is a break.')
float sweepExpiryH = input.float(12, 'Sweep expires after (hours) without MSS',     minval = 0.5, maxval = 500,  step = 0.5, group = G_SETUP,
    tooltip = 'Counted in time, not bars, so the setup lives the same 12 hours on a 1m chart as on a 30m one. Never shorter than 16 chart bars, which only matters at 1H and above.')
float setupMaxAgeH = input.float(24, 'Retire a live setup after (hours from MSS)',  minval = 1,   maxval = 1000, step = 1,   group = G_SETUP,
    tooltip = 'Counted in time, not bars. Never shorter than 32 chart bars, which only matters at 1H and above.')
int   keepSetups  = input.int(5,     'Keep last setups per direction',               minval = 1,  maxval = 10,   group = G_SETUP)
bool  showEarly   = input.bool(false, 'Show the sweep before the MSS confirms',                                  group = G_SETUP)
bool  requireSmt  = input.bool(true, 'MSS needs the SMT at the sweep',                                          group = G_SETUP,
    tooltip = 'The model: ERL taken, a close back inside, and at least one peer that did NOT take its own level. A raid without the SMT is not the setup; it is cleared and the same swing waits for a raid that has one. Ignored where there are no peers to read.')

string sessMode = input.string('Off', 'MSS must confirm inside',
    options = ['Off', 'RTH 09:30-16:00', 'NY AM 07:00-09:00', 'NY AM KZ 08:30-11:00', 'NY PM 13:30-16:00'], group = G_SESS,
    tooltip = 'New York time. Off shows every setup, for scanning back through the chart. A window keeps the live alerts to the session you trade. Ignored on Daily and higher.')

float minGapAtr = input.float(0.1,  'Minimum gap height (x ATR14)', minval = 0, step = 0.05, group = G_ARR,
    tooltip = 'Applies to the displacement gap, the volume imbalance and the suspension block.')
float oteFrom   = input.float(0.62, 'OTE band from',                minval = 0.5, maxval = 1, step = 0.01, group = G_ARR)
float oteTo     = input.float(0.79, 'OTE band to',                  minval = 0.5, maxval = 1, step = 0.01, group = G_ARR)
string oteSwing = input.string('Range timeframe', 'OTE leg ends at the first swing of', options = ['Range timeframe', 'Chart (two-candle)'], group = G_ARR,
    tooltip = 'Range timeframe: the leg ends at the first swing the range timeframe confirms after the MSS — the swing you would draw the fib to on the higher timeframe. Chart: the first two-candle swing on this chart, which on a low timeframe can be a very small leg.')
bool  oteRatchet = input.bool(false, 'OTE follows higher swings until touched', group = G_ARR,
    tooltip = 'Off: the leg ends at the FIRST two-candle swing after the MSS and the band stays there. On: each higher swing re-measures the band until price has traded into it.')
int   oteLook   = input.int(75, 'OTE leg lookback (bars)', minval = 5, maxval = 300, group = G_ARR,
    tooltip = 'A cap. The leg starts at the lowest low (highest high) between just before the first breach of the level and the MSS bar, but never further back than this many bars. It is the 0 of the fib.')
bool  swOteOn   = input.bool(false, 'Swing-leg OTE between setups', group = G_ARR,
    tooltip = 'An OTE band on the latest swing leg, low to high or high to low, drawn while no setup is live. The leg extends with each new extreme, restarts from the pullback that launched a new high or low, and turns when a candle body closes beyond the far edge of the band. A setup keeps its own OTE.')
int   swOteStr  = input.int(1, 'Swing-leg OTE swing strength', minval = 1, maxval = 10, group = G_ARR,
    tooltip = 'Candles each side that make a swing for the swing-leg OTE. 1 reads every pullback a hand-drawn fib would anchor on.')
string brkMode  = input.string('Levels', 'Breaker drawing', options = ['Levels', 'Zone'], group = G_ARR)
float obDispAtr = input.float(1.0, 'Order block displacement body (x ATR14)', minval = 0.1, step = 0.1, group = G_ARR,
    tooltip = 'The Unicorn / Confluence Engine reading. An order block exists only where a candle with a body this large closed through the last chart swing and left a gap behind it. The breaker is that block once a close passes back through it.')
int   gradeA    = input.int(3, 'Arrays for grade A',  minval = 1, maxval = 6, group = G_ARR)
int   gradeAp   = input.int(4, 'Arrays for grade A+', minval = 1, maxval = 6, group = G_ARR,
    tooltip = 'Six candidates: BISI or SIBI, VI, SB, IFVG, Breaker, OTE. A suspension block replaces the gap and imbalance of its own triplet; a gap absorbs the imbalance on its own seams.')
float minRR     = input.float(2.0, 'Minimum risk-to-reward to the draw', minval = 0.5, step = 0.5, group = G_ARR,
    tooltip = 'Measured from the nearest internal array to the target, with the stop at the sweep extreme. A minimum, not a target.')

bool   entryOn          = input.bool(true, 'Track entry lifecycle', group = G_ENTRY,
    tooltip = 'Observation only. Draws and records candidate/confirmed entry attempts; it never places an order.')
string entryMinGrade    = input.string('A+', 'Required grade', options = ['Off', 'A', 'A+'], group = G_ENTRY,
    tooltip = 'Off removes the grade gate. A accepts A or A+. A+ requires A+.')
bool   entryRequireOte  = input.bool(true, 'OTE required', group = G_ENTRY,
    tooltip = 'On requires a confirmed 0.62–0.79 OTE band and a live PD array overlapping it. A historical touch before the endpoint confirms is never backdated.')
string entryConfirm     = input.string('CE_RECLAIM', 'Confirmation', options = ['CE_RECLAIM', 'PROXIMAL_RECLAIM'], group = G_ENTRY,
    tooltip = 'CE_RECLAIM confirms on a close back through the frozen candidate midpoint. PROXIMAL_RECLAIM requires a close through its near edge.')
int    entryMaxConfirmed = input.int(1, 'Maximum confirmed entries', minval = 1, maxval = 5, group = G_ENTRY)
bool   entryReentry     = input.bool(false, 'Allow re-entry after a stopped entry', group = G_ENTRY)

bool   xcOn   = input.bool(true, 'Cross-check the peers', group = G_XC,
    tooltip = 'NQ pairs with ES and YM, ES with NQ and YM, YM with NQ and ES, micros included. Off automatically on anything else.')
string gapTf  = input.string('60', 'Catch-up gap timeframe', options = ['30', '60'], group = G_XC,
    tooltip = 'When the chart is the laggard, a fair value gap here in the catch-up direction, formed after the others took the level, is the confirmation.')

bool showFvg     = input.bool(true, 'Displacement gap (BISI / SIBI)', group = G_SHOW)
bool showVi      = input.bool(true, 'Volume imbalance (VI)',           group = G_SHOW)
bool showSb      = input.bool(true, 'Suspension block (SB)',           group = G_SHOW)
bool showIfvg    = input.bool(true, 'IFVG',                            group = G_SHOW)
bool showBrk     = input.bool(true, 'Breaker',                         group = G_SHOW)
bool showOte     = input.bool(true, 'OTE',                             group = G_SHOW)
bool showCe      = input.bool(true, 'Consequent encroachment (gap, IFVG, SB midline)', group = G_SHOW)
bool drawRange   = input.bool(true, 'Dealing range (both sides, before any setup)', group = G_SHOW,
    tooltip = 'The range draws as soon as it exists. The raided side freezes as the spent sweep line, the other side is the draw. A side that breaks stays up alone in grey until the range timeframe prints a new swing.')
bool showSmt     = input.bool(true, 'SMT on chart (peer held the swept level)', group = G_SHOW,
    tooltip = 'A line across the chart\'s own two lows (or highs) at the sweep, tagged with the peer that did not take its level. Removed if every peer takes it.')
bool showMssLvl  = input.bool(true, 'The level a close must break for the MSS', group = G_SHOW,
    tooltip = 'Marks the chart swing a close has to clear for the shift to confirm, from the sweep until the MSS prints. It follows the newest qualifying swing, and is not drawn when that swing sits at or past the draw.')
bool showThirds  = input.bool(false, 'Range thirds (dotted)',          group = G_SHOW)
bool  ambOn      = input.bool(true, 'Arrays between setups',            group = G_SHOW,
    tooltip = 'The BISI and SIBI, VI, SB, IFVG and breakers on the chart while no setup owns them, drawn lighter than a setup\'s own arrays. Each kind follows its own switch above. An array a setup has counted is drawn by the setup, never twice.')
int   ambMax     = input.int(2, 'Arrays per direction',   minval = 1, maxval = 12, group = G_SHOW, tooltip = 'Nearest to price first.')
float ambMaxAtr  = input.float(8.0, 'Arrays within (x ATR)', minval = 1, step = 0.5, group = G_SHOW, tooltip = 'An array further from price than this is not drawn. It still exists and a setup can still count it.')
bool  showSwings = input.bool(true, 'Swing structure (HH · HL · LH · LL)', group = G_SHOW,
    tooltip = 'The chart swings the MSS is read from, tagged at the candle that made them, outside the wick.')
int   swingMax   = input.int(2, 'Swings per side', minval = 1, maxval = 20, group = G_SHOW)

// ── The liquidity POOLS either side of the range. The dealing range gives two levels - its own
//    edges - and that was every level this script drew. These are the pools price is actually
//    reaching for between them. Ported from BSL/SSL Liquidity (M1D): the same pivot pools, the
//    same equal-level merge, the same previous-period levels, the same NEW YORK clock.
string G_LIQ = 'Liquidity pools'
bool  poolsOn   = input.bool(true,  'Draw liquidity pools', group = G_LIQ, tooltip = 'The dealing range draws its two edges and nothing else. These are the pools between and beyond them - the swing highs and lows price is reaching for. Solid while live, dotted once taken, the same language as every other level here.')
bool  poolSwing = input.bool(true,  'Swing pools',    inline = 'ps', group = G_LIQ)
bool  poolPd    = input.bool(true,  'PDH / PDL',      inline = 'ps', group = G_LIQ)
bool  poolPw    = input.bool(true,  'PWH / PWL',      inline = 'ps', group = G_LIQ)
bool  poolPaired= input.bool(true,  'Swing pools must be PAIRED (REH / REL)', group = G_LIQ, tooltip = 'A lone swing high is not resting liquidity - it is one candle. A pool needs TWO pivots within the tolerance below, the Liquidity Levels+ definition. Off draws every swing, which is what fills the chart with lines.')
bool  poolOutside= input.bool(false, 'External only - nothing inside the dealing range', group = G_LIQ, tooltip = 'Off: relative equal highs and lows inside the range are drawn too - resting liquidity inside the range is still a draw. On: only pools beyond the two range edges are drawn.')
float poolEqAtr = input.float(0.20, 'Equal-level tolerance (x ATR)', minval = 0.02, step = 0.05, group = G_LIQ, tooltip = 'Two swings within this much of one another are ONE pool, and it is labelled REH or REL. This is what stops a dozen near-identical highs drawing as a dozen lines.')
int   poolMax   = input.int(5,      'Max pools per side', minval = 1, maxval = 12, group = G_LIQ, tooltip = 'Nearest to price first. A cap, not a filter - the pools beyond it still exist, they are just not drawn.')
float poolMaxAtr= input.float(8.0,  'Max distance from price (x ATR)', minval = 1.0, step = 0.5, group = G_LIQ, tooltip = 'A pool further than this is not in play on this chart and is not drawn.')
bool  poolKeep  = input.bool(false, 'Keep taken liquidity on the chart', group = G_LIQ, tooltip = 'Off: liquidity that has been run is GONE - pools, both dealing-range edges and the broken side. A level that has been taken is not a draw any more and drawing it dotted still leaves it on the chart to be read as one. On: it stays, dotted and grey, which is the record of where price has already been.')
bool showConsole = input.bool(true, 'Console',                         group = G_SHOW)
string conPos    = input.string('Top right', 'Console position', options = ['Top right', 'Top left', 'Bottom right', 'Bottom left'], group = G_SHOW)

bool  showPo3     = input.bool(true, 'Draw the current range-timeframe candle beside price', group = G_PO3,
    tooltip = 'The PO3 read: the live candle of the range timeframe, rebuilt on every tick, never left as history. Hidden when the chart is not below the range timeframe.')
int   po3Gap      = input.int(10, 'Gap past the level labels (bars)', minval = 1, maxval = 500, group = G_PO3, tooltip = 'Counted from the right offset where the level labels sit, so the candle always clears them.')
int   po3Wide     = input.int(6,  'Candle width (bars)',        minval = 1, maxval = 100, group = G_PO3)
color po3UpIn       = input.color(#FFFFFF, 'Up body',   group = G_PO3, inline = 'po3')
color po3DnIn       = input.color(#4A4A4A, 'Down body', group = G_PO3, inline = 'po3')
color po3EdgeIn     = input.color(#000000, 'Outline / wick', group = G_PO3)
bool  po3Levels   = input.bool(true, 'Open / high / low / close lines', group = G_PO3)
bool  po3Divider  = input.bool(true, 'Open divider',                    group = G_PO3)
bool  po3FullDiv  = input.bool(true, 'Divider runs full height',        group = G_PO3)
bool  po3Tags     = input.bool(true, 'Price tags',                      group = G_PO3)

string chartTheme = input.string('Light', 'Chart theme', options = ['Light', 'Dark'], group = G_STYLE, tooltip = 'Dark lightens every colour the script draws on the chart - gaps, blocks, levels, the PO3 candle, lines and labels - so they read on a dark background. The colours you set are kept and lifted, not replaced. The console keeps its own light panel either way.')
string labelSize = input.string('small', 'Label text size', options = ['tiny', 'small', 'normal', 'large'], group = G_STYLE)
int   runwayBars = input.int(10, 'Right offset (bars)',       minval = 0, maxval = 100, group = G_STYLE)
int   liqWidth   = input.int(2,  'Liquidity line width',      minval = 1, maxval = 4,   group = G_STYLE)
color liqColIn     = input.color(#000000, 'Liquidity line colour',  group = G_STYLE,
    tooltip = 'The two dealing range sides, the swept level and the draw. A side left behind by a break stays grey, and every name stays black.')
// Opacity, not transparency: the number you set is how solid the fill is.
int   gapOpac    = input.int(25, 'Gap fill opacity (%)',      minval = 0, maxval = 100, group = G_STYLE, tooltip = 'BISI / SIBI, VI and IFVG. The house figure is 35; 25 is a shade lighter.')
int   blockOpac  = input.int(12, 'Block fill opacity (%)',    minval = 0, maxval = 100, group = G_STYLE, tooltip = 'SB and the breaker zone. The border stays solid.')
color oteColIn     = input.color(#4A4A4A, 'OTE band colour',       group = G_STYLE, tooltip = 'Blackish grey by default: the OTE is a measurement, not a directional array, so it does not wear the direction colour.')
int   bandOpac   = input.int(20, 'OTE band opacity (%)',      minval = 0, maxval = 100, group = G_STYLE)
color invColIn     = input.color(#ff5600, 'Inversion colour (IFVG)', group = G_STYLE, tooltip = 'Orange means inverted. An IFVG wears this in place of the direction colour, on a setup and between setups.')
int   gapFill    = 100 - gapOpac
int   blockFill  = 100 - blockOpac
int   bandFill   = 100 - bandOpac

bool isDark = chartTheme == 'Dark'

//@function A colour lifted toward white on the Dark theme, unchanged on Light.
//@param c (color) The colour as set.
//@returns (color) The colour to draw with.
f_lift(color c) =>
    isDark ? color.rgb(color.r(c) + (255 - color.r(c)) * 0.45, color.g(c) + (255 - color.g(c)) * 0.45, color.b(c) + (255 - color.b(c)) * 0.45, color.t(c)) : c

//@function A line or text colour for the theme: pure black becomes light ink on Dark, anything else is lifted.
//@param c (color) The colour as set.
//@returns (color) The colour to draw with.
f_ink(color c) =>
    isDark and color.r(c) == 0 and color.g(c) == 0 and color.b(c) == 0 ? color.new(#E6E6EF, color.t(c)) : f_lift(c)

color C_BULL  = f_lift(K_BULL)
color C_BEAR  = f_lift(K_BEAR)
color C_INK   = f_ink(K_INK)
color C_GRAY  = isDark ? #A3A6B0 : K_GRAY
color po3Up   = f_lift(po3UpIn)
color po3Dn   = f_lift(po3DnIn)
color po3Edge = f_ink(po3EdgeIn)
color liqCol  = f_ink(liqColIn)
color oteCol  = f_lift(oteColIn)
color invCol  = f_lift(invColIn)
// The inversion orange thins to a muddy brown on a dark background at the gap opacity, so on Dark it fills heavier.
int   ifvgFill = isDark ? 100 - math.min(math.round(gapOpac * 1.6), 100) : gapFill

// ============================================================================
// RESOLVED CONSTANTS
// ============================================================================
//@function Resolves the label size input once.
//@param s (string) The input value
//@returns (string) A size.* constant
f_lblSize(string s) =>
    switch s
        'tiny'  => size.tiny
        'small' => size.small
        'large' => size.large
        =>         size.normal

string LBL_SZ   = f_lblSize(labelSize)
int    chartSec = timeframe.in_seconds(timeframe.period)
int    msPerBar = chartSec * 1000
int    htfSec   = timeframe.in_seconds(rangeTf)
// The reclaim allowance in chart bars: one range candle's worth of chart bars, times the input.
int    reclaimBars = math.max(1, math.round(reclaimCdl * math.max(1.0, htfSec / timeframe.in_seconds())))
// The two timers in milliseconds of chart time. A bar count means 5 hours on 1m and 6 days on 30m;
// hours mean the same thing on every timeframe below 1H. The bar floor keeps a daily chart sane.
int    sweepExpiryMs = math.max(int(sweepExpiryH * 3600000), 16 * msPerBar)
int    setupMaxAgeMs = math.max(int(setupMaxAgeH * 3600000), 32 * msPerBar)
bool   sameTf   = htfSec <= chartSec
int    htfMs    = (sameTf ? chartSec : htfSec) * 1000
bool   gapOnChart = timeframe.in_seconds(gapTf) <= chartSec

//@function Names a timeframe the way a trader says it.
//@param sec (int) The timeframe in seconds
//@returns (string) e.g. 5m, 1H, Daily
f_tfName(int sec) =>
    switch
        sec < 60             => str.tostring(sec) + 's'
        sec < 3600           => str.tostring(sec / 60) + 'm'
        sec < 86400          => str.tostring(sec / 3600) + 'H'
        sec == 86400         => 'Daily'
        sec < 604800         => str.tostring(sec / 86400) + 'D'
        sec == 604800        => 'Weekly'
        =>                      'Monthly'

string TF_NAME  = f_tfName(chartSec)
string RTF_NAME = f_tfName(htfSec)
string GTF_NAME = f_tfName(timeframe.in_seconds(gapTf))

//@function The chart timeframe tag a PD array's name carries.
//@returns (string) e.g. M5, M15, H1, H4, D
f_tfTag() =>
    switch
        timeframe.isseconds                                    => 'S' + str.tostring(timeframe.multiplier)
        timeframe.isminutes and timeframe.multiplier % 60 == 0 => 'H' + str.tostring(timeframe.multiplier / 60)
        timeframe.isminutes                                    => 'M' + str.tostring(timeframe.multiplier)
        timeframe.isdaily                                      => 'D'
        timeframe.isweekly                                     => 'W'
        timeframe.ismonthly                                    => 'MN'
        =>                                                        timeframe.period

string TF_TAG = f_tfTag()

//@function A PD array's name: kind, direction sign, chart timeframe.
//@param kind (int) 0 gap · 1 VI · 2 SB · 3 IFVG · 4 breaker
//@param d (int) 1 bullish, -1 bearish
//@returns (string) e.g. BISI + M15, SIBI - M15, IFVG + M15
f_arrTag(int kind, int d) =>
    string k = switch kind
        0 => d > 0 ? 'BISI' : 'SIBI'
        1 => 'VI'
        2 => 'SB'
        3 => 'IFVG'
        =>   'Breaker'
    k + (d > 0 ? ' +' : ' -') + ' ' + TF_TAG

string sessStr = switch sessMode
    'NY AM 07:00-09:00'    => '0700-0900'
    'NY AM KZ 08:30-11:00' => '0830-1100'
    'NY PM 13:30-16:00'    => '1330-1600'
    =>                        '0930-1600'

int  sessT  = time(timeframe.period, sessStr, 'America/New_York')
bool inSess = sessMode == 'Off' or not timeframe.isintraday or not na(sessT)

// ── Peers, resolved from the symbol root ──
string root    = syminfo.root
bool   isIndex = root == 'NQ' or root == 'MNQ' or root == 'ES' or root == 'MES' or root == 'YM' or root == 'MYM'
string peer1Sym = switch root
    'NQ'  => 'CME_MINI:ES1!'
    'MNQ' => 'CME_MINI:ES1!'
    'ES'  => 'CME_MINI:NQ1!'
    'MES' => 'CME_MINI:NQ1!'
    'YM'  => 'CME_MINI:NQ1!'
    'MYM' => 'CME_MINI:NQ1!'
    =>       syminfo.tickerid
string peer2Sym = switch root
    'YM'  => 'CME_MINI:ES1!'
    'MYM' => 'CME_MINI:ES1!'
    =>       isIndex ? 'CBOT_MINI:YM1!' : syminfo.tickerid
string peer1Name = switch root
    'NQ'  => 'ES'
    'MNQ' => 'ES'
    =>       'NQ'
string peer2Name = root == 'YM' or root == 'MYM' ? 'ES' : 'YM'
string selfName  = root == 'MNQ' ? 'NQ' : root == 'MES' ? 'ES' : root == 'MYM' ? 'YM' : root
bool   xcLive    = xcOn and isIndex

float atr     = ta.atr(14)
// Equal-level work is STRUCTURAL, so it is measured on the range timeframe, not the chart's. On a
// 1m chart ta.atr(14) spans fourteen minutes: scaled by 0.20 it made the merge tolerance smaller
// than a tick, so a band of near-identical highs drew as a line each instead of one EQH. Capped
// because the length is a bar count and a deep intraday chart would otherwise ask for thousands.
int   atrStructLen = math.min(500, math.max(14, 14 * htfSec / chartSec))
float atrStruct    = ta.atr(atrStructLen)
float ph      = ta.pivothigh(high, pivLen, pivLen)
float pl      = ta.pivotlow(low, pivLen, pivLen)
// The OTE leg's swings, the two-candle reading: a high the candle after it does not exceed, above
// the candle before it — the top of an up move with the turn-down after it. Ties on the turn count,
// so a double-top candle pair still reads as one swing. Mirror for the low. Known one bar after.
float ph2     = high[1] >= high and high[1] > high[2] ? high[1] : na
float pl2     = low[1] <= low and low[1] < low[2] ? low[1] : na

// ── The range timeframe, followed at chart scope so every level knows its bar (no request) ──
int  htfT      = sameTf ? time : time(rangeTf)
bool newCandle = htfT != htfT[1]

// ── Peers and the catch-up timeframe: the previous COMPLETED candle, non-repainting ──
[p1H, p1L, p1T] = request.security(peer1Sym, rangeTf, [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[p2H, p2L, p2T] = request.security(peer2Sym, rangeTf, [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[gH1, gL1, gH3, gL3, gT1] = request.security(syminfo.tickerid, gapTf, [high[1], low[1], high[3], low[3], time[1]], lookahead = barmerge.lookahead_on)
// The peers on the chart timeframe, so a SMT is read on the bar it forms rather than on the next range candle.
[q1H, q1L] = request.security(peer1Sym, timeframe.period, [high, low])
[q2H, q2L] = request.security(peer2Sym, timeframe.period, [high, low])
bool p1New = p1T != p1T[1]
bool p2New = p2T != p2T[1]
bool gNew  = gT1 != gT1[1]

// ============================================================================
// STORES
// ============================================================================
const int POOL_CAP   = 80
const int SWING_CAP  = 60
const int CANDLE_CAP = 400
const int ZONE_CAP   = 120

// A confirmed swing. bi and tm are the CHART bar that printed it; ord orders swings of one store
// (the range-timeframe candle count for higher-timeframe swings, the bar index for chart swings);
// ct is the range-timeframe candle's open time; raid says the swing ran the prior extreme and
// closed back inside it — a failed push.
type Swing
    float px
    int   tm
    int   bi
    int   ord
    int   ct
    bool  raid = false

// One pool of resting liquidity. `touches` counts the swings that merged into it - two or more and
// it is an EQH/EQL rather than a lone swing, which is the distinction that makes a level worth
// reaching for. `taken` is set the moment price trades through it, wick included: a raid is a raid
// whether or not the candle closed there.
type Pool
    float  px
    int    tm
    bool   isHigh
    bool   taken   = false
    int    touches = 1
    string origin  = 'Swing'
    line   ln      = na
    label  lb      = na

// One completed candle of a peer on the range timeframe.
type Candle
    float h
    float l
    int   t

// An imbalance the reversal can count. kind: 0 wick gap (FVG) · 1 volume imbalance · 2 suspension
// block. bi is the candle the kind is keyed on — the gap's middle candle, the imbalance's later
// candle, the block's third candle — so absorption between kinds is an index comparison. det is the
// bar it was detected on. mit flips once a close has traded through the far edge.
type Zone
    int   kind
    float top
    float bot
    int   tm
    int   bi
    int   det
    bool  mit  = false
    // A mitigated gap is an IFVG the other way until a close goes back through its near edge.
    bool  dead = false

// The nearest edges in a store a close could cross: the far edge of a live zone, the near edge of an
// inverted gap. A bar that crosses neither changes nothing in that store.
type ZWatch
    float live = na
    float mit  = na

// An order block from the Unicorn / Confluence Engine reading, kept for the arrays drawn between
// setups. dir is the BLOCK's direction (-1 the up-close run before a bearish displacement). It
// becomes a breaker the other way once a close passes through it, and is spent when a close goes
// back through its far side.
type Block
    int   dir
    float top
    float bot
    int   tm
    int   bi
    bool  flipped = false
    bool  dead    = false

//@variable Range-timeframe candles followed at chart scope: extremes, where each printed, closes.
var array<float> hH    = array.new<float>()
var array<float> hL    = array.new<float>()
var array<float> hC    = array.new<float>()
var array<int>   hHiTm = array.new<int>()
var array<int>   hHiBi = array.new<int>()
var array<int>   hLoTm = array.new<int>()
var array<int>   hLoBi = array.new<int>()
var array<int>   hCt   = array.new<int>()
var int          htfN  = 0

//@variable The candle currently forming on the range timeframe.
var float curO    = na
var float curH    = na
var float curL    = na
var float curC    = na
var int   curHiTm = na
var int   curHiBi = na
var int   curLoTm = na
var int   curLoBi = na
var int   curCt   = na
var int   curOBi  = na

//@variable Confirmed range-timeframe swings (the dealing range) and chart swings (execution).
var array<Swing> hHi = array.new<Swing>()
var array<Swing> hLo = array.new<Swing>()
var array<Swing> cHi = array.new<Swing>()
var array<Swing> cLo = array.new<Swing>()

//@variable Resting liquidity pools - merged swing EQH/EQL plus the previous day and week.
var array<Pool> pools = array.new<Pool>()
//@variable The nearest untaken pool each side: live = lowest buyside, mit = highest sellside.
var ZWatch poolW = ZWatch.new()

//@variable Peer candles on the range timeframe.
var array<Candle> peer1 = array.new<Candle>()
var array<Candle> peer2 = array.new<Candle>()

//@variable Completed fair value gaps on the catch-up timeframe: times, by direction.
var array<int> gapUpTm = array.new<int>()
var array<int> gapDnTm = array.new<int>()

//@variable Bullish and bearish imbalances on the chart, chronological.
var array<Zone> bullZ = array.new<Zone>()
var array<Zone> bearZ = array.new<Zone>()
var ZWatch      bullW = ZWatch.new()
var ZWatch      bearW = ZWatch.new()

//@variable Gaps whose inversion has failed, oldest first — kept only for the IFVG search and the catch-up gap.
var array<Zone> bullArc = array.new<Zone>()
var array<Zone> bearArc = array.new<Zone>()

//@variable Order blocks for the breakers drawn between setups.
var array<Block> blocks = array.new<Block>()
//@variable The nearest block edges a close can cross: live = lowest edge above, mit = highest edge below.
var ZWatch blkW = ZWatch.new()

//@variable The last pivLen + 1 bars, index 0 = this bar, for the OTE touch test.
var array<float> recLow  = array.new<float>()
var array<float> recHigh = array.new<float>()

//@function The most extreme swing at or after an ordinal — highest for d = 1, lowest for d = -1.
//@param sw (array<Swing>) The store
//@param minOrd (int) Oldest ordinal to consider
//@param d (int) 1 for highest, -1 for lowest
//@returns (float) The extreme, or na
f_extreme(array<Swing> sw, int minOrd, int d) =>
    float r = na
    int n = sw.size()
    if n > 0
        for i = 0 to n - 1
            Swing s = sw.get(i)
            if s.ord >= minOrd and (na(r) or d * (s.px - r) > 0)
                r := s.px
    r

// ── The dealing range: forms once from the lookback's extreme swings, then HOLDS. It rebuilds
//    only after a close through a side, judged with the same reclaim allowance the sweep uses:
//    the broken side is spent, the last swing before the breaking leg becomes the new far side,
//    and the near side FORMS on price until the range timeframe confirms a swing there. ──
var float drHiPx   = na
var int   drHiTm   = na
var int   drHiBi   = na
var int   drHiCt   = na
var bool  drLoRaided = false
var bool  drHiRaided = false
var float drLoPx   = na
var int   drLoTm   = na
//@variable Counts every change to the dealing range, so a setup knows when to reread it.
var int   drVer    = 0
var int   drLoBi   = na
var int   drLoCt   = na
var bool  drHiPend = false
var bool  drLoPend = false
var int   drOutHi  = 0
var int   drOutLo  = 0
var int   drBreakBi  = na
var int   drBrokeDir = 0     // 1 the high broke, -1 the low broke, 0 neither
var float drBrokePx  = na
var int   drBrokeTm  = na

// ── One setup per swing. A range swing that has given a model setup (the MSS confirmed) is spent for
//    its direction; the time is the swing's. A raid turned away for want of the SMT leaves the swing
//    live, and its bar is kept so the lookback cannot find that same raid again. ──
//    Held as fields of one object: a function may change an object's fields, never a global.
type SwingGate
    int spentLoTm = na
    int spentHiTm = na
    int rejLoBi   = na
    int rejHiBi   = na

var SwingGate sg = SwingGate.new()

//@function The most extreme swing at or after an ordinal, as a swing.
//@param sw (array<Swing>) The store
//@param minOrd (int) Oldest ordinal to consider
//@param d (int) 1 for highest, -1 for lowest
//@returns (Swing) The swing, or na
f_extSwing(array<Swing> sw, int minOrd, int d) =>
    Swing r = na
    int n = sw.size()
    if n > 0
        for i = 0 to n - 1
            Swing x = sw.get(i)
            if x.ord >= minOrd and (na(r) or d * (x.px - r.px) > 0)
                r := x
    r

//@function The most recent swing at or before a bar.
//@param sw (array<Swing>) The store
//@param maxBi (int) The bar
//@returns (Swing) The swing, or na
f_lastSwing(array<Swing> sw, int maxBi) =>
    Swing r = na
    int n = sw.size()
    if n > 0
        for i = 0 to n - 1
            Swing x = sw.get(i)
            if x.bi <= maxBi and (na(r) or x.bi > r.bi)
                r := x
    r

//@function Appends a swing and prunes past the cap.
//@param sw (array<Swing>) The store
//@param s (Swing) The swing
//@returns (void)
f_pushSwing(array<Swing> sw, Swing s) =>
    sw.push(s)
    if sw.size() > SWING_CAP
        sw.shift()

//@function Appends an imbalance to its store and prunes the oldest past the cap.
//@param store (array<Zone>) The direction's store
//@param w (ZWatch) The store's edge watch
//@param d (int) The store's direction
//@param kind (int) 0 gap · 1 volume imbalance · 2 suspension block
//@param top (float) Top
//@param bot (float) Bottom
//@param tm (int) Origin time
//@param bi (int) Key candle index
//@returns (void)
f_pushZone(array<Zone> store, ZWatch w, int d, int kind, float top, float bot, int tm, int bi) =>
    store.push(Zone.new(kind = kind, top = top, bot = bot, tm = tm, bi = bi, det = bar_index))
    if store.size() > ZONE_CAP
        store.shift()
    // A new zone is live, so its far edge may now be the nearest one a close can cross.
    float far = d > 0 ? bot : top
    w.live := na(w.live) ? far : d > 0 ? math.max(w.live, far) : math.min(w.live, far)
    true

//@function Marks stored imbalances a close has traded through — a gap that failed before the MSS
//          must not be counted as the reversal's displacement.
//@param store (array<Zone>) The store
//@param w (ZWatch) The store's edge watch
//@param d (int) The store's direction
//@returns (void)
f_markMitigated(array<Zone> store, ZWatch w, int d) =>
    array<Zone> arc = d > 0 ? bullArc : bearArc
    int n = store.size()
    // Only a close past the nearest far edge of a live zone, or past the nearest near edge of an
    // inverted gap, can change anything. On every other bar the walk is skipped.
    bool hitLive = not na(w.live) and d * (close - w.live) < 0
    bool hitMit  = not na(w.mit)  and d * (close - w.mit)  > 0
    if n > 0 and (hitLive or hitMit)
        float nLive = na
        float nMit  = na
        for i = n - 1 to 0
            Zone z = store.get(i)
            float near = d > 0 ? z.top : z.bot
            float far  = d > 0 ? z.bot : z.top
            if z.mit and z.kind == 0 and not z.dead
                if d * (close - near) > 0
                    z.dead := true
            if not z.mit
                if d * (close - far) < 0
                    z.mit := true
                else
                    nLive := na(nLive) ? far : d > 0 ? math.max(nLive, far) : math.min(nLive, far)
            if z.mit and z.kind == 0 and not z.dead
                nMit := na(nMit) ? near : d > 0 ? math.min(nMit, near) : math.max(nMit, near)
            // Spent zones leave the store this loop walks every bar. A mitigated VI or SB is read by
            // nothing again; a gap whose inversion has also failed is still read by the IFVG search
            // and the catch-up gap, so it moves to the archive they read instead.
            if z.mit and z.kind != 0
                store.remove(i)
            else if z.dead
                arc.push(z)
                store.remove(i)
                if arc.size() > ZONE_CAP / 2
                    arc.shift()
        w.live := nLive
        w.mit  := nMit

//@function Appends a peer candle and prunes past the cap.
//@param pc (array<Candle>) The peer's store
//@param h (float) High
//@param l (float) Low
//@param t (int) Candle open time
//@returns (void)
f_pushCandle(array<Candle> pc, float h, float l, int t) =>
    if not na(h) and not na(t)
        pc.push(Candle.new(h, l, t))
        if pc.size() > CANDLE_CAP
            pc.shift()

//@function Tests whether the candle R back in a range-timeframe series is a confirmed pivot.
//@param v (array<float>) Highs (isHigh) or lows
//@param isHigh (bool) Pivot high or pivot low
//@returns (int) The array index of the pivot, or -1
f_htfPivot(array<float> v, bool isHigh) =>
    int n   = v.size()
    int idx = n - 1 - htfLen
    int r   = -1
    if idx >= htfLen
        float c = v.get(idx)
        bool ok = true
        for i = idx - htfLen to idx + htfLen
            if i != idx
                float o = v.get(i)
                if isHigh ? o >= c : o <= c
                    ok := false
        if ok
            r := idx
    r

// ============================================================================
// DRAWING HELPERS
// ============================================================================
//@function A transparent monospace callout.
//@param x (int) Bar time
//@param y (float) Price
//@param txt (string) Text
//@param sty (string) A label.style_* constant
//@returns (label) The label
f_lbl(int x, float y, string txt, string sty) =>
    label l = label.new(x, y, txt, xloc = xloc.bar_time, style = sty, color = C_NONE,
        textcolor = C_INK, size = LBL_SZ, textalign = text.align_left)
    label.set_text_font_family(l, font.family_monospace)
    l

//@function A horizontal level in bar time.
//@param x1 (int) Start time
//@param x2 (int) End time
//@param y (float) Price
//@param c (color) Colour
//@param w (int) Width
//@param sty (string) A line.style_* constant
//@returns (line) The line
f_level(int x1, int x2, float y, color c, int w, string sty) =>
    line.new(x1, y, x2, y, xloc = xloc.bar_time, color = c, width = w, style = sty)

//@function A zone box plus its caption label on the centre line past the right edge.
//@param x1 (int) Origin time
//@param top (float) Top
//@param x2 (int) Right edge time
//@param bot (float) Bottom
//@param base (color) Direction colour
//@param opac (int) Fill transparency
//@param hardEdge (bool) True draws a full-opacity border (blocks)
//@param cap (string) Caption
//@returns ([box, label]) The box and its caption
f_zone(int x1, float top, int x2, float bot, color base, int opac, bool hardEdge, string cap) =>
    color fill = color.new(base, opac)
    color edge = hardEdge ? color.new(base, 0) : fill
    box b = box.new(x1, top, x2, bot, xloc = xloc.bar_time, border_color = edge, border_width = 1,
        border_style = line.style_solid, bgcolor = fill)
    // A PD array's name sits in the MIDDLE of its own zone, the way the OTE band's does - not
    // hung off the right edge, where it reads as belonging to whatever is beside the zone rather
    // than to the zone itself.
    label l = f_lbl(int(math.avg(x1, x2)), math.avg(top, bot), cap, label.style_label_center)
    [b, l]

//@function Re-centres a zone's caption in its box. Called wherever the box's right edge moves, so
//          the name travels with the zone instead of staying where it was first drawn.
//@param l (label) The caption.
//@param b (box) Its zone.
//@returns (bool) Always true.
f_zoneCap(label l, box b) =>
    if not na(l) and not na(b)
        label.set_xy(l, int(math.avg(box.get_left(b), box.get_right(b))), math.avg(box.get_top(b), box.get_bottom(b)))
    true

// ============================================================================
// THE SETUP
// ============================================================================
// state: 0 idle · 1 armed (range + failed push) · 2 swept · 3 live (MSS confirmed) · 4 frozen · 5 dead
type Setup
    int   dir
    int   state        = 0
    float liq          = na
    int   liqTm        = na
    int   liqBi        = na
    int   liqCt        = na
    float tgt          = na
    int   tgtTm        = na
    int   tgtBi        = na
    int   tgtCt        = na
    float pushPx       = na
    int   pushTm       = na
    int   pushBi       = na
    // What the failed-push search last read: the newest opposite range swing, the target and the level.
    int   pkSwBi       = na
    int   pkSwN        = na
    int   pkDrVer      = na
    // What the MSS reference search last read: the newest opposite chart swing and the swing count.
    int   pkCSwBi      = na
    int   pkCSwN       = na
    bool  justArmed    = false
    float sweepPx      = na
    int   sweepTm      = na
    int   sweepBi      = na
    // The candle that first wicked the level: the level line stops here and the Sweep tag sits here.
    int   firstSweepTm = na
    // The chart swing the SMT line starts from: the last same-side swing before the raid.
    int   smtFromTm    = na
    float smtFromPx    = na
    int   firstSweepBi = na
    int   outsideBars  = 0
    float mssRef       = na
    int   mssRefTm     = na
    int   mssRefBi     = na
    int   mssTm        = na
    int   mssBi        = na
    bool  waitDisp     = false
    bool  hasFvg       = false
    bool  fvgLive      = false
    bool  hasVi        = false
    bool  viLive       = false
    bool  hasSb        = false
    bool  sbLive       = false
    bool  hasIfvg      = false
    bool  ifvgLive     = false
    bool  hasBrk       = false
    bool  brkLive      = false
    bool  hasOte       = false
    bool  oteLive      = false
    int   oteConfirmedAt = na
    int   fvgBi        = na
    int   viBi         = na
    int   sbBi         = na
    float fvgTop       = na
    float fvgBot       = na
    float viTop        = na
    float viBot        = na
    float sbTop        = na
    float sbBot        = na
    float ifvgTop      = na
    float ifvgBot      = na
    bool  brkPending   = false
    float brkTop       = na
    float brkBot       = na
    int   brkTm        = na
    float legExt       = na
    float legStart     = na
    int   legStartTm   = na
    float oteTop       = na
    float oteBot       = na
    bool  oteTouched   = false
    int   grade        = 0
    bool  gradeAReached = false
    bool  gradeApReached = false
    bool  rrQualified      = false
    int   rrQualifiedAt    = na
    float rrReferencePrice = na
    string rrSource        = ''
    float setupRR          = na
    // Orthogonal observation-only entry lifecycle:
    // 0 NONE · 1 TOUCHED · 2 CONFIRMED · 3 INVALIDATED · 4 STOPPED · 5 TARGET_TAKEN · 6 AMBIGUOUS
    int   entryState       = 0
    int   entryAttempt     = 0
    int   entryConfirmedCount = 0
    string entrySource     = ''
    float entryZoneTop     = na
    float entryZoneBot     = na
    float entryOteTop      = na
    float entryOteBot      = na
    float entryRangeLow    = na
    float entryRangeHigh   = na
    int   entryTouchedAt   = na
    int   entryConfirmedAt = na
    float entryPrice       = na
    float entryStop        = na
    float entryRR          = na
    string entryGradeTouch = ''
    string entryGradeConfirm = ''
    bool  drawn        = false
    // cross-check
    bool  xcSet        = false
    float p1TgtLvl     = na
    float p2TgtLvl     = na
    float p1LiqLvl     = na
    float p2LiqLvl     = na
    int   tgtWinEnd    = na
    int   liqWinEnd    = na
    int   p1TgtTaken   = na
    int   p2TgtTaken   = na
    int   p1LiqTaken   = na
    int   p2LiqTaken   = na
    bool  selfTgtTaken = false
    bool  catchUp      = false
    int   xcTgtCt      = na
    int   xcLiqCt      = na
    string outcome     = ''
    string gradeTxt    = '0/6'
    // drawings
    line  fvgCe        = na
    line  sbCe         = na
    line  ifvgCe       = na
    line  liqLn        = na
    label liqLbl       = na
    line  tgtLn        = na
    label tgtLbl       = na
    line  mssLn        = na
    label mssLbl       = na
    line  mssPendLn    = na
    label mssPendLbl   = na
    line  smtLn        = na
    label smtLbl       = na
    box   fvgBx        = na
    label fvgLbl       = na
    box   viBx         = na
    label viLbl        = na
    box   sbBx         = na
    label sbLbl        = na
    box   ifvgBx       = na
    label ifvgLbl      = na
    line  brkP         = na
    line  brkD         = na
    line  brkCe        = na
    label brkLbl       = na
    box   brkBx        = na
    box   oteBx        = na
    label oteLbl       = na
    line  oteLeg       = na
    box   entryBx      = na
    label entryLbl     = na
    line  entryConfirmLn = na
    line  entryPriceLn = na
    line  entryStopLn  = na
    label entryMarker  = na

//@function Resolves the canonical RR reference using the existing fixed PD-array priority.
//@param s (Setup) A live setup
//@returns (tuple) Source, reference price and setup RR; empty/na when no array has formed.
f_resolveRR(Setup s) =>
    int d = s.dir
    string source = ''
    float rrReferencePrice = na
    if s.hasSb
        source := 'SB'
        rrReferencePrice := d > 0 ? s.sbTop : s.sbBot
    else if s.hasFvg
        source := d > 0 ? 'BISI' : 'SIBI'
        rrReferencePrice := d > 0 ? s.fvgTop : s.fvgBot
    else if s.hasVi
        source := 'VI'
        rrReferencePrice := d > 0 ? s.viTop : s.viBot
    else if s.hasIfvg
        source := 'IFVG'
        rrReferencePrice := d > 0 ? s.ifvgTop : s.ifvgBot
    else if s.hasOte
        source := 'OTE'
        rrReferencePrice := d > 0 ? s.oteTop : s.oteBot
    float risk   = math.abs(rrReferencePrice - s.sweepPx)
    float reward = math.abs(s.tgt - rrReferencePrice)
    float setupRR = (na(rrReferencePrice) or risk <= 0) ? na : reward / risk
    [source, rrReferencePrice, setupRR]

//@function Risk-to-reward from the canonical PD-array reference to the draw, stop at the sweep extreme.
//@param s (Setup) A live setup
//@returns (float) The ratio, or na when no array has formed
f_rr(Setup s) =>
    [rrSource0, rrReferencePrice0, setupRR0] = f_resolveRR(s)
    setupRR0

// Per-bar events, read by the alert layer.
type Ev
    bool swept   = false
    bool mss     = false
    bool a       = false
    bool ap      = false
    bool catchUp = false
    bool broke   = false
    int  brokeCt = na
    bool   rrQualified            = false
    int    rrQualifiedTime        = na
    int    rrQualifiedDir         = 0
    int    rrQualifiedMssTime     = na
    float  rrQualifiedSweepPrice  = na
    float  rrQualifiedTargetPrice = na
    float  rrReferencePrice       = na
    string rrSource               = ''
    float  setupRR                = na
    string rrQualifiedGrade       = ''
    bool   failed            = false
    int    failedTime        = na
    int    failedDir         = 0
    int    failedMssTime     = na
    float  failedSweepPrice  = na
    float  failedTargetPrice = na
    string failedGrade       = ''
    float  failedRr          = na
    int    failedRrQualifiedAt    = na
    float  failedRrReferencePrice = na
    string failedRrSource         = ''
    float  failedSetupRR          = na
    bool   retired            = false
    int    retiredTime        = na
    int    retiredDir         = 0
    float  retiredSweepPrice  = na
    float  retiredTargetPrice = na
    string retiredGrade       = ''
    int    retiredMssTime     = na
    float  retiredRr          = na
    int    retiredRrQualifiedAt    = na
    float  retiredRrReferencePrice = na
    string retiredRrSource         = ''
    float  retiredSetupRR          = na

// One immutable observation emitted by the entry lifecycle. Multiple records may be queued on one
// confirmed candle, which is how a first touch and its reclaim can both be recorded without backdating.
type EntryEvent
    string eventType
    int    dir
    int    mssAt
    int    eventAt
    float  sweepPrice
    float  targetPrice
    string grade
    int    rrQualifiedAt
    string rrSource
    float  rrReferencePrice
    float  setupRR
    int    attempt
    string source
    string confirmationMethod
    float  zoneTop
    float  zoneBottom
    float  oteTop
    float  oteBottom
    int    oteConfirmedAt
    float  rangeLow
    float  rangeHigh
    string rangeThird
    string minimumGrade
    string gradeAtTouch
    string gradeAtConfirmation
    int    touchedAt
    int    confirmedAt
    float  entryPrice
    float  stopPrice
    float  entryRR
    float  eventPrice

//@function Freezes the first canonical setup RR geometry that clears the configured threshold.
//@param ev (Ev) The matching direction's per-bar event object.
//@param s (Setup) The live setup.
//@returns (bool) Always true.
f_rrQualifiedEvent(Ev ev, Setup s) =>
    if s.state == 3 and not s.rrQualified
        [rrSource, rrReferencePrice, setupRR] = f_resolveRR(s)
        if rrSource != '' and not na(rrReferencePrice) and not na(setupRR) and setupRR >= minRR
            s.rrQualified      := true
            s.rrQualifiedAt    := time
            s.rrReferencePrice := rrReferencePrice
            s.rrSource         := rrSource
            s.setupRR          := setupRR
            ev.rrQualified            := true
            ev.rrQualifiedTime        := time
            ev.rrQualifiedDir         := s.dir
            ev.rrQualifiedMssTime     := s.mssTm
            ev.rrQualifiedSweepPrice  := s.sweepPx
            ev.rrQualifiedTargetPrice := s.tgt
            ev.rrReferencePrice       := rrReferencePrice
            ev.rrSource               := rrSource
            ev.setupRR                := setupRR
            ev.rrQualifiedGrade       := s.grade >= gradeAp ? 'A+' : s.grade >= gradeA ? 'A' : ''
    true

//@function Queues a setup at its canonical target-taken transition.
//@param events (array<Setup>) Per-bar target events, including multiple retired targets on one bar.
//@param s (Setup) The setup completing its target.
//@returns (bool) Always true.
f_targetTakenEvent(array<Setup> events, Setup s) =>
    events.push(s)
    true

//@function Captures the setup payload at its existing canonical structural-failure transition.
//@param ev (Ev) The matching direction's per-bar event object.
//@param s (Setup) The live setup immediately before it is wiped.
//@returns (bool) Always true.
f_failedEvent(Ev ev, Setup s) =>
    ev.failed            := true
    ev.failedTime        := time
    ev.failedDir         := s.dir
    ev.failedMssTime     := s.mssTm
    ev.failedSweepPrice  := s.sweepPx
    ev.failedTargetPrice := s.tgt
    ev.failedGrade       := s.grade >= gradeAp ? 'A+' : s.grade >= gradeA ? 'A' : ''
    ev.failedRr          := f_rr(s)
    ev.failedRrQualifiedAt    := s.rrQualifiedAt
    ev.failedRrReferencePrice := s.rrReferencePrice
    ev.failedRrSource         := s.rrSource
    ev.failedSetupRR          := s.setupRR
    true

//@function Captures the setup payload at its existing canonical age-retirement transition.
//@param ev (Ev) The matching direction's per-bar event object.
//@param s (Setup) The unresolved live setup immediately before it freezes as history.
//@returns (bool) Always true.
f_retiredEvent(Ev ev, Setup s) =>
    ev.retired            := true
    ev.retiredTime        := time
    ev.retiredDir         := s.dir
    ev.retiredSweepPrice  := s.sweepPx
    ev.retiredTargetPrice := s.tgt
    ev.retiredGrade       := s.grade >= gradeAp ? 'A+' : s.grade >= gradeA ? 'A' : ''
    ev.retiredMssTime     := s.mssTm
    ev.retiredRr          := f_rr(s)
    ev.retiredRrQualifiedAt    := s.rrQualifiedAt
    ev.retiredRrReferencePrice := s.rrReferencePrice
    ev.retiredRrSource         := s.rrSource
    ev.retiredSetupRR          := s.setupRR
    true

//@function Deletes the displacement gap's drawing and clears its reference.
//@param s (Setup) The setup
//@returns (void)
f_eraseFvg(Setup s) =>
    box.delete(s.fvgBx)
    label.delete(s.fvgLbl)
    line.delete(s.fvgCe)
    s.fvgBx  := na
    s.fvgLbl := na
    s.fvgCe  := na
    s.fvgLive := false

//@function Deletes the volume imbalance's drawing and clears its reference.
//@param s (Setup) The setup
//@returns (void)
f_eraseVi(Setup s) =>
    box.delete(s.viBx)
    label.delete(s.viLbl)
    s.viBx  := na
    s.viLbl := na
    s.viLive := false

//@function Deletes the suspension block's drawing and clears its reference.
//@param s (Setup) The setup
//@returns (void)
f_eraseSb(Setup s) =>
    box.delete(s.sbBx)
    label.delete(s.sbLbl)
    line.delete(s.sbCe)
    s.sbBx  := na
    s.sbLbl := na
    s.sbCe  := na
    s.sbLive := false

//@function Deletes the IFVG's drawing and clears its reference.
//@param s (Setup) The setup
//@returns (void)
f_eraseIfvg(Setup s) =>
    box.delete(s.ifvgBx)
    label.delete(s.ifvgLbl)
    line.delete(s.ifvgCe)
    s.ifvgBx  := na
    s.ifvgLbl := na
    s.ifvgCe  := na
    s.ifvgLive := false

//@function Deletes the breaker's drawings and clears their references.
//@param s (Setup) The setup
//@returns (void)
f_eraseBrk(Setup s) =>
    line.delete(s.brkP)
    line.delete(s.brkD)
    line.delete(s.brkCe)
    label.delete(s.brkLbl)
    box.delete(s.brkBx)
    s.brkP   := na
    s.brkD   := na
    s.brkCe  := na
    s.brkLbl := na
    s.brkBx  := na
    s.brkLive := false

//@function Deletes the OTE band's drawing and clears its reference.
//@param s (Setup) The setup
//@returns (void)
f_eraseOte(Setup s) =>
    box.delete(s.oteBx)
    label.delete(s.oteLbl)
    line.delete(s.oteLeg)
    s.oteBx  := na
    s.oteLbl := na
    s.oteLeg := na
    s.oteLive := false

//@function Deletes every drawing a setup owns.
//@param s (Setup) The setup
//@returns (void)
f_wipe(Setup s) =>
    line.delete(s.liqLn)
    label.delete(s.liqLbl)
    line.delete(s.tgtLn)
    label.delete(s.tgtLbl)
    line.delete(s.mssLn)
    label.delete(s.mssLbl)
    line.delete(s.mssPendLn)
    label.delete(s.mssPendLbl)
    line.delete(s.smtLn)
    label.delete(s.smtLbl)
    f_eraseFvg(s)
    f_eraseVi(s)
    f_eraseSb(s)
    f_eraseIfvg(s)
    f_eraseBrk(s)
    f_eraseOte(s)

//@function The grade text for a count of formed arrays.
//@param c (int) 0..6
//@returns (string) A+, A, or n/6
f_gradeText(int c) =>
    c >= gradeAp ? 'A+' : c >= gradeA ? 'A' : str.tostring(c) + '/6'

//@function The draw's label: the level's name, then the grade of the setup that targets it —
//          one label at the runway carries both, so no separate grade tag sits inside price.
//@param s (Setup) The setup
//@returns (string) e.g. "BSL · ERL · 15m A+"
f_tgtText(Setup s) =>
    (s.dir > 0 ? 'BSL' : 'SSL') + ' · ERL · ' + TF_NAME + ' ' + s.gradeTxt

//@function Recounts the formed arrays, rewrites the draw label and raises the A / A+ events.
//@param s (Setup) The setup
//@param ev (Ev) This bar's event flags
//@returns (void)
f_grade(Setup s, Ev ev) =>
    int c = (s.hasFvg ? 1 : 0) + (s.hasVi ? 1 : 0) + (s.hasSb ? 1 : 0) + (s.hasIfvg ? 1 : 0) + (s.hasBrk ? 1 : 0) + (s.hasOte ? 1 : 0)
    if c >= gradeAp and not s.gradeApReached
        ev.ap := true
        s.gradeAReached  := true
        s.gradeApReached := true
    else if c >= gradeA and not s.gradeAReached
        ev.a := true
        s.gradeAReached := true
    s.grade    := c
    s.gradeTxt := f_gradeText(c)
    if not na(s.tgtLbl)
        label.set_text(s.tgtLbl, f_tgtText(s))

//@function Draws the swept level and its name. The name sits at the swing that made the level, on
//          the outside; the line is dotted and stops at the raid, which is what reports the sweep.
//@param s (Setup) The setup
//@returns (void)
f_drawSweep(Setup s) =>
    if not s.drawn
        int d = s.dir
        int sweepAt = na(s.firstSweepTm) ? s.sweepTm : s.firstSweepTm
        // The line stops at the candle that wicked the level and is dotted, which is what says the
        // level was taken — the style carries the event, so no tag sits in price to announce it.
        s.liqLn    := f_level(s.liqTm, sweepAt, s.liq, liqCol, liqWidth, line.style_dotted)
        // The name sits on the OUTSIDE of the level — below a sellside sweep, above a buyside one —
        // at the swing that made it, where nothing has traded.
        s.liqLbl   := f_lbl(s.liqTm, s.liq, (d > 0 ? 'SSL' : 'BSL') + ' · ERL', d > 0 ? label.style_label_up : label.style_label_down)
        s.drawn    := true

//@function Draws the breaker as levels or as a zone once it has confirmed.
//@param s (Setup) The setup
//@param runway (int) Right-hand end for lines
//@param zoneEnd (int) Right-hand end for boxes
//@returns (void)
f_drawBreaker(Setup s, int runway, int zoneEnd) =>
    int d = s.dir
    color c = d > 0 ? C_BULL : C_BEAR
    float prox = d > 0 ? s.brkTop : s.brkBot
    float dist = d > 0 ? s.brkBot : s.brkTop
    if brkMode == 'Zone'
        [b, l] = f_zone(s.brkTm, s.brkTop, zoneEnd, s.brkBot, c, blockFill, true, f_arrTag(4, d))
        s.brkBx  := b
        s.brkLbl := l
    else
        s.brkP   := f_level(s.brkTm, runway, prox, c, 1, line.style_solid)
        s.brkD   := f_level(s.brkTm, runway, dist, c, 1, line.style_dotted)
        s.brkCe  := f_level(s.brkTm, runway, math.avg(s.brkTop, s.brkBot), C_GRAY, 1, line.style_dotted)
        s.brkLbl := f_lbl(runway, prox, f_arrTag(4, d), label.style_label_left)

//@function Registers one same-direction imbalance against the setup, applying absorption: a
//          suspension block replaces the gap and the imbalance of its own triplet; a gap absorbs the
//          imbalance on either of its seams. Each kind registers once.
//@param s (Setup) The setup
//@param z (Zone) The imbalance
//@param zoneEnd (int) Right-hand end for boxes
//@returns (void)
f_register(Setup s, Zone z, int zoneEnd) =>
    int d = s.dir
    color c = d > 0 ? C_BULL : C_BEAR
    if z.kind == 2 and not s.hasSb
        s.hasSb := true
        s.sbLive := true
        s.sbBi  := z.bi
        s.sbTop := z.top
        s.sbBot := z.bot
        if showSb
            [b, l] = f_zone(z.tm, z.top, zoneEnd, z.bot, c, blockFill, true, f_arrTag(2, d))
            s.sbBx  := b
            s.sbLbl := l
            if showCe
                s.sbCe := f_level(z.tm, zoneEnd, math.avg(z.top, z.bot), C_GRAY, 1, line.style_dotted)
        if s.hasFvg and s.fvgBi == z.bi - 1
            s.hasFvg := false
            f_eraseFvg(s)
        if s.hasVi and (s.viBi == z.bi - 1 or s.viBi == z.bi)
            s.hasVi := false
            f_eraseVi(s)
    else if z.kind == 0 and not s.hasFvg and not (s.hasSb and z.bi == s.sbBi - 1)
        s.hasFvg := true
        s.fvgLive := true
        s.fvgBi  := z.bi
        s.fvgTop := z.top
        s.fvgBot := z.bot
        if showFvg
            [b, l] = f_zone(z.tm, z.top, zoneEnd, z.bot, c, gapFill, false, f_arrTag(0, d))
            s.fvgBx  := b
            s.fvgLbl := l
            if showCe
                s.fvgCe := f_level(z.tm, zoneEnd, math.avg(z.top, z.bot), C_GRAY, 1, line.style_dotted)
        if s.hasVi and (s.viBi == z.bi or s.viBi == z.bi + 1)
            s.hasVi := false
            f_eraseVi(s)
    else if z.kind == 1 and not s.hasVi and not (s.hasSb and (z.bi == s.sbBi - 1 or z.bi == s.sbBi)) and not (s.hasFvg and (z.bi == s.fvgBi or z.bi == s.fvgBi + 1))
        s.hasVi := true
        s.viLive := true
        s.viBi  := z.bi
        s.viTop := z.top
        s.viBot := z.bot
        if showVi
            [b, l] = f_zone(z.tm, z.top, zoneEnd, z.bot, c, gapFill, false, f_arrTag(1, d))
            s.viBx  := b
            s.viLbl := l
    true

//@function Registers every unmitigated same-direction imbalance after the sweep, blocks first so
//          absorption resolves the same way whatever order they formed in.
//@param s (Setup) The setup
//@param gz (array<Zone>) Same-direction store
//@param zoneEnd (int) Right-hand end for boxes
//@param onlyNew (bool) True limits the scan to imbalances detected this bar
//@returns (void)
f_scanZones(Setup s, array<Zone> gz, int zoneEnd, bool onlyNew) =>
    int n = gz.size()
    if n > 0
        for pass = 0 to 2
            int kind = pass == 0 ? 2 : pass == 1 ? 0 : 1
            for i = 0 to n - 1
                Zone z = gz.get(i)
                if z.kind == kind and not z.mit and z.bi > s.sweepBi and (not onlyNew or z.det == bar_index)
                    f_register(s, z, zoneEnd)

//@function Looks for the nearest opposite-direction gap that this bar's close has body-closed
//          through, among gaps formed after the failed push. Draws it as the IFVG.
//@param s (Setup) The setup
//@param ogz (array<Zone>) Opposite-direction store
//@param zoneEnd (int) Right-hand end for boxes
//@returns (void)
f_tryIfvg(Setup s, array<Zone> ogz, int zoneEnd) =>
    int d = s.dir
    float bestKey = na
    Zone  best    = na
    // The live store and the archive of gaps whose inversion already failed, which left the store.
    for pass = 0 to 1
        array<Zone> src = pass == 0 ? ogz : (d > 0 ? bearArc : bullArc)
        int n = src.size()
        if n > 0
            for i = 0 to n - 1
                Zone z = src.get(i)
                if z.kind == 0 and z.bi > s.pushBi and z.bi < bar_index
                    float thr = d > 0 ? z.top : z.bot
                    if d * (close - thr) > 0
                        if na(bestKey) or d * (thr - bestKey) > 0
                            bestKey := thr
                            best    := z
    if not na(best)
        Zone z = best
        s.hasIfvg := true
        s.ifvgLive := true
        s.ifvgTop := z.top
        s.ifvgBot := z.bot
        if showIfvg
            [b, l] = f_zone(z.tm, z.top, zoneEnd, z.bot, invCol, ifvgFill, false, f_arrTag(3, d))
            s.ifvgBx  := b
            s.ifvgLbl := l
            if showCe
                s.ifvgCe := f_level(z.tm, zoneEnd, math.avg(z.top, z.bot), C_GRAY, 1, line.style_dotted)

//@function Draws or re-measures the OTE band off the reversal leg.
//@param s (Setup) The setup
//@param legTm (int) Time of the swing that completed the leg
//@param zoneEnd (int) Right-hand end for boxes
//@returns (void)
f_drawOte(Setup s, int legTm, int zoneEnd) =>
    int d = s.dir
    float span = math.abs(s.legExt - s.legStart)
    float a = s.legExt - d * oteFrom * span
    float b = s.legExt - d * oteTo * span
    s.oteTop := math.max(a, b)
    s.oteBot := math.min(a, b)
    // Two guarded blocks, no else: an if/else that ends a function is its return value and the
    // branches would have to agree on type (CE10235).
    bool fresh = na(s.oteBx)
    if showOte and fresh
        [bx, l] = f_zone(legTm, s.oteTop, zoneEnd, s.oteBot, oteCol, bandFill, false, 'OTE')
        s.oteBx  := bx
        s.oteLbl := l
        // f_zone centres every zone caption, so the band needs no repositioning here - doing it by
        // hand is what left the name on the top edge on its first bar. Bold is the BAND's own mark
        // and stays: a PD array's name is read beside price, the dealing band's is read through it.
        label.set_text_formatting(s.oteLbl, text.format_bold)
        // The leg being measured — one dotted grey diagonal from the sweep extreme to the swing
        // that completed it: the 0 and the 1 of the fib, nothing more.
        s.oteLeg := line.new(s.legStartTm, s.legStart, legTm, s.legExt, xloc = xloc.bar_time, color = C_GRAY, width = 1, style = line.style_dotted)
    if showOte and not fresh
        box.set_lefttop(s.oteBx, legTm, s.oteTop)
        box.set_bottom(s.oteBx, s.oteBot)
        f_zoneCap(s.oteLbl, s.oteBx)
        line.set_xy1(s.oteLeg, s.legStartTm, s.legStart)
        line.set_xy2(s.oteLeg, legTm, s.legExt)
    true

//@function The OTE stage, run on every bar a setup is live including the MSS bar itself. The band
//          fires on the swing that completes the leg and re-measures on a higher one until price has
//          traded into it; the touch test covers the bars between the swing and its confirmation.
//@param s (Setup) The setup
//@param newOp (float) An opposite-side two-candle swing confirmed this bar, or na
//@param newOpTm (int) Its time
//@param newOpBi (int) Its bar index
//@param zoneEnd (int) Right-hand end for boxes
//@returns (void)
f_tryOte(Setup s, float newOp, int newOpTm, int newOpBi, int zoneEnd) =>
    int d = s.dir
    bool drewNow = false
    if not na(newOp) and newOpBi > s.sweepBi and d * (newOp - s.mssRef) > 0
        if not s.hasOte or (oteRatchet and not s.oteTouched and d * (newOp - s.legExt) > 0)
            s.legExt := newOp
            s.hasOte := true
            s.oteLive := true
            s.oteConfirmedAt := time
            drewNow  := true
            f_drawOte(s, newOpTm, zoneEnd)
    if s.hasOte and not s.oteTouched and not na(s.oteTop)
        // On the bar the band is drawn, every bar since the swing is checked — a range-timeframe
        // swing confirms many chart bars after it prints.
        int kMax = drewNow ? math.min(math.max(bar_index - newOpBi, 0), 500) : 0
        for k = 0 to kMax
            bool hit = d > 0 ? low[k] <= s.oteTop : high[k] >= s.oteBot
            if hit
                s.oteTouched := true

// ── Cross-check ──────────────────────────────────────────────────────────────
//@function The peer's level corresponding to one of the chart's range swings: its extreme over the
//          range-timeframe candles within the swing's own confirmation window.
//@param pc (array<Candle>) The peer's candles
//@param ct (int) The chart swing's range-timeframe candle open time
//@param wantHigh (bool) High side or low side
//@returns ([float, int]) The level and the window's end time
f_peerLevel(array<Candle> pc, int ct, bool wantHigh) =>
    int   lo  = ct - htfLen * htfMs
    int   hi  = ct + htfLen * htfMs
    float lvl = na
    int n = pc.size()
    if n > 0 and not na(ct)
        for i = 0 to n - 1
            Candle c = pc.get(i)
            if c.t >= lo and c.t <= hi
                float v = wantHigh ? c.h : c.l
                if na(lvl) or (wantHigh ? v > lvl : v < lvl)
                    lvl := v
    [lvl, hi]

//@function The first peer candle after the window that traded through the level, or na.
//@param pc (array<Candle>) The peer's candles
//@param lvl (float) The level
//@param winEnd (int) The window's end time
//@param wantHigh (bool) High side or low side
//@returns (int) The candle's open time, or na
f_peerTaken(array<Candle> pc, float lvl, int winEnd, bool wantHigh) =>
    int r = na
    int n = pc.size()
    if n > 0 and not na(lvl)
        for i = 0 to n - 1
            Candle c = pc.get(i)
            if na(r) and c.t > winEnd and (wantHigh ? c.h > lvl : c.l < lvl)
                r := c.t
    r

//@function Fixes the peers' corresponding levels once the range is fixed (at the sweep), and reads
//          whether each has already been taken.
//@param s (Setup) The setup
//@returns (void)
f_xcSet(Setup s) =>
    if xcLive and not s.xcSet
        bool tgtHigh = s.dir > 0
        [l1, e1] = f_peerLevel(peer1, s.tgtCt, tgtHigh)
        [l2, e2] = f_peerLevel(peer2, s.tgtCt, tgtHigh)
        [m1, f1] = f_peerLevel(peer1, s.liqCt, not tgtHigh)
        [m2, f2] = f_peerLevel(peer2, s.liqCt, not tgtHigh)
        s.p1TgtLvl  := l1
        s.p2TgtLvl  := l2
        s.p1LiqLvl  := m1
        s.p2LiqLvl  := m2
        s.tgtWinEnd := e1
        s.liqWinEnd := f1
        s.xcSet     := true

//@function Re-reads the peers' taken state; cheap enough to run on every new peer candle.
//@param s (Setup) The setup
//@returns (void)
f_xcUpdate(Setup s) =>
    if s.xcSet
        bool tgtHigh = s.dir > 0
        if na(s.p1TgtTaken)
            s.p1TgtTaken := f_peerTaken(peer1, s.p1TgtLvl, s.tgtWinEnd, tgtHigh)
        if na(s.p2TgtTaken)
            s.p2TgtTaken := f_peerTaken(peer2, s.p2TgtLvl, s.tgtWinEnd, tgtHigh)
        if na(s.p1LiqTaken)
            s.p1LiqTaken := f_peerTaken(peer1, s.p1LiqLvl, s.liqWinEnd, not tgtHigh)
        if na(s.p2LiqTaken)
            s.p2LiqTaken := f_peerTaken(peer2, s.p2LiqLvl, s.liqWinEnd, not tgtHigh)

//@function Whether the chart is the laggard on the target side: at least one peer took its level
//          and the chart has not.
//@param s (Setup) The setup
//@returns (bool)
f_isLaggard(Setup s) =>
    s.xcSet and not s.selfTgtTaken and (not na(s.p1TgtTaken) or not na(s.p2TgtTaken))

//@function Reads the peers on the chart timeframe: a peer that trades through its own level on
//          this bar has taken it. Runs for a swept or live setup, so the SMT resolves on the bar.
//@param s (Setup) The setup
//@param e1 (float) Peer 1's extreme on this bar on the sweep side
//@param e2 (float) Peer 2's extreme on this bar on the sweep side
//@returns (void)
f_peerLiqChart(Setup s, float e1, float e2) =>
    if s.xcSet and s.state >= 2 and s.state <= 3
        if na(s.p1LiqTaken) and not na(s.p1LiqLvl) and s.dir * (s.p1LiqLvl - e1) > 0
            s.p1LiqTaken := time
        if na(s.p2LiqTaken) and not na(s.p2LiqLvl) and s.dir * (s.p2LiqLvl - e2) > 0
            s.p2LiqTaken := time

//@function Draws the SMT once the sweep is on the chart: a line from the range swing to the sweep
//          extreme — the chart's lower low (or higher high) — named on the Sweep tag with the peer that held.
//          Removed if every peer takes its level; the divergence has failed.
//@param s (Setup) The setup
//@returns (void)
f_drawSmt(Setup s) =>
    // The divergence is between the raid's extreme and the CHART swing just before it - the higher
    // high the peer failed to match. The range swing is days back on a 1m chart, and a line from
    // there ran flat under the level and never read as an SMT. Resolved lazily, once the pivots
    // either side of the raid have had time to confirm; falls back to the range swing if none.
    // Only a swept setup has a raid to measure from; an idle one has nothing to search for.
    if na(s.smtFromTm) and s.state >= 2 and s.state <= 3 and not na(s.sweepBi)
        array<Swing> pool = s.dir < 0 ? hHi : hLo
        int n = pool.size()
        if n > 0
            for i = n - 1 to 0
                Swing w = pool.get(i)
                if w.bi < s.sweepBi and w.bi > s.liqBi and s.dir * (w.px - s.sweepPx) > 0
                    s.smtFromTm := w.tm
                    s.smtFromPx := w.px
                    break
    int   smtX1 = na(s.smtFromTm) ? s.liqTm : s.smtFromTm
    float smtY1 = na(s.smtFromTm) ? s.liq   : s.smtFromPx
    bool p1Held = na(s.p1LiqTaken)
    bool p2Held = na(s.p2LiqTaken)
    bool held   = showSmt and xcLive and s.xcSet and s.drawn and s.state >= 2 and s.state <= 3 and (p1Held or p2Held)
    if not held and not na(s.smtLn)
        line.delete(s.smtLn)
        s.smtLn := na
        label.delete(s.smtLbl)
        s.smtLbl := na
    if held
        // The SMT has its own tag at the divergence extreme; the Sweep tag stays at the level.
        string who = 'SMT ' + (p1Held and p2Held ? peer1Name + ' · ' + peer2Name : p1Held ? peer1Name : peer2Name)
        if na(s.smtLn)
            s.smtLn := line.new(smtX1, smtY1, s.sweepTm, s.sweepPx, xloc = xloc.bar_time, color = C_INK, width = 1, style = line.style_solid)
        else
            line.set_xy1(s.smtLn, smtX1, smtY1)
            line.set_xy2(s.smtLn, s.sweepTm, s.sweepPx)
        if na(s.smtLbl)
            s.smtLbl := f_lbl(s.sweepTm, s.sweepPx, who, s.dir > 0 ? label.style_label_up : label.style_label_down)
        else
            label.set_xy(s.smtLbl, s.sweepTm, s.sweepPx)
            label.set_text(s.smtLbl, who)
    true

//@function The time the first peer took the target side, or na.
//@param s (Setup) The setup
//@returns (int)
f_laggardSince(Setup s) =>
    int a = s.p1TgtTaken
    int b = s.p2TgtTaken
    na(a) ? b : na(b) ? a : math.min(a, b)

//@function The catch-up confirmation: a fair value gap in the setup's direction on the catch-up
//          timeframe (or the chart, when the chart is not below it), formed after the peers took the
//          level.
//@param s (Setup) The setup
//@param gz (array<Zone>) Same-direction chart imbalances
//@returns (bool)
f_catchUpGap(Setup s, array<Zone> gz) =>
    bool r = false
    int since = f_laggardSince(s)
    if not na(since)
        if gapOnChart
            for pass = 0 to 1
                array<Zone> src = pass == 0 ? gz : (s.dir > 0 ? bullArc : bearArc)
                int n = src.size()
                if n > 0
                    for i = 0 to n - 1
                        Zone z = src.get(i)
                        if z.kind == 0 and z.tm > since
                            r := true
        else
            array<int> src = s.dir > 0 ? gapUpTm : gapDnTm
            int n = src.size()
            if n > 0
                for i = 0 to n - 1
                    if src.get(i) > since
                        r := true
    r

//@function Advances one direction's setup by one confirmed bar.
//@param s (Setup) The setup for this direction
//@param ev (Ev) This bar's event flags for this direction
//@param hist (array<Setup>) The history store setups join once they draw
//@param targetEvents (array<Setup>) Target-taken events queued for this bar.
//@param sw (array<Swing>) Swept-side range swings
//@param op (array<Swing>) Opposite-side range swings
//@param cOp (array<Swing>) Opposite-side chart swings — the structure the MSS breaks
//@param gz (array<Zone>) Same-direction imbalances
//@param ogz (array<Zone>) Opposite-direction imbalances
//@returns (Setup) The setup to carry into the next bar — the same object, or a fresh one
f_run(Setup s, Ev ev, array<Setup> hist, array<Setup> targetEvents, array<Swing> sw, array<Swing> op, array<Swing> cOp, array<Zone> gz, array<Zone> ogz) =>
    int   d       = s.dir
    float ext     = d > 0 ? low : high
    int   runway  = time + runwayBars * msPerBar
    int   zoneEnd = time + 2 * msPerBar
    color dirCol  = d > 0 ? C_BULL : C_BEAR
    Setup out     = s
    s.justArmed := false

    if s.state <= 1
        bool wasArmed = s.state == 1
        int  m        = op.size()
        int  lastSwBi = m > 0 ? op.last().bi : na
        int  spentTm  = d > 0 ? sg.spentLoTm : sg.spentHiTm
        bool armed    = false
        // The range, the failed push and the peer read only change when the dealing range or the
        // opposite range swings do. On every other bar only the arming test against price is rerun.
        bool same = s.pkDrVer == drVer and m == s.pkSwN and lastSwBi == s.pkSwBi
        if same
            armed := not na(s.liq) and not na(s.tgt) and not na(s.pushBi) and math.abs(s.tgt - s.liq) >= minRangeAtr * atr and d * (s.tgt - close) > 0 and (na(spentTm) or s.liqTm != spentTm)
        else
            s.pkDrVer := drVer
            s.pkSwN   := m
            s.pkSwBi  := lastSwBi
            // ── The range: the held dealing range, read by direction. Both sides must be locked. ──
            bool  haveDr = not na(drHiPx) and not na(drLoPx) and not drHiPend and not drLoPend
            float liq    = haveDr ? (d > 0 ? drLoPx : drHiPx) : na
            int   liqTm  = haveDr ? (d > 0 ? drLoTm : drHiTm) : na
            int   liqBi  = haveDr ? (d > 0 ? drLoBi : drHiBi) : na
            int   liqCt  = haveDr ? (d > 0 ? drLoCt : drHiCt) : na
            float tgt    = haveDr ? (d > 0 ? drHiPx : drLoPx) : na
            int   tgtTm  = haveDr ? (d > 0 ? drHiTm : drLoTm) : na
            int   tgtBi  = haveDr ? (d > 0 ? drHiBi : drLoBi) : na
            int   tgtCt  = haveDr ? (d > 0 ? drHiCt : drLoCt) : na
            float rng    = math.abs(tgt - liq)
            // ── The failed push: the latest opposite range swing after the target that reached it and held ──
            float pushPx = na
            int   pushTm = na
            int   pushBi = na
            bool  tgtRaid = false
            if haveDr and m > 0
                float reach = liq + d * rng * pushReachPct / 100
                for i = 0 to m - 1
                    Swing x = op.get(i)
                    if x.bi == tgtBi
                        tgtRaid := x.raid
                    if x.bi > tgtBi and d * (x.px - reach) >= 0 and (na(pushBi) or x.bi > pushBi)
                        pushPx := x.px
                        pushTm := x.tm
                        pushBi := x.bi
                // A target that itself raided the prior extreme and closed back inside is the failed push.
                if na(pushBi) and (tgtRaid or not requirePush)
                    pushPx := tgt
                    pushTm := tgtTm
                    pushBi := tgtBi
            // A swing that has already given its one setup does not arm again.
            armed := haveDr and not na(pushBi) and rng >= minRangeAtr * atr and d * (tgt - close) > 0 and (na(spentTm) or liqTm != spentTm)
            s.liq    := liq
            s.liqTm  := liqTm
            s.liqBi  := liqBi
            s.liqCt  := liqCt
            s.tgt    := tgt
            s.tgtTm  := tgtTm
            s.tgtBi  := tgtBi
            s.tgtCt  := tgtCt
            s.pushPx := pushPx
            s.pushTm := pushTm
            s.pushBi := pushBi
            // The peers are read against the range as soon as there is one, so the open-draw verdict
            // is on the console before any sweep. Re-read whenever the range's swings change.
            if not na(liq) and not na(tgt)
                if s.xcTgtCt != s.tgtCt or s.xcLiqCt != s.liqCt
                    s.xcSet      := false
                    s.p1TgtTaken := na
                    s.p2TgtTaken := na
                    s.p1LiqTaken := na
                    s.p2LiqTaken := na
                    s.xcTgtCt    := s.tgtCt
                    s.xcLiqCt    := s.liqCt
                    f_xcSet(s)
                    f_xcUpdate(s)
        s.state     := armed ? 1 : 0
        s.justArmed := armed and not wasArmed
        // ── The sweep on this bar: a wick through the level, the candle closing back inside.
        //    Bars inside the range swing's confirmation lag are searched at global scope. ──
        if armed and d * (s.liq - ext) > 0 and d * (close[1] - s.liq) > 0 and bar_index > s.pushBi
            s.state        := 2
            s.outsideBars  := d * (close - s.liq) < 0 ? 1 : 0
            s.sweepPx      := ext
            s.sweepTm      := time
            s.sweepBi      := bar_index
            s.firstSweepBi := bar_index
            s.firstSweepTm := time
            ev.swept       := true
            f_xcSet(s)
            f_xcUpdate(s)
            if showEarly or drawRange
                f_drawSweep(s)

    else if s.state == 2
        s.outsideBars := d * (close - s.liq) < 0 ? s.outsideBars + 1 : 0
        if s.outsideBars > reclaimBars
            // Price has stayed beyond the level — the raid became a break, not a sweep.
            ev.broke   := true
            ev.brokeCt := s.liqCt
            f_wipe(s)
            out := Setup.new(dir = d)
        else if d * (close - s.tgt) > 0
            // The target went before structure shifted — nothing to grade.
            f_wipe(s)
            out := Setup.new(dir = d)
        else if time - s.firstSweepTm > sweepExpiryMs
            f_wipe(s)
            out := Setup.new(dir = d)
        else
            if d * (s.sweepPx - ext) > 0
                s.sweepPx := ext
                s.sweepTm := time
                s.sweepBi := bar_index
            // ── The structure to break: the latest opposite CHART swing since the push, inside the target ──
            float ref   = s.pushPx
            int   refTm = s.pushTm
            int   refBi = s.pushBi
            int m = cOp.size()
            int lastCBi = m > 0 ? cOp.last().bi : na
            // The answer only moves when a new chart swing confirms; until then the last one holds.
            if not na(s.mssRefBi) and m == s.pkCSwN and lastCBi == s.pkCSwBi
                ref   := s.mssRef
                refTm := s.mssRefTm
                refBi := s.mssRefBi
            else if m > 0
                for i = 0 to m - 1
                    Swing x = cOp.get(i)
                    if x.bi > refBi and d * (s.tgt - x.px) > 0
                        ref   := x.px
                        refTm := x.tm
                        refBi := x.bi
            s.pkCSwN   := m
            s.pkCSwBi  := lastCBi
            s.mssRef   := ref
            s.mssRefTm := refTm
            s.mssRefBi := refBi
            s.waitDisp := false
            // ── The level a close has to clear, drawn from the sweep until the MSS prints. It is
            //    the same reference the confirmation below tests, so the line cannot promise a
            //    break the script would not accept, and it follows the reference as newer swings
            //    form. Dotted at width 1: a reference, against the confirmed MSS line's solid 2.
            if showMssLvl and d * (s.tgt - s.mssRef) > 0
                if na(s.mssPendLn)
                    s.mssPendLn  := f_level(s.mssRefTm, runway, s.mssRef, dirCol, 1, line.style_dotted)
                    s.mssPendLbl := f_lbl(s.mssRefTm, s.mssRef, 'MSS · pending', d > 0 ? label.style_label_down : label.style_label_up)
                else
                    line.set_xy1(s.mssPendLn, s.mssRefTm, s.mssRef)
                    line.set_xy2(s.mssPendLn, runway, s.mssRef)
                    label.set_xy(s.mssPendLbl, s.mssRefTm, s.mssRef)
            else
                line.delete(s.mssPendLn)
                label.delete(s.mssPendLbl)
                s.mssPendLn  := na
                s.mssPendLbl := na
            // The reference has to sit inside the target; a reference AT the target is the target.
            if d * (s.tgt - s.mssRef) > 0 and d * (close - s.mssRef) > 0 and d * (close - s.liq) > 0
                bool dispOk = d * (close - s.sweepPx) >= minDispAtr * atr
                // The SMT, read the way the chart draws it: a peer that has not taken its own level.
                bool smtOk  = not requireSmt or not xcLive or not s.xcSet or na(s.p1LiqTaken) or na(s.p2LiqTaken)
                if not dispOk
                    // The V has not formed — a grinding reaction is not confirmed yet. Wait.
                    s.waitDisp := true
                else if not smtOk
                    // Every peer took its level with the chart — no SMT, so this raid is not the model.
                    // The swing stays live for a raid that has one; this raid is marked so the lookback
                    // cannot hand it straight back.
                    if d > 0
                        sg.rejLoBi := bar_index
                    else
                        sg.rejHiBi := bar_index
                    f_wipe(s)
                    out := Setup.new(dir = d)
                else if not inSess
                    // Structure shifted outside the window — this one is not the setup.
                    f_wipe(s)
                    out := Setup.new(dir = d)
                else
                    // ── MSS confirmed: the gate opens, everything draws at its origin ──
                    s.state := 3
                    s.mssTm := time
                    s.mssBi := bar_index
                    // This swing has given its setup.
                    if d > 0
                        sg.spentLoTm := s.liqTm
                    else
                        sg.spentHiTm := s.liqTm
                    // The OTE measures from the leg's own extreme — the lowest low (highest high)
                    // from just before the first breach of the level to this bar, capped by the
                    // lookback — not from the sweep wick alone, and not from an older low either.
                    int legN = math.min(math.min(bar_index - s.firstSweepBi + 3, oteLook), bar_index)
                    s.legStart   := ext
                    s.legStartTm := time
                    for i = 0 to legN
                        float e = d > 0 ? low[i] : high[i]
                        if d * (s.legStart - e) > 0
                            s.legStart   := e
                            s.legStartTm := time[i]
                    ev.mss  := true
                    f_drawSweep(s)
                    s.tgtLn    := f_level(s.tgtTm, runway, s.tgt, liqCol, liqWidth, line.style_solid)
                    // Outside its own level - above a buyside draw, below a sellside one - so the
                    // name begins where the line stops instead of printing along it.
                    s.tgtLbl   := f_lbl(runway, s.tgt, f_tgtText(s), label.style_label_left)
                    // The pending level has been taken; the confirmed line replaces it.
                    line.delete(s.mssPendLn)
                    label.delete(s.mssPendLbl)
                    s.mssPendLn  := na
                    s.mssPendLbl := na
                    // The MSS line stops at the break bar — run on, it reads as a level it is not.
                    // The grade rides on the draw's own label at the runway (see f_tgtText).
                    s.mssLn    := f_level(s.mssRefTm, time, s.mssRef, dirCol, 2, line.style_solid)
                    s.mssLbl   := f_lbl(s.mssRefTm, s.mssRef, 'MSS', d > 0 ? label.style_label_down : label.style_label_up)
                    s.brkPending := true
                    f_scanZones(s, gz, zoneEnd, false)
                    f_tryIfvg(s, ogz, zoneEnd)
                    hist.push(s)

    else if s.state == 3
        if d * (close - s.sweepPx) < 0
            // Closed back through the sweep extreme — the reversal failed. Gone, not greyed.
            f_failedEvent(ev, s)
            f_wipe(s)
            s.state := 5
            out := Setup.new(dir = d)
        else
            bool done = d * (close - s.tgt) > 0
            bool old  = time - s.mssTm > setupMaxAgeMs
            // ── Arrays forming one by one ──
            f_scanZones(s, gz, zoneEnd, true)
            if not s.hasIfvg
                f_tryIfvg(s, ogz, zoneEnd)
            if s.brkPending and not s.hasBrk and not na(s.brkTop)
                float prox = d > 0 ? s.brkTop : s.brkBot
                if d * (close - prox) > 0
                    s.hasBrk     := true
                    s.brkLive    := true
                    s.brkPending := false
                    if showBrk
                        f_drawBreaker(s, runway, zoneEnd)
            // ── Mitigation: a close through the far edge deletes the drawing, the count stands ──
            if s.fvgLive and d * (close - (d > 0 ? s.fvgBot : s.fvgTop)) < 0
                f_eraseFvg(s)
            if s.viLive and d * (close - (d > 0 ? s.viBot : s.viTop)) < 0
                f_eraseVi(s)
            if s.sbLive and d * (close - (d > 0 ? s.sbBot : s.sbTop)) < 0
                f_eraseSb(s)
            if s.ifvgLive and d * (close - (d > 0 ? s.ifvgBot : s.ifvgTop)) < 0
                f_eraseIfvg(s)
            if s.brkLive and d * (close - (d > 0 ? s.brkBot : s.brkTop)) < 0
                f_eraseBrk(s)
            if s.oteLive and d * (close - (d > 0 ? s.oteBot : s.oteTop)) < 0
                f_eraseOte(s)
            // ── Live edges ──
            line.set_x2(s.tgtLn, runway)
            label.set_x(s.tgtLbl, runway)
            if not na(s.fvgBx)
                box.set_right(s.fvgBx, zoneEnd)
                f_zoneCap(s.fvgLbl, s.fvgBx)
                line.set_x2(s.fvgCe, zoneEnd)
            if not na(s.viBx)
                box.set_right(s.viBx, zoneEnd)
                f_zoneCap(s.viLbl, s.viBx)
            if not na(s.sbBx)
                box.set_right(s.sbBx, zoneEnd)
                f_zoneCap(s.sbLbl, s.sbBx)
                line.set_x2(s.sbCe, zoneEnd)
            if not na(s.ifvgBx)
                box.set_right(s.ifvgBx, zoneEnd)
                f_zoneCap(s.ifvgLbl, s.ifvgBx)
                line.set_x2(s.ifvgCe, zoneEnd)
            if not na(s.oteBx)
                box.set_right(s.oteBx, zoneEnd)
                f_zoneCap(s.oteLbl, s.oteBx)
            if not na(s.brkLbl)
                if not na(s.brkBx)
                    box.set_right(s.brkBx, zoneEnd)
                    f_zoneCap(s.brkLbl, s.brkBx)
                else
                    line.set_x2(s.brkP, runway)
                    line.set_x2(s.brkD, runway)
                    line.set_x2(s.brkCe, runway)
                    label.set_x(s.brkLbl, runway)
            if done or old
                f_rrQualifiedEvent(ev, s)
                // Taken or retired: the setup freezes as history. The draw line stops here, dotted,
                // and its name moves with it to the line's own end, outside the level — above a
                // high, below a low. An ATR offset at the swing left it floating hundreds of points
                // clear of the line on a 4H chart, and at the swing it met the ERL name there.
                // A setup retired by age leaves its draw untaken: that is still resting liquidity, so the
                // line stays solid and keeps running to price until a close takes it.
                if done
                    f_targetTakenEvent(targetEvents, s)
                    line.set_style(s.tgtLn, line.style_dotted)
                    line.set_x2(s.tgtLn, time)
                    label.set_xy(s.tgtLbl, time, s.tgt)
                    label.set_style(s.tgtLbl, label.style_label_left)
                else
                    f_retiredEvent(ev, s)
                s.state   := 4
                s.outcome := done ? 'target taken' : 'retired'
                out := Setup.new(dir = d)

    // The chart's own wick through the target, read the same way the peers are.
    if s.state >= 2 and s.state <= 3 and not s.selfTgtTaken
        float oppExt = d > 0 ? high : low
        if d * (oppExt - s.tgt) > 0
            s.selfTgtTaken := true
    out

//@function Finds the order block the leg into the sweep left behind, the Unicorn / Confluence
//          Engine reading: walking back from the sweep extreme, the first displacement candle
//          against the setup — body at least obDispAtr x ATR, closing through the last chart swing
//          on that side, with a gap left around it — and the run of consecutive opposite-close
//          candles immediately before it (up to four, within five bars). Wick to wick. That block
//          becomes the breaker once a close passes back through it; a block price never closed
//          through is an order block and never a breaker. Called every bar at global scope; does
//          its work only when active.
//@param d (int) Setup direction
//@param barsBack (int) Bars from the current bar back to the sweep extreme
//@param legEnd (int) Bars from the current bar back to the swing the leg into the sweep came from
//@param sw (array<Swing>) The chart swings on the sweep side (lows for a bull setup)
//@param active (bool) True on the bar the MSS confirmed
//@returns ([float, float, int, bool]) top, bottom, origin time, found
f_findBlock(int d, int barsBack, int legEnd, array<Swing> sw, bool active) =>
    float top   = na
    float bot   = na
    int   tm    = na
    bool  found = false
    if active and barsBack >= 1 and barsBack <= 480 and bar_index > barsBack + 80
        int k = barsBack
        // The walk stops at the swing the leg into the sweep came from: a block older than that
        // leg belongs to another move and is not this reversal's breaker.
        while k <= math.min(legEnd, barsBack + 60) and not found
            // The displacement candle: against the setup, a real body, a gap around it.
            bool against = d > 0 ? close[k] < open[k] : close[k] > open[k]
            bool body    = math.abs(close[k] - open[k]) >= obDispAtr * atr
            bool gap     = d > 0 ? low[k + 1] > high[k - 1] : high[k + 1] < low[k - 1]
            bool through = false
            if against and body and gap
                // Closed through the last chart swing on that side that formed before it.
                int   dispBi = bar_index - k
                float swPx   = na
                int   swBi   = na
                int n = sw.size()
                if n > 0
                    for i = 0 to n - 1
                        Swing x = sw.get(i)
                        if x.bi < dispBi and (na(swBi) or x.bi > swBi)
                            swBi := x.bi
                            swPx := x.px
                through := not na(swPx) and d * (swPx - close[k]) > 0
            if through
                // The block: the first opposite-close candle within five bars before the
                // displacement, and the consecutive run of the same colour behind it.
                int k0 = na
                int j  = k + 1
                while j <= k + 5 and na(k0)
                    bool opp = d > 0 ? close[j] > open[j] : close[j] < open[j]
                    if opp
                        k0 := j
                    j += 1
                if not na(k0)
                    top := high[k0]
                    bot := low[k0]
                    tm  := time[k0]
                    int cnt = 1
                    int m   = k0 + 1
                    bool more = true
                    while cnt < 4 and more
                        bool same = d > 0 ? close[m] > open[m] : close[m] < open[m]
                        if same
                            top := math.max(top, high[m])
                            bot := math.min(bot, low[m])
                            tm  := time[m]
                            cnt += 1
                            m   += 1
                        else
                            more := false
                    found := true
            k += 1
    [top, bot, tm, found]

//@function Applies the block search result on the MSS bar: the order block the leg into the sweep
//          left behind (see f_findBlock) confirms as a breaker once a close passes through it — the
//          block fails and flips in place, the way a gap inverts — this bar or later.
//@param s (Setup) The setup
//@param top (float) Block top
//@param bot (float) Block bottom
//@param tm (int) Block origin time
//@param found (bool) Whether a block was found
//@returns (void)
f_setBreaker(Setup s, float top, float bot, int tm, bool found) =>
    if not found
        s.brkPending := false
    if found
        s.brkTop := top
        s.brkBot := bot
        s.brkTm  := tm
        float prox = s.dir > 0 ? top : bot
        if s.dir * (close - prox) > 0
            s.hasBrk     := true
            s.brkLive    := true
            s.brkPending := false
            if showBrk
                f_drawBreaker(s, time + runwayBars * msPerBar, time + 2 * msPerBar)
    true

//@function Searches the bars inside the range swing's confirmation lag for a sweep that printed
//          before the setup could arm: the deepest wick through the level, with no run of closes
//          beyond it longer than the reclaim count since. Called every bar at global scope; does its
//          work only when active.
//@param d (int) Setup direction
//@param liq (float) The swept level
//@param maxBack (int) How many bars back to search (the bar after the push is the limit)
//@param active (bool) True on the bar the setup armed
//@returns ([float, int, int, bool]) extreme, time, bar index, found
f_findSweep(int d, float liq, int maxBack, bool active) =>
    float px    = na
    int   tm    = na
    int   bi    = na
    bool  found = false
    if active and maxBack >= 1 and bar_index > maxBack + 5
        bool  chain = true
        int   outCt = 0
        float cPx   = na
        int   cTm   = na
        int   cBi   = na
        int k = 1
        while k <= math.min(maxBack, 540) and chain
            float ck = close[k]
            bool inside = d * (ck - liq) >= 0
            outCt := inside ? 0 : outCt + 1
            if outCt > reclaimBars
                chain := false
            else
                float ek = d > 0 ? low[k] : high[k]
                if d * (liq - ek) > 0 and (na(cPx) or d * (cPx - ek) > 0)
                    cPx := ek
                    cTm := time[k]
                    cBi := bar_index - k
                // The excursion is a sweep only once an older close inside the level is reached:
                // a run that never came from inside is a break still in progress.
                if inside and not na(cPx)
                    px    := cPx
                    tm    := cTm
                    bi    := cBi
                    found := true
                k += 1
    [px, tm, bi, found]

//@function Applies a lookback sweep found on the arming bar.
//@param s (Setup) The setup
//@param px (float) The sweep extreme
//@param tm (int) Its time
//@param bi (int) Its bar index
//@param found0 (bool) Whether one was found
//@returns (void)
f_applySweep(Setup s, float px, int tm, int bi, bool found0) =>
    // A raid already turned away for want of the SMT is not found again.
    int  rej   = s.dir > 0 ? sg.rejLoBi : sg.rejHiBi
    bool found = found0 and (na(rej) or bi > rej)
    if found and s.state == 1
        s.state        := 2
        s.sweepPx      := px
        s.sweepTm      := tm
        s.sweepBi      := bi
        s.firstSweepBi := bi
        s.firstSweepTm := tm
        f_xcSet(s)
        f_xcUpdate(s)
        if showEarly or drawRange
            f_drawSweep(s)
    if found and s.state == 2 and s.dir * (s.sweepPx - px) > 0
        s.sweepPx      := px
        s.sweepTm      := tm
        s.sweepBi      := bi
        if bi < s.firstSweepBi
            s.firstSweepBi := bi
            s.firstSweepTm := tm
    true

// ============================================================================
// ENTRY LIFECYCLE — orthogonal to setup.state, observation only
// ============================================================================
f_entryGrade(Setup s) =>
    s.grade >= gradeAp ? 'A+' : s.grade >= gradeA ? 'A' : ''

f_entryGradeOk(Setup s) =>
    entryMinGrade == 'Off' or (entryMinGrade == 'A' and s.grade >= gradeA) or (entryMinGrade == 'A+' and s.grade >= gradeAp)

f_entrySourceLive(Setup s) =>
    switch s.entrySource
        'SB'      => s.sbLive
        'BISI'    => s.fvgLive
        'SIBI'    => s.fvgLive
        'VI'      => s.viLive
        'IFVG'    => s.ifvgLive
        'BREAKER' => s.brkLive
        => false

//@function Finds the first live same-direction PD array that overlaps the correct range third and,
//          when required, the confirmed OTE band. The returned intersection is the entry zone that
//          will be frozen on first touch.
//@returns ([string, float, float]) Source, top and bottom; empty/na when no candidate is eligible.
f_entryCandidate(Setup s) =>
    float rLo = math.min(s.liq, s.tgt)
    float rHi = math.max(s.liq, s.tgt)
    float thirdTop = s.dir > 0 ? rLo + (rHi - rLo) / 3.0 : rHi
    float thirdBot = s.dir > 0 ? rLo : rHi - (rHi - rLo) / 3.0
    float gateTop = entryRequireOte ? math.min(thirdTop, s.oteTop) : thirdTop
    float gateBot = entryRequireOte ? math.max(thirdBot, s.oteBot) : thirdBot
    string source = ''
    float top = na
    float bot = na
    if s.sbLive
        float t = math.min(s.sbTop, gateTop)
        float b = math.max(s.sbBot, gateBot)
        if t > b
            source := 'SB'
            top := t
            bot := b
    if source == '' and s.fvgLive
        float t = math.min(s.fvgTop, gateTop)
        float b = math.max(s.fvgBot, gateBot)
        if t > b
            source := s.dir > 0 ? 'BISI' : 'SIBI'
            top := t
            bot := b
    if source == '' and s.viLive
        float t = math.min(s.viTop, gateTop)
        float b = math.max(s.viBot, gateBot)
        if t > b
            source := 'VI'
            top := t
            bot := b
    if source == '' and s.ifvgLive
        float t = math.min(s.ifvgTop, gateTop)
        float b = math.max(s.ifvgBot, gateBot)
        if t > b
            source := 'IFVG'
            top := t
            bot := b
    if source == '' and s.brkLive
        float t = math.min(s.brkTop, gateTop)
        float b = math.max(s.brkBot, gateBot)
        if t > b
            source := 'BREAKER'
            top := t
            bot := b
    [source, top, bot]

f_queueEntryEvent(array<EntryEvent> events, string eventType, Setup s) =>
    string gradeNow = f_entryGrade(s)
    events.push(EntryEvent.new(
        eventType = eventType, dir = s.dir, mssAt = s.mssTm, eventAt = time,
        sweepPrice = s.sweepPx, targetPrice = s.tgt, grade = gradeNow,
        rrQualifiedAt = s.rrQualifiedAt, rrSource = s.rrSource,
        rrReferencePrice = s.rrReferencePrice, setupRR = s.setupRR,
        attempt = s.entryAttempt, source = s.entrySource,
        confirmationMethod = entryConfirm, zoneTop = s.entryZoneTop,
        zoneBottom = s.entryZoneBot, oteTop = s.entryOteTop, oteBottom = s.entryOteBot,
        oteConfirmedAt = entryRequireOte ? s.oteConfirmedAt : na,
        rangeLow = s.entryRangeLow, rangeHigh = s.entryRangeHigh,
        rangeThird = s.dir > 0 ? 'BOTTOM' : 'TOP', minimumGrade = entryMinGrade,
        gradeAtTouch = s.entryGradeTouch, gradeAtConfirmation = s.entryGradeConfirm,
        touchedAt = s.entryTouchedAt, confirmedAt = s.entryConfirmedAt,
        entryPrice = s.entryPrice, stopPrice = s.entryStop, entryRR = s.entryRR,
        eventPrice = close))
    true

f_entryInvalidate(Setup s, array<EntryEvent> events) =>
    if s.entryState == 1
        s.entryState := 3
        if not na(s.entryLbl)
            label.set_text(s.entryLbl, 'E' + str.tostring(s.entryAttempt) + ' · INVALIDATED')
        f_queueEntryEvent(events, 'ENTRY_INVALIDATED', s)
    true

//@function Resolves confirmed entry outcomes before the parent setup advances. Stop uses the wick;
//          target uses the setup's existing close-through-draw rule. If both happen on one candle,
//          ambiguity is recorded instead of selecting a favourable sequence.
f_entryBeforeSetup(Setup s, array<EntryEvent> events) =>
    if entryOn and s.state == 3
        bool setupEnds = s.dir * (close - s.sweepPx) < 0 or s.dir * (close - s.tgt) > 0 or time - s.mssTm > setupMaxAgeMs
        if s.entryState == 1 and setupEnds
            f_entryInvalidate(s, events)
        if s.entryState == 2
            bool stopHit = s.dir > 0 ? low <= s.entryStop : high >= s.entryStop
            bool targetHit = s.dir * (close - s.tgt) > 0
            if stopHit and targetHit
                s.entryState := 6
                if not na(s.entryMarker)
                    label.set_text(s.entryMarker, 'E' + str.tostring(s.entryAttempt) + ' · AMBIGUOUS')
                f_queueEntryEvent(events, 'ENTRY_AMBIGUOUS', s)
            else if stopHit
                s.entryState := 4
                if not na(s.entryMarker)
                    label.set_text(s.entryMarker, 'E' + str.tostring(s.entryAttempt) + ' · STOPPED')
                f_queueEntryEvent(events, 'ENTRY_STOPPED', s)
            else if targetHit
                s.entryState := 5
                if not na(s.entryMarker)
                    label.set_text(s.entryMarker, 'E' + str.tostring(s.entryAttempt) + ' · TARGET TAKEN')
    true

//@function Creates, invalidates and confirms attempts after all arrays, OTE and grade have updated.
//          No marker exists in TOUCHED; the marker and actual-entry RR freeze only on confirmation.
f_entryAfterSetup(Setup s, array<EntryEvent> events) =>
    if entryOn and s.state == 3
        int runway = time + runwayBars * msPerBar
        if s.entryState == 2
            line.set_x2(s.entryPriceLn, runway)
            line.set_x2(s.entryStopLn, runway)
        bool invalidatedNow = false
        if s.entryState == 1
            bool invalid = not f_entrySourceLive(s) or (entryRequireOte and not s.oteLive) or s.dir * (close - s.sweepPx) < 0
            if invalid
                f_entryInvalidate(s, events)
                invalidatedNow := true
            else
                if not na(s.entryBx)
                    box.set_right(s.entryBx, time + 2 * msPerBar)
                    f_zoneCap(s.entryLbl, s.entryBx)
                if not na(s.entryConfirmLn)
                    line.set_x2(s.entryConfirmLn, runway)

        bool canStart = s.entryState == 0 or s.entryState == 3 or (entryReentry and s.entryState == 4)
        bool oteReady = not entryRequireOte or (s.hasOte and s.oteLive and not na(s.oteConfirmedAt) and time >= s.oteConfirmedAt)
        bool lifecycleReady = canStart and not invalidatedNow and s.rrQualified and f_entryGradeOk(s) and oteReady and s.entryConfirmedCount < entryMaxConfirmed
        if lifecycleReady
            [candidateSource, candidateTop, candidateBot] = f_entryCandidate(s)
            bool touched = candidateSource != '' and low <= candidateTop and high >= candidateBot
            if touched
                s.entryAttempt += 1
                s.entryState := 1
                s.entrySource := candidateSource
                s.entryZoneTop := candidateTop
                s.entryZoneBot := candidateBot
                s.entryOteTop := entryRequireOte ? s.oteTop : na
                s.entryOteBot := entryRequireOte ? s.oteBot : na
                s.entryRangeLow := math.min(s.liq, s.tgt)
                s.entryRangeHigh := math.max(s.liq, s.tgt)
                s.entryTouchedAt := time
                s.entryConfirmedAt := na
                s.entryPrice := na
                s.entryStop := na
                s.entryRR := na
                s.entryGradeTouch := f_entryGrade(s)
                s.entryGradeConfirm := ''
                color c = s.dir > 0 ? C_BULL : C_BEAR
                [entryBox, entryLabel] = f_zone(time, candidateTop, time + 2 * msPerBar, candidateBot, c, 82, true, 'E' + str.tostring(s.entryAttempt) + ' · TOUCHED')
                s.entryBx := entryBox
                s.entryLbl := entryLabel
                float confirmPrice = entryConfirm == 'CE_RECLAIM' ? math.avg(candidateTop, candidateBot) : (s.dir > 0 ? candidateTop : candidateBot)
                s.entryConfirmLn := f_level(time, runway, confirmPrice, c, 1, line.style_dotted)
                f_queueEntryEvent(events, 'ENTRY_TOUCHED', s)

        if s.entryState == 1
            float confirmPrice = entryConfirm == 'CE_RECLAIM' ? math.avg(s.entryZoneTop, s.entryZoneBot) : (s.dir > 0 ? s.entryZoneTop : s.entryZoneBot)
            float thirdCeiling = s.entryRangeLow + (s.entryRangeHigh - s.entryRangeLow) / 3.0
            float thirdFloor = s.entryRangeHigh - (s.entryRangeHigh - s.entryRangeLow) / 3.0
            bool entryInThird = s.dir > 0 ? close <= thirdCeiling + syminfo.mintick : close >= thirdFloor - syminfo.mintick
            bool reclaimed = s.dir * (close - confirmPrice) > 0 and entryInThird
            if reclaimed
                s.entryState := 2
                s.entryConfirmedCount += 1
                s.entryConfirmedAt := time
                s.entryPrice := close
                s.entryStop := s.sweepPx
                float risk = math.abs(s.entryPrice - s.entryStop)
                s.entryRR := risk > 0 ? math.abs(s.tgt - s.entryPrice) / risk : na
                s.entryGradeConfirm := f_entryGrade(s)
                color c = s.dir > 0 ? C_BULL : C_BEAR
                s.entryPriceLn := f_level(time, runway, s.entryPrice, c, 2, line.style_solid)
                s.entryStopLn := f_level(time, runway, s.entryStop, C_GRAY, 1, line.style_dotted)
                s.entryMarker := f_lbl(time, s.entryPrice, 'E' + str.tostring(s.entryAttempt) + ' · CONFIRMED · ' + str.tostring(s.entryRR, '#.0') + 'R', s.dir > 0 ? label.style_label_up : label.style_label_down)
                if not na(s.entryLbl)
                    label.delete(s.entryLbl)
                    s.entryLbl := na
                f_queueEntryEvent(events, 'ENTRY_CONFIRMED', s)
    true

// ============================================================================
// RUN
// ============================================================================
//@variable The live bullish and bearish setups.
var Setup bull = Setup.new(dir = 1)
var Setup bear = Setup.new(dir = -1)
//@variable Setups that have drawn, oldest first, pruned per direction.
var array<Setup> hist = array.new<Setup>()
//@variable Every target-taken event on the current bar, including retired historical setups.
var array<Setup> targetTakenEvents = array.new<Setup>()
//@variable Entry observations on the current confirmed bar; touch and confirmation may both appear.
var array<EntryEvent> entryEvents = array.new<EntryEvent>()
var Ev evBull = Ev.new()
var Ev evBear = Ev.new()

targetTakenEvents.clear()
entryEvents.clear()

evBull.swept   := false
evBull.mss     := false
evBull.a       := false
evBull.ap      := false
evBull.catchUp := false
evBull.broke   := false
evBull.rrQualified            := false
evBull.rrQualifiedTime        := na
evBull.rrQualifiedDir         := 0
evBull.rrQualifiedMssTime     := na
evBull.rrQualifiedSweepPrice  := na
evBull.rrQualifiedTargetPrice := na
evBull.rrReferencePrice       := na
evBull.rrSource               := ''
evBull.setupRR                := na
evBull.rrQualifiedGrade       := ''
evBull.failed            := false
evBull.failedTime        := na
evBull.failedDir         := 0
evBull.failedMssTime     := na
evBull.failedSweepPrice  := na
evBull.failedTargetPrice := na
evBull.failedGrade       := ''
evBull.failedRr          := na
evBull.failedRrQualifiedAt    := na
evBull.failedRrReferencePrice := na
evBull.failedRrSource         := ''
evBull.failedSetupRR          := na
evBull.retired            := false
evBull.retiredTime        := na
evBull.retiredDir         := 0
evBull.retiredSweepPrice  := na
evBull.retiredTargetPrice := na
evBull.retiredGrade       := ''
evBull.retiredMssTime     := na
evBull.retiredRr          := na
evBull.retiredRrQualifiedAt    := na
evBull.retiredRrReferencePrice := na
evBull.retiredRrSource         := ''
evBull.retiredSetupRR          := na
evBear.swept   := false
evBear.mss     := false
evBear.a       := false
evBear.ap      := false
evBear.catchUp := false
evBear.broke   := false
evBear.rrQualified            := false
evBear.rrQualifiedTime        := na
evBear.rrQualifiedDir         := 0
evBear.rrQualifiedMssTime     := na
evBear.rrQualifiedSweepPrice  := na
evBear.rrQualifiedTargetPrice := na
evBear.rrReferencePrice       := na
evBear.rrSource               := ''
evBear.setupRR                := na
evBear.rrQualifiedGrade       := ''
evBear.failed            := false
evBear.failedTime        := na
evBear.failedDir         := 0
evBear.failedMssTime     := na
evBear.failedSweepPrice  := na
evBear.failedTargetPrice := na
evBear.failedGrade       := ''
evBear.failedRr          := na
evBear.failedRrQualifiedAt    := na
evBear.failedRrReferencePrice := na
evBear.failedRrSource         := ''
evBear.failedSetupRR          := na
evBear.retired            := false
evBear.retiredTime        := na
evBear.retiredDir         := 0
evBear.retiredSweepPrice  := na
evBear.retiredTargetPrice := na
evBear.retiredGrade       := ''
evBear.retiredMssTime     := na
evBear.retiredRr          := na
evBear.retiredRrQualifiedAt    := na
evBear.retiredRrReferencePrice := na
evBear.retiredRrSource         := ''
evBear.retiredSetupRR          := na

float newPh   = na
float newPl   = na
int   newPvTm = na
int   newPvBi = na
float newHtfHi   = na
int   newHtfHiTm = na
int   newHtfHiBi = na
float newHtfLo   = na
int   newHtfLoTm = na
int   newHtfLoBi = na

// A body gap across a session or weekend break is a calendar artefact, not displacement.
bool joinNear = (time - time[1]) <= msPerBar * 1.5
bool joinFar  = (time[1] - time[2]) <= msPerBar * 1.5

if barstate.isconfirmed
    // ── The last pivLen + 1 bars, this bar first ──
    recLow.clear()
    recHigh.clear()
    for k = 0 to pivLen
        recLow.push(low[k])
        recHigh.push(high[k])

    // ── Follow the range timeframe: complete the previous candle, confirm its swings ──
    if newCandle and not na(curH)
        hH.push(curH)
        hL.push(curL)
        hC.push(curC)
        hHiTm.push(curHiTm)
        hHiBi.push(curHiBi)
        hLoTm.push(curLoTm)
        hLoBi.push(curLoBi)
        hCt.push(curCt)
        htfN += 1
        if hH.size() > CANDLE_CAP
            hH.shift()
            hL.shift()
            hC.shift()
            hHiTm.shift()
            hHiBi.shift()
            hLoTm.shift()
            hLoBi.shift()
            hCt.shift()
        int nC = hH.size()
        int ordBase = htfN - nC
        int iH = f_htfPivot(hH, true)
        if iH >= 0
            float prevMax = f_extreme(hHi, htfN - lookbackCdl, 1)
            float pxH = hH.get(iH)
            float maxC = na
            for j = iH to nC - 1
                maxC := na(maxC) ? hC.get(j) : math.max(maxC, hC.get(j))
            bool raid = not na(prevMax) and pxH > prevMax and maxC < prevMax
            f_pushSwing(hHi, Swing.new(px = pxH, tm = hHiTm.get(iH), bi = hHiBi.get(iH), ord = ordBase + iH, ct = hCt.get(iH), raid = raid))
            newHtfHi   := pxH
            newHtfHiTm := hHiTm.get(iH)
            newHtfHiBi := hHiBi.get(iH)
        int iL = f_htfPivot(hL, false)
        if iL >= 0
            float prevMin = f_extreme(hLo, htfN - lookbackCdl, -1)
            float pxL = hL.get(iL)
            float minC = na
            for j = iL to nC - 1
                minC := na(minC) ? hC.get(j) : math.min(minC, hC.get(j))
            bool raid = not na(prevMin) and pxL < prevMin and minC > prevMin
            f_pushSwing(hLo, Swing.new(px = pxL, tm = hLoTm.get(iL), bi = hLoBi.get(iL), ord = ordBase + iL, ct = hCt.get(iL), raid = raid))
            newHtfLo   := pxL
            newHtfLoTm := hLoTm.get(iL)
            newHtfLoBi := hLoBi.get(iL)
    if newCandle
        curO    := open
        curH    := high
        curL    := low
        curHiTm := time
        curHiBi := bar_index
        curLoTm := time
        curLoBi := bar_index
        curCt   := htfT
        curOBi  := bar_index
    else
        if high > curH
            curH    := high
            curHiTm := time
            curHiBi := bar_index
        if low < curL
            curL    := low
            curLoTm := time
            curLoBi := bar_index
    curC := close

    // ── The dealing range: form once, hold, rebuild only on a close through a side ──
    if na(drHiPx) or na(drLoPx)
        // Tracking: the latest confirmed swing each side. Held: the widest swings in the lookback.
        Swing hiS = drHold ? f_extSwing(hHi, htfN - lookbackCdl, 1)  : hHi.size() > 0 ? hHi.last() : na
        Swing loS = drHold ? f_extSwing(hLo, htfN - lookbackCdl, -1) : hLo.size() > 0 ? hLo.last() : na
        if not na(hiS) and not na(loS) and hiS.px - loS.px >= minRangeAtr * atr
            drHiPx := hiS.px
            drHiTm := hiS.tm
            drHiBi := hiS.bi
            drHiCt := hiS.ct
            drLoPx := loS.px
            drLoTm := loS.tm
            drLoBi := loS.bi
            drLoCt := loS.ct
            drHiPend := false
            drLoPend := false
            drOutHi  := 0
            drOutLo  := 0
    else
        // Tracking: a swing the range timeframe confirms on this bar becomes that side, swing to
        // swing. A side still forming after a break keeps its own lock rule below.
        if not drHold
            if not na(newHtfHi) and not drHiPend and hHi.size() > 0
                Swing nh = hHi.last()
                drHiPx := nh.px
                drHiTm := nh.tm
                drHiBi := nh.bi
                drHiCt := nh.ct
                drOutHi := 0
            if not na(newHtfLo) and not drLoPend and hLo.size() > 0
                Swing nl = hLo.last()
                drLoPx := nl.px
                drLoTm := nl.tm
                drLoBi := nl.bi
                drLoCt := nl.ct
                drOutLo := 0
        // A forming side follows price, and locks on the first range-timeframe swing after the break.
        if drHiPend
            if high >= drHiPx
                drHiPx := high
                drHiTm := time
                drHiBi := bar_index
                drHiCt := htfT
            if hHi.size() > 0
                Swing lastH = hHi.last()
                if lastH.bi >= drBreakBi
                    drHiPx := lastH.px
                    drHiTm := lastH.tm
                    drHiBi := lastH.bi
                    drHiCt := lastH.ct
                    drHiPend   := false
                    drBrokeDir := 0
        if drLoPend
            if low <= drLoPx
                drLoPx := low
                drLoTm := time
                drLoBi := bar_index
                drLoCt := htfT
            if hLo.size() > 0
                Swing lastL = hLo.last()
                if lastL.bi >= drBreakBi
                    drLoPx := lastL.px
                    drLoTm := lastL.tm
                    drLoBi := lastL.bi
                    drLoCt := lastL.ct
                    drLoPend   := false
                    drBrokeDir := 0
        // A close through a side, held past the reclaim allowance, is a break: that side is spent.
        if not drHiPend and not drLoPend
            drOutHi := close > drHiPx ? drOutHi + 1 : 0
            drOutLo := close < drLoPx ? drOutLo + 1 : 0
            if drOutHi > reclaimBars
                drBrokeDir := 1
                drBrokePx  := drHiPx
                drBrokeTm  := drHiTm
                drBreakBi  := bar_index - drOutHi
                Swing org = f_lastSwing(hLo, drBreakBi)
                if not na(org)
                    drLoPx := org.px
                    drLoTm := org.tm
                    drLoBi := org.bi
                    drLoCt := org.ct
                float mx = high
                int   mk = 0
                for k = 0 to drOutHi
                    if high[k] > mx
                        mx := high[k]
                        mk := k
                drHiPx := mx
                drHiTm := time[mk]
                drHiBi := bar_index - mk
                drHiCt := htfT[mk]
                drHiPend := true
                drOutHi  := 0
                drOutLo  := 0
            else if drOutLo > reclaimBars
                drBrokeDir := -1
                drBrokePx  := drLoPx
                drBrokeTm  := drLoTm
                drBreakBi  := bar_index - drOutLo
                Swing org = f_lastSwing(hHi, drBreakBi)
                if not na(org)
                    drHiPx := org.px
                    drHiTm := org.tm
                    drHiBi := org.bi
                    drHiCt := org.ct
                float mn = low
                int   mk = 0
                for k = 0 to drOutLo
                    if low[k] < mn
                        mn := low[k]
                        mk := k
                drLoPx := mn
                drLoTm := time[mk]
                drLoBi := bar_index - mk
                drLoCt := htfT[mk]
                drLoPend := true
                drOutHi  := 0
                drOutLo  := 0

    // ── Chart swings: the structure the MSS breaks and the leg the OTE measures ──
    if not na(ph)
        f_pushSwing(cHi, Swing.new(px = ph, tm = time[pivLen], bi = bar_index - pivLen, ord = bar_index - pivLen, ct = htfT[pivLen], raid = false))
        newPh := ph
    if not na(pl)
        f_pushSwing(cLo, Swing.new(px = pl, tm = time[pivLen], bi = bar_index - pivLen, ord = bar_index - pivLen, ct = htfT[pivLen], raid = false))
        newPl := pl
    if not na(ph) or not na(pl)
        newPvTm := time[pivLen]
        newPvBi := bar_index - pivLen

    // ── Peers and the catch-up timeframe ──
    if p1New
        f_pushCandle(peer1, p1H, p1L, p1T)
    if p2New
        f_pushCandle(peer2, p2H, p2L, p2T)
    if gNew and not na(gT1)
        if gL1 > gH3
            gapUpTm.push(gT1)
        if gH1 < gL3
            gapDnTm.push(gT1)
        if gapUpTm.size() > 50
            gapUpTm.shift()
        if gapDnTm.size() > 50
            gapDnTm.shift()

    // ── Mitigation of stored imbalances, before this bar's new ones join ──
    f_markMitigated(bullZ, bullW, 1)
    f_markMitigated(bearZ, bearW, -1)
    // ── Confirmed imbalances: suspension block, wick gap, volume imbalance ──
    float minH = minGapAtr * atr
    bool sbUp = close[2] > open[2] and close[1] > open[1] and close > open and open[1] > close[2] and open > close[1]
    bool sbDn = close[2] < open[2] and close[1] < open[1] and close < open and open[1] < close[2] and open < close[1]
    if joinNear and joinFar and sbUp and open - close[2] >= minH
        f_pushZone(bullZ, bullW, 1, 2, open, close[2], time[2], bar_index)
    if joinNear and joinFar and sbDn and close[2] - open >= minH
        f_pushZone(bearZ, bearW, -1, 2, close[2], open, time[2], bar_index)
    // A gap across the weekend or the daily halt is the market being shut, not displacement: the
    // triplet has to run on consecutive bars, the same guard the VI and the SB already carry.
    if joinNear and joinFar and low > high[2] and low - high[2] >= minH
        f_pushZone(bullZ, bullW, 1, 0, low, high[2], time[1], bar_index - 1)
    if joinNear and joinFar and high < low[2] and low[2] - high >= minH
        f_pushZone(bearZ, bearW, -1, 0, low[2], high, time[1], bar_index - 1)
    float bodyLo  = math.min(open, close)
    float bodyHi  = math.max(open, close)
    float pBodyLo = math.min(open[1], close[1])
    float pBodyHi = math.max(open[1], close[1])
    if joinNear and bodyLo > pBodyHi and low <= high[1] and bodyLo - pBodyHi >= minH
        f_pushZone(bullZ, bullW, 1, 1, bodyLo, pBodyHi, time[1], bar_index)
    if joinNear and bodyHi < pBodyLo and high >= low[1] and pBodyLo - bodyHi >= minH
        f_pushZone(bearZ, bearW, -1, 1, pBodyLo, bodyHi, time[1], bar_index)

    // ── Order blocks for the breakers between setups: flip and spend the stored ones first ──
    // These blocks feed only the breakers drawn between setups, so nothing is walked when those are off.
    bool brkAmb = ambOn and showBrk
    // A bar closing between the lowest edge a close above can cross and the highest edge a close below
    // can cross changes no block, so the walk is skipped.
    bool blkHit = (not na(blkW.live) and close > blkW.live) or (not na(blkW.mit) and close < blkW.mit)
    if brkAmb and blocks.size() > 0 and blkHit
        float nUp = na
        float nDn = na
        for i = blocks.size() - 1 to 0
            Block k = blocks.get(i)
            // A bearish block (dir -1) flips on a close above its top and is spent on a close below
            // its bottom; a bullish one the mirror.
            bool spent = k.flipped and (k.dir < 0 ? close < k.bot : close > k.top)
            if spent
                blocks.remove(i)
            else
                if not k.flipped and (k.dir < 0 ? close > k.top : close < k.bot)
                    k.flipped := true
                // Bearish unflipped and bullish flipped change on a close above the top; the others below the bottom.
                if (k.dir < 0) != k.flipped
                    nUp := na(nUp) ? k.top : math.min(nUp, k.top)
                else
                    nDn := na(nDn) ? k.bot : math.max(nDn, k.bot)
        blkW.live := nUp
        blkW.mit  := nDn
    // The same reading f_findBlock walks back for a setup, read forward on the bar after the
    // displacement candle, because the gap around it needs the candle that follows.
    if brkAmb and joinNear and joinFar and bar_index > 10
        for pass = 0 to 1
            int  bd      = pass == 0 ? 1 : -1                 // the displacement's direction
            bool dispDir = bd > 0 ? close[1] > open[1] : close[1] < open[1]
            bool dispBody = math.abs(close[1] - open[1]) >= obDispAtr * atr
            bool dispGap  = bd > 0 ? high[2] < low : low[2] > high
            if dispDir and dispBody and dispGap
                array<Swing> brkSw = bd > 0 ? cHi : cLo
                Swing lastSw = f_lastSwing(brkSw, bar_index - 2)
                if not na(lastSw) and bd * (close[1] - lastSw.px) > 0
                    int k0 = na
                    int j  = 2
                    while j <= 6 and na(k0)
                        bool opp = bd > 0 ? close[j] < open[j] : close[j] > open[j]
                        if opp
                            k0 := j
                        j += 1
                    if not na(k0)
                        float bTop = high[k0]
                        float bBot = low[k0]
                        int   bTm  = time[k0]
                        int   cnt  = 1
                        int   m    = k0 + 1
                        bool  more = true
                        while cnt < 4 and more
                            bool same = bd > 0 ? close[m] < open[m] : close[m] > open[m]
                            if same
                                bTop := math.max(bTop, high[m])
                                bBot := math.min(bBot, low[m])
                                bTm  := time[m]
                                cnt  += 1
                                m    += 1
                            else
                                more := false
                        blocks.push(Block.new(dir = bd, top = bTop, bot = bBot, tm = bTm, bi = bar_index - k0))
                        // A new block is unflipped: a bearish one watches its top, a bullish one its bottom.
                        if bd < 0
                            blkW.live := na(blkW.live) ? bTop : math.min(blkW.live, bTop)
                        else
                            blkW.mit  := na(blkW.mit)  ? bBot : math.max(blkW.mit, bBot)
                        // Twenty is plenty: at most four breakers a direction are ever drawn, nearest first.
                        if blocks.size() > 20
                            blocks.shift()

    // ── Advance both directions ──
    // The dealing range's version: a setup rereads the range only when this moves.
    if nz(drHiPx, -1) != nz(drHiPx[1], -1) or nz(drLoPx, -1) != nz(drLoPx[1], -1) or nz(drHiBi, -1) != nz(drHiBi[1], -1) or nz(drLoBi, -1) != nz(drLoBi[1], -1) or drHiPend != drHiPend[1] or drLoPend != drLoPend[1]
        drVer += 1
    // Entry outcomes are resolved against the existing live setup before f_run can replace a setup
    // on failure, retirement or target. This does not alter the parent's six-state machine.
    f_entryBeforeSetup(bull, entryEvents)
    f_entryBeforeSetup(bear, entryEvents)
    bull := f_run(bull, evBull, hist, targetTakenEvents, hLo, hHi, cHi, bullZ, bearZ)
    bear := f_run(bear, evBear, hist, targetTakenEvents, hHi, hLo, cLo, bearZ, bullZ)
    // A side that has been raided stays dotted for as long as this range holds: solid is live,
    // dotted is spent, so the line itself reports the sweep and no tag has to sit in price. The
    // flags clear when the side moves, which is the range rebuilding rather than the same level
    // being raided twice.
    if drLoPx != drLoPx[1]
        drLoRaided := false
    if drHiPx != drHiPx[1]
        drHiRaided := false
    if evBull.swept
        drLoRaided := true
    if evBear.swept
        drHiRaided := true

    // ── The peers on this bar, and the SMT drawn where the sweep is ──
    f_peerLiqChart(bull, q1L, q2L)
    f_peerLiqChart(bear, q1H, q2H)
    f_drawSmt(bull)
    f_drawSmt(bear)

// ── Sweeps inside the range swing's confirmation lag, on the bar a setup arms ──
bool bullSwReq = barstate.isconfirmed and bull.justArmed
bool bearSwReq = barstate.isconfirmed and bear.justArmed
int  bullSwBack = bullSwReq ? bar_index - bull.pushBi - 1 : 0
int  bearSwBack = bearSwReq ? bar_index - bear.pushBi - 1 : 0
[swPxB, swTmB, swBiB, swFB] = f_findSweep(1, bull.liq, bullSwBack, bullSwReq)
[swPxS, swTmS, swBiS, swFS] = f_findSweep(-1, bear.liq, bearSwBack, bearSwReq)
if bullSwReq
    f_applySweep(bull, swPxB, swTmB, swBiB, swFB)
if bearSwReq
    f_applySweep(bear, swPxS, swTmS, swBiS, swFS)

if barstate.isconfirmed
    // ── OTE, on every live bar including the one the MSS confirmed on ──
    if bull.state == 3
        if oteSwing == 'Range timeframe'
            f_tryOte(bull, newHtfHi, newHtfHiTm, newHtfHiBi, time + 2 * msPerBar)
        else
            f_tryOte(bull, ph2, time[1], bar_index - 1, time + 2 * msPerBar)
        f_grade(bull, evBull)
    if bear.state == 3
        if oteSwing == 'Range timeframe'
            f_tryOte(bear, newHtfLo, newHtfLoTm, newHtfLoBi, time + 2 * msPerBar)
        else
            f_tryOte(bear, pl2, time[1], bar_index - 1, time + 2 * msPerBar)
        f_grade(bear, evBear)
    // ── Cross-check: re-read the peers on their new candles, watch for the catch-up gap ──
    if p1New or p2New
        f_xcUpdate(bull)
        f_xcUpdate(bear)
    if bull.state >= 2 and bull.state <= 3 and not bull.catchUp and f_isLaggard(bull) and f_catchUpGap(bull, bullZ)
        bull.catchUp   := true
        evBull.catchUp := true
    if bear.state >= 2 and bear.state <= 3 and not bear.catchUp and f_isLaggard(bear) and f_catchUpGap(bear, bearZ)
        bear.catchUp   := true
        evBear.catchUp := true

// The breaker search reads bar history, so it runs at global scope on every bar and only works
// on the bar an MSS confirmed.
bool bullBrkReq = barstate.isconfirmed and bull.state == 3 and bull.mssBi == bar_index and bull.brkPending and na(bull.brkTop)
bool bearBrkReq = barstate.isconfirmed and bear.state == 3 and bear.mssBi == bar_index and bear.brkPending and na(bear.brkTop)
int  bullBack   = bullBrkReq ? bar_index - bull.sweepBi : 0
int  bearBack   = bearBrkReq ? bar_index - bear.sweepBi : 0
// The leg into the sweep starts at the last chart swing on the far side before the sweep bar.
Swing bullOrg  = bullBrkReq ? f_lastSwing(cHi, bull.sweepBi - 1) : na
Swing bearOrg  = bearBrkReq ? f_lastSwing(cLo, bear.sweepBi - 1) : na
int  bullLeg   = bullBrkReq and not na(bullOrg) ? bar_index - bullOrg.bi : bullBack + 60
int  bearLeg   = bearBrkReq and not na(bearOrg) ? bar_index - bearOrg.bi : bearBack + 60
[bkT, bkB, bkTm, bkF] = f_findBlock(1, bullBack, bullLeg, cLo, bullBrkReq)
[skT, skB, skTm, skF] = f_findBlock(-1, bearBack, bearLeg, cHi, bearBrkReq)
if bullBrkReq
    f_setBreaker(bull, bkT, bkB, bkTm, bkF)
    f_grade(bull, evBull)
if bearBrkReq
    f_setBreaker(bear, skT, skB, skTm, skF)
    f_grade(bear, evBear)

if barstate.isconfirmed
    if bull.state == 3
        f_rrQualifiedEvent(evBull, bull)
        f_entryAfterSetup(bull, entryEvents)
    if bear.state == 3
        f_rrQualifiedEvent(evBear, bear)
        f_entryAfterSetup(bear, entryEvents)

// ── History: an untaken draw of a retired setup runs to price until a close takes it ──
if hist.size() > 0
    int hRun = time + runwayBars * msPerBar
    for i = 0 to hist.size() - 1
        Setup hs = hist.get(i)
        if hs.state == 4 and hs.outcome == 'retired' and not na(hs.tgtLn)
            if barstate.isconfirmed and hs.dir * (close - hs.tgt) > 0
                line.set_style(hs.tgtLn, line.style_dotted)
                line.set_x2(hs.tgtLn, time)
                label.set_xy(hs.tgtLbl, time, hs.tgt)
                f_targetTakenEvent(targetTakenEvents, hs)
                hs.outcome := 'target taken'
            else
                line.set_x2(hs.tgtLn, hRun)
                label.set_x(hs.tgtLbl, hRun)

// ── History: drop dead setups, keep the last N per direction ──
if barstate.isconfirmed and hist.size() > 0
    for i = hist.size() - 1 to 0
        if hist.get(i).state == 5
            hist.remove(i)
    int nBull = 0
    int nBear = 0
    if hist.size() > 0
        for i = 0 to hist.size() - 1
            if hist.get(i).dir > 0
                nBull += 1
            else
                nBear += 1
    while nBull > keepSetups or nBear > keepSetups
        int victimDir = nBull > keepSetups ? 1 : -1
        int victimI   = -1
        if hist.size() > 0
            for i = 0 to hist.size() - 1
                if victimI < 0 and hist.get(i).dir == victimDir
                    victimI := i
        if victimI >= 0
            Setup v = hist.get(victimI)
            f_wipe(v)
            v.state := 5
            hist.remove(victimI)
        if victimDir > 0
            nBull -= 1
        else
            nBear -= 1

// ============================================================================
// RANGE THIRDS — the position of price, optional dotted lines
// ============================================================================
//@function The setup whose range the console and the thirds read: the live one, else the swept one,
//          else whichever direction currently holds a range.
//@returns (Setup) A setup, possibly with no range, never na
f_focus() =>
    Setup r = bull
    if bull.state == 3 and bear.state == 3
        r := bull.mssBi >= bear.mssBi ? bull : bear
    else if bull.state == 3
        r := bull
    else if bear.state == 3
        r := bear
    else if bull.state == 2 and bear.state == 2
        r := bull.sweepBi >= bear.sweepBi ? bull : bear
    else if bull.state == 2
        r := bull
    else if bear.state == 2
        r := bear
    else if na(bull.tgt) and not na(bear.tgt)
        r := bear
    r

//@function Where price sits in a range.
//@param lo (float) Range low
//@param hi (float) Range high
//@returns (string) top third · middle · bottom third, or empty
f_position(float lo, float hi) =>
    string r = ''
    if not na(lo) and not na(hi) and hi > lo
        float f = (close - lo) / (hi - lo)
        r := f > 2.0 / 3.0 ? 'top third' : f < 1.0 / 3.0 ? 'bottom third' : 'middle'
    r

// ============================================================================
// DEALING RANGE — on the chart as soon as it exists
// ============================================================================
//@function Keeps one side of the range drawn, or removes it.
//@param ln (line) The existing line or na
//@param lb (label) The existing label or na
//@param show (bool) Whether the side shows
//@param x1 (int) The swing's time
//@param x2 (int) Right-hand end
//@param px (float) The level
//@param txt (string) Label text
//@param c (color) Line colour
//@param sty (string) Line style
//@returns ([line, label]) The drawings, na when hidden
f_rngSide(line ln, label lb, bool show, int x1, int x2, float px, string txt, color c, string sty) =>
    line  l2 = ln
    label b2 = lb
    if not show and not na(l2)
        line.delete(l2)
        label.delete(b2)
        l2 := na
        b2 := na
    // The name sits ON the line, just past its right end, so it reads as the level's continuation and
    // clears price by the right offset.
    string lSty = label.style_label_left
    if show and na(l2)
        l2 := f_level(x1, x2, px, c, liqWidth, sty)
        b2 := f_lbl(x2, px, txt, lSty)
    if show and not na(l2)
        line.set_xy1(l2, x1, px)
        line.set_xy2(l2, x2, px)
        line.set_color(l2, c)
        line.set_style(l2, sty)
        label.set_xy(b2, x2, px)
        label.set_text(b2, txt)
        label.set_style(b2, lSty)
    [l2, b2]

var line  rngHiLn  = na
var line  rngLoLn  = na
var line  rngBrkLn = na
var label rngHiLbl = na
var label rngLoLbl = na
var label rngBrkLbl = na

if drawRange
    int  runway = time + runwayBars * msPerBar
    bool have   = not na(drHiPx) and not na(drLoPx)
    // A side a setup already draws — the sweep line on the raided side, the target line after the
    // MSS — is not drawn twice.
    bool loOwned = bull.state >= 2 or bear.state >= 3
    bool hiOwned = bear.state >= 2 or bull.state >= 3
    // A raided side is spent. Unless taken liquidity is being kept, it comes OFF - the dotted style
    // says it is spent, but a line on the chart is still a line being read as a draw.
    bool showLo  = have and not loOwned and (poolKeep or not drLoRaided)
    bool showHi  = have and not hiOwned and (poolKeep or not drHiRaided)
    string loTxt = 'SSL · ERL · ' + RTF_NAME + (drLoPend ? ' · forming' : bear.state == 2 ? ' · draw' : '')
    string hiTxt = 'BSL · ERL · ' + RTF_NAME + (drHiPend ? ' · forming' : bull.state == 2 ? ' · draw' : '')
    // SOLID IS LIVE, DOTTED IS SPENT — the one line-style rule this whole stack runs on, and the
    // only thing the style is allowed to say. A side that is still FORMING has not been taken, so it
    // is live and it is SOLID; "forming" is carried by the text, which is where a provisional state
    // belongs. Only a RAID dots a side. (Before this, a forming side drew dotted and a broken side
    // drew solid — the rule exactly inverted on both.)
    [l1, b1] = f_rngSide(rngLoLn, rngLoLbl, showLo, drLoTm, runway, drLoPx, loTxt, liqCol, drLoRaided ? line.style_dotted : line.style_solid)
    [l2, b2] = f_rngSide(rngHiLn, rngHiLbl, showHi, drHiTm, runway, drHiPx, hiTxt, liqCol, drHiRaided ? line.style_dotted : line.style_solid)
    // The side price closed through stays, grey, until the side replacing it has formed. It is spent,
    // so it is DOTTED, and the word is gone with it: the same ruling that removed the Sweep tag —
    // a label paying to say what the style already says.
    bool showBroke = have and drBrokeDir != 0 and poolKeep
    string brkTxt = (drBrokeDir > 0 ? 'BSL' : 'SSL') + ' · ERL · ' + RTF_NAME
    [l3, b3] = f_rngSide(rngBrkLn, rngBrkLbl, showBroke, drBrokeTm, runway, drBrokePx, brkTxt, C_GRAY, line.style_dotted)
    rngLoLn   := l1
    rngLoLbl  := b1
    rngHiLn   := l2
    rngHiLbl  := b2
    rngBrkLn  := l3
    rngBrkLbl := b3

var line thirdLo  = na
var line thirdHi  = na
var label thirdLoLbl = na
var label thirdHiLbl = na

// ============================================================================
// LIQUIDITY POOLS
// ============================================================================
//@function Books a pool, or merges it into an unswept one already at that price. Merging is what
//          makes a cluster of near-equal highs ONE level called EQH instead of six lines: the pool
//          keeps the MORE EXTREME price, because that is the one a raid has to take out.
//@param px (float) The level.
//@param tm (int) Bar time of the swing that made it.
//@param isHigh (bool) Buyside or sellside.
//@param origin (string) What made it - 'Swing', 'PDH', 'PWL' and so on.
//@param tol (float) Equal-level tolerance in price.
//@returns (bool) Always true.
f_bookPool(float px, int tm, bool isHigh, string origin, float tol) =>
    if not na(px) and not na(tm)
        bool merged = false
        if pools.size() > 0
            for i = 0 to pools.size() - 1
                Pool p = pools.get(i)
                if not merged and p.isHigh == isHigh and not p.taken and math.abs(p.px - px) <= tol
                    merged     := true
                    p.touches  += 1
                    p.px       := isHigh ? math.max(p.px, px) : math.min(p.px, px)
                    // A period level keeps its own name; two plain swings become an equal pool.
                    p.origin   := p.origin == 'Swing' and origin == 'Swing' ? (isHigh ? 'REH' : 'REL') : p.origin
        if not merged
            pools.push(Pool.new(px = px, tm = tm, isHigh = isHigh, origin = origin))
        // The nearest untaken level each side is what a wick has to reach before any pool is taken.
        if isHigh
            poolW.live := na(poolW.live) ? px : math.min(poolW.live, px)
        else
            poolW.mit  := na(poolW.mit)  ? px : math.max(poolW.mit, px)
        while pools.size() > POOL_CAP
            Pool old = pools.shift()
            if not na(old.ln)
                line.delete(old.ln)
            if not na(old.lb)
                label.delete(old.lb)
    true

// Book the chart's own confirmed swings. ph/pl are the script's existing pivots, so a pool and the
// structure this script already reads come from the same definition rather than a second one.
float poolTol = nz(atrStruct, atr) * poolEqAtr
if poolsOn and poolSwing and barstate.isconfirmed
    if not na(ph)
        f_bookPool(ph, time[pivLen], true,  'Swing', poolTol)
    if not na(pl)
        f_bookPool(pl, time[pivLen], false, 'Swing', poolTol)

// Previous day and previous week, on the NEW YORK clock - these are ICT definitions stated in New
// York time, so any other clock reports a different window under the same name.
[pdH_, pdL_, pdT_] = request.security(syminfo.tickerid, 'D', [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
[pwH_, pwL_, pwT_] = request.security(syminfo.tickerid, 'W', [high[1], low[1], time[1]], lookahead = barmerge.lookahead_on)
bool dRoll = not na(pdT_) and pdT_ != nz(pdT_[1], 0)
bool wRoll = not na(pwT_) and pwT_ != nz(pwT_[1], 0)

// The chart candle that printed each day's and week's high and low, so a period level starts at
// that candle and not at the opening time of the higher timeframe bar.
var float dRunH = na
var int   dRunHTm = na
var float dRunL = na
var int   dRunLTm = na
var float wRunH = na
var int   wRunHTm = na
var float wRunL = na
var int   wRunLTm = na

//@function The chart candle time that made a period level, or the period's own time when the chart did not see the whole period.
//@param run (float) The extreme the chart tracked through the period.
//@param runTm (int) Bar time of the chart candle that printed it.
//@param lvl (float) The period level.
//@param fb (int) The period's opening time.
//@returns (int) Bar time to anchor the level at.
f_lvlTm(float run, int runTm, float lvl, int fb) =>
    not na(run) and not na(lvl) and math.abs(run - lvl) <= poolTol ? runTm : fb

if poolsOn and poolPd and dRoll
    f_bookPool(pdH_, f_lvlTm(dRunH, dRunHTm, pdH_, pdT_), true,  'PDH', poolTol)
    f_bookPool(pdL_, f_lvlTm(dRunL, dRunLTm, pdL_, pdT_), false, 'PDL', poolTol)
if poolsOn and poolPw and wRoll
    f_bookPool(pwH_, f_lvlTm(wRunH, wRunHTm, pwH_, pwT_), true,  'PWH', poolTol)
    f_bookPool(pwL_, f_lvlTm(wRunL, wRunLTm, pwL_, pwT_), false, 'PWL', poolTol)

if dRoll or na(dRunH) or high > dRunH
    dRunH   := high
    dRunHTm := time
if dRoll or na(dRunL) or low < dRunL
    dRunL   := low
    dRunLTm := time
if wRoll or na(wRunH) or high > wRunH
    wRunH   := high
    wRunHTm := time
if wRoll or na(wRunL) or low < wRunL
    wRunL   := low
    wRunLTm := time

// Taken the moment price trades through, WICK INCLUDED - a raid is a raid whether or not the candle
// closed beyond it. Taken pools are dropped entirely unless they are being kept.
// Only a wick reaching the lowest untaken buyside or the highest untaken sellside can take anything.
bool poolHit = (not na(poolW.live) and high >= poolW.live) or (not na(poolW.mit) and low <= poolW.mit)
if poolsOn and pools.size() > 0 and poolHit
    float nHi = na
    float nLo = na
    for i = pools.size() - 1 to 0
        Pool p = pools.get(i)
        if not p.taken and (p.isHigh ? high >= p.px : low <= p.px)
            p.taken := true
        if p.taken and not poolKeep
            if not na(p.ln)
                line.delete(p.ln)
            if not na(p.lb)
                label.delete(p.lb)
            pools.remove(i)
        else if not p.taken
            if p.isHigh
                nHi := na(nHi) ? p.px : math.min(nHi, p.px)
            else
                nLo := na(nLo) ? p.px : math.max(nLo, p.px)
    poolW.live := nHi
    poolW.mit  := nLo

// ── Draw the pools: nearest to price first, capped per side, out of range dropped ──────────
if poolsOn and barstate.islast and pools.size() > 0
    int   pRun   = time + runwayBars * msPerBar
    float maxDst = atr * poolMaxAtr
    int   shownH = 0
    int   shownL = 0
    array<float> shownHPx = array.new<float>()
    array<float> shownLPx = array.new<float>()
    // Nearest first, so the cap keeps the pools in play rather than the oldest ones.
    // The built-in sort, not a hand swap loop: a `size() - 2` bound is -1 with one pool, and a Pine
    // loop counts DOWN to it, reading past the end of the array.
    array<float> poolDst = array.new<float>()
    for i = 0 to pools.size() - 1
        poolDst.push(math.abs(pools.get(i).px - close))
    array<int> nearIdx = poolDst.sort_indices(order.ascending)
    for k = 0 to nearIdx.size() - 1
        Pool p = pools.get(nearIdx.get(k))
        bool room = p.isHigh ? shownH < poolMax : shownL < poolMax
        bool near = math.abs(p.px - close) <= maxDst
        // A lone swing is one candle, not resting liquidity. Liquidity Levels+ draws a pool only
        // when TWO pivots rest at the same price, and that is the definition used here: a plain
        // 'Swing' has merged nothing, so it never reaches the chart. A named period level - PDH,
        // PWL - is a pool on its own and is exempt.
        bool paired = not poolPaired or p.origin != 'Swing'
        // ERL is EXTERNAL. Anything resting between the two range edges is internal liquidity and
        // belongs to the range, not beside it - drawing it is what buried the chart in lines.
        // A range with a side still forming is not a range yet - filtering against its provisional
        // edges made pools blink out and back as those edges settled.
        bool drReady = not na(drHiPx) and not na(drLoPx) and not drHiPend and not drLoPend
        bool outside = not poolOutside or not drReady or p.px >= drHiPx or p.px <= drLoPx
        // Taken is taken. The take block already drops a run pool from the store when taken pools
        // are not being kept; this is the second gate, for the bar it is taken on.
        // One name per price. A pool within two tolerances of one already drawn on its side, or of a
        // range edge, reads as the same level; the nearer one keeps the name.
        bool clear = true
        array<float> shownPx = p.isHigh ? shownHPx : shownLPx
        if shownPx.size() > 0
            for j = 0 to shownPx.size() - 1
                if math.abs(shownPx.get(j) - p.px) <= 2 * poolTol
                    clear := false
        float edgePx = p.isHigh ? drHiPx : drLoPx
        if not na(edgePx) and math.abs(edgePx - p.px) <= 2 * poolTol
            clear := false
        bool show = room and near and paired and outside and clear and (poolKeep or not p.taken)
        if show
            shownPx.push(p.px)
            if p.isHigh
                shownH += 1
            else
                shownL += 1
        // A previous day or week level carries the date of the session it came from.
        bool   isPeriod = p.origin == 'PDH' or p.origin == 'PDL' or p.origin == 'PWH' or p.origin == 'PWL'
        string pDate    = isPeriod ? ' ' + str.format_time(p.tm + 6 * 3600000, 'dd/MM', 'America/New_York') : ''
        string ptxt = isPeriod ? p.origin + pDate : p.origin == 'Swing' ? (p.isHigh ? 'BSL' : 'SSL') : p.origin
        // Same language as every other level in this script: solid while live, dotted once taken.
        [poolLn, poolLb] = f_rngSide(p.ln, p.lb, show, p.tm, pRun, p.px, ptxt, p.taken ? C_GRAY : liqCol, p.taken ? line.style_dotted : line.style_solid)
        p.ln := poolLn
        p.lb := poolLb

// ============================================================================
// SWING-LEG OTE — between setups
// ============================================================================
// An up leg runs from its low to the highest high since and extends with every new high; a new high
// made after a swing low confirmed beneath the old one restarts the leg from that pullback's low. A
// down leg mirrors it. The leg turns when a body closes beyond the band's far edge, from the extreme
// it reached to the deepest point of the retracement that broke it.
float slPh = ta.pivothigh(high, swOteStr, swOteStr)
float slPl = ta.pivotlow(low, swOteStr, swOteStr)
var float slSwHi    = na
var float slSwLo    = na
var int   slSwHiBar = na
var int   slSwLoBar = na
if barstate.isconfirmed
    if not na(slPh)
        slSwHi    := slPh
        slSwHiBar := bar_index - swOteStr
    if not na(slPl)
        slSwLo    := slPl
        slSwLoBar := bar_index - swOteStr
var int   slDir    = 0
var float slOrgPx  = na
var int   slOrgBar = na
var float slEndPx  = na
var int   slEndBar = na
var float slPbPx   = na
var int   slPbBar  = na
float slFar = math.max(oteFrom, oteTo)
if barstate.isconfirmed
    if slDir == 0 and not na(slSwHiBar) and not na(slSwLoBar)
        slDir    := slSwHiBar > slSwLoBar ? 1 : -1
        slOrgPx  := slDir == 1 ? slSwLo : slSwHi
        slOrgBar := slDir == 1 ? slSwLoBar : slSwHiBar
        slEndPx  := slDir == 1 ? high : low
        slEndBar := bar_index
        int seedSpan = math.min(bar_index - slOrgBar, 500)
        if seedSpan > 0
            for i = 1 to seedSpan
                if slDir == 1 and high[i] > slEndPx
                    slEndPx  := high[i]
                    slEndBar := bar_index - i
                if slDir == -1 and low[i] < slEndPx
                    slEndPx  := low[i]
                    slEndBar := bar_index - i
        slPbPx  := slDir == 1 ? low : high
        slPbBar := bar_index
        int pbSpan = math.min(bar_index - slEndBar, 500)
        if pbSpan > 0
            for i = 0 to pbSpan - 1
                if slDir == 1 and low[i] < slPbPx
                    slPbPx  := low[i]
                    slPbBar := bar_index - i
                if slDir == -1 and high[i] > slPbPx
                    slPbPx  := high[i]
                    slPbBar := bar_index - i
    else if slDir == 1
        if high > slEndPx
            if not na(slSwLoBar) and slSwLoBar > slEndBar and not na(slPbPx)
                slOrgPx  := slPbPx
                slOrgBar := slPbBar
            slEndPx  := high
            slEndBar := bar_index
            slPbPx   := low
            slPbBar  := bar_index
        else if na(slPbPx) or low < slPbPx
            slPbPx  := low
            slPbBar := bar_index
        if slEndPx > slOrgPx and close < slEndPx - slFar * (slEndPx - slOrgPx)
            slDir    := -1
            slOrgPx  := slEndPx
            slOrgBar := slEndBar
            slEndPx  := slPbPx
            slEndBar := slPbBar
            slPbPx   := na
            slPbBar  := na
            int turnSpan = math.min(bar_index - slEndBar, 500)
            if turnSpan > 0
                for i = 0 to turnSpan - 1
                    if na(slPbPx) or high[i] > slPbPx
                        slPbPx  := high[i]
                        slPbBar := bar_index - i
    else if slDir == -1
        if low < slEndPx
            if not na(slSwHiBar) and slSwHiBar > slEndBar and not na(slPbPx)
                slOrgPx  := slPbPx
                slOrgBar := slPbBar
            slEndPx  := low
            slEndBar := bar_index
            slPbPx   := high
            slPbBar  := bar_index
        else if na(slPbPx) or high > slPbPx
            slPbPx  := high
            slPbBar := bar_index
        if slOrgPx > slEndPx and close > slEndPx + slFar * (slOrgPx - slEndPx)
            slDir    := 1
            slOrgPx  := slEndPx
            slOrgBar := slEndBar
            slEndPx  := slPbPx
            slEndBar := slPbBar
            slPbPx   := na
            slPbBar  := na
            int turnSpan = math.min(bar_index - slEndBar, 500)
            if turnSpan > 0
                for i = 0 to turnSpan - 1
                    if na(slPbPx) or low[i] < slPbPx
                        slPbPx  := low[i]
                        slPbBar := bar_index - i

var box   slBx  = na
var label slLbl = na
var line  slLn  = na
if barstate.islast
    box.delete(slBx)
    label.delete(slLbl)
    line.delete(slLn)
    slBx  := na
    slLbl := na
    slLn  := na
    bool noLive = bull.state != 3 and bear.state != 3
    bool inReach = not na(slOrgBar) and not na(slEndBar) and bar_index - math.min(slOrgBar, slEndBar) < 9900
    if swOteOn and noLive and slDir != 0 and inReach and not na(slOrgPx) and not na(slEndPx) and slOrgPx != slEndPx
        float rng = math.abs(slEndPx - slOrgPx)
        float e1  = slEndPx - slDir * oteFrom * rng
        float e2  = slEndPx - slDir * oteTo * rng
        float top = math.max(e1, e2)
        float bot = math.min(e1, e2)
        int   x1  = math.max(slOrgBar, slEndBar)
        int   x2  = bar_index + 2
        color f   = color.new(oteCol, bandFill)
        slBx  := box.new(x1, top, x2, bot, xloc = xloc.bar_index, border_color = f, border_width = 1, border_style = line.style_solid, bgcolor = f)
        slLbl := label.new(int(math.avg(x1, x2)), math.avg(top, bot), 'OTE', xloc = xloc.bar_index, style = label.style_label_center, color = C_NONE,
            textcolor = C_INK, size = LBL_SZ, text_formatting = text.format_bold)
        label.set_text_font_family(slLbl, font.family_monospace)
        slLn  := line.new(slOrgBar, slOrgPx, slEndBar, slEndPx, xloc = xloc.bar_index, color = C_GRAY, width = 1, style = line.style_dotted)

// ============================================================================
// BETWEEN SETUPS — arrays, swing structure, one name per price
// ============================================================================
//@variable The drawings of the arrays between setups and the swing tags, rebuilt on the last bar.
var array<box>   ambBx  = array.new<box>()
var array<label> ambLb  = array.new<label>()
var array<line>  ambLn  = array.new<line>()
var array<label> swTags = array.new<label>()

//@function Whether a setup on the chart already counts and draws this imbalance.
//@param z (Zone) The imbalance
//@param zd (int) The store's direction
//@param inverted (bool) True when the gap is being read as an IFVG the other way
//@returns (bool)
f_zoneOwned(Zone z, int zd, bool inverted) =>
    bool r = false
    int n = hist.size()
    if n > 0
        for i = 0 to n - 1
            Setup s = hist.get(i)
            if s.state == 3 or s.state == 4
                bool ifvgHit = inverted and s.dir == -zd and s.hasIfvg and s.ifvgTop == z.top and s.ifvgBot == z.bot
                bool fvgHit  = not inverted and s.dir == zd and z.kind == 0 and s.hasFvg and s.fvgBi == z.bi
                bool viHit   = not inverted and s.dir == zd and z.kind == 1 and s.hasVi and s.viBi == z.bi
                bool sbHit   = not inverted and s.dir == zd and z.kind == 2 and s.hasSb and s.sbBi == z.bi
                if ifvgHit or fvgHit or viHit or sbHit
                    r := true
    r

//@function Whether a setup on the chart already draws this breaker.
//@param k (Block) The block
//@returns (bool)
f_blockOwned(Block k) =>
    bool r = false
    int n = hist.size()
    if n > 0
        for i = 0 to n - 1
            Setup s = hist.get(i)
            if (s.state == 3 or s.state == 4) and s.dir == -k.dir and s.hasBrk and s.brkTm == k.tm
                r := true
    r

//@function The absorption a setup applies, applied to the arrays between setups: a suspension block
//          takes the gap and imbalance of its own triplet, a gap takes the imbalance on its seams.
//@param store (array<Zone>) The zone's own store
//@param z (Zone) The zone
//@returns (bool) True when a live neighbour absorbs it
f_absorbed(array<Zone> store, Zone z) =>
    bool r = false
    int n = store.size()
    if z.kind != 2 and n > 0
        for i = 0 to n - 1
            Zone o = store.get(i)
            if not o.mit
                if o.kind == 2 and (o.bi == z.bi + 1 or (z.kind == 1 and o.bi == z.bi))
                    r := true
                if z.kind == 1 and o.kind == 0 and (o.bi == z.bi or o.bi == z.bi - 1)
                    r := true
    r

//@function Distance from the close to a zone, zero inside it.
//@param top (float) Top
//@param bot (float) Bottom
//@returns (float)
f_dist(float top, float bot) =>
    close > top ? close - top : close < bot ? bot - close : 0.0

int ambGapFill   = 100 - math.round(gapOpac * 0.5)
int ambBlockFill = 100 - math.round(blockOpac * 0.5)
int ambIfvgFill  = isDark ? 100 - math.min(math.round(gapOpac * 0.8), 100) : ambGapFill

//@variable Price bands already carrying an array on the chart, and the time each begins.
var array<float> occTop  = array.new<float>()
var array<float> occBot  = array.new<float>()
var array<int>   occLeft = array.new<int>()

//@function Records a band as covered.
//@param top (float) Top
//@param bot (float) Bottom
//@param left (int) Origin time
//@returns (bool) Always true
f_occAdd(float top, float bot, int left) =>
    if not na(top) and not na(bot) and not na(left)
        occTop.push(top)
        occBot.push(bot)
        occLeft.push(left)
    true

//@function Records a drawn box as covered.
//@param b (box) The box, or na
//@returns (bool) Always true
f_occBox(box b) =>
    if not na(b)
        f_occAdd(box.get_top(b), box.get_bottom(b), box.get_left(b))
    true

//@function Whether a band overlaps one already covered.
//@param top (float) Top
//@param bot (float) Bottom
//@returns (bool)
f_occOverlaps(float top, float bot) =>
    bool r = false
    int n = occTop.size()
    if n > 0
        for i = 0 to n - 1
            if top > occBot.get(i) and bot < occTop.get(i)
                r := true
    r

if barstate.islast
    occTop.clear()
    occBot.clear()
    occLeft.clear()
    // Price already covered by a setup's own arrays. Stacked fills add up to a solid wall, so an
    // array between setups never paints over one already drawn.
    int nhOcc = hist.size()
    if nhOcc > 0
        for i = 0 to nhOcc - 1
            Setup s = hist.get(i)
            if s.state == 3 or s.state == 4
                f_occBox(s.fvgBx)
                f_occBox(s.viBx)
                f_occBox(s.sbBx)
                f_occBox(s.ifvgBx)
                f_occBox(s.brkBx)
                if not na(s.brkP)
                    f_occAdd(s.brkTop, s.brkBot, s.brkTm)
    while ambBx.size() > 0
        box.delete(ambBx.pop())
    while ambLb.size() > 0
        label.delete(ambLb.pop())
    while ambLn.size() > 0
        line.delete(ambLn.pop())
    if ambOn
        float maxD = atr * ambMaxAtr
        // Candidates in parallel arrays. kind: 0 gap · 1 VI · 2 SB · 3 IFVG · 4 breaker.
        array<float>  cTop  = array.new<float>()
        array<float>  cBot  = array.new<float>()
        array<int>    cTm   = array.new<int>()
        array<int>    cDir  = array.new<int>()
        array<int>    cKind = array.new<int>()
        array<float>  cDst  = array.new<float>()
        for pass = 0 to 1
            array<Zone> store = pass == 0 ? bullZ : bearZ
            int zd = pass == 0 ? 1 : -1
            int n = store.size()
            if n > 0
                for i = 0 to n - 1
                    Zone z = store.get(i)
                    float dz = f_dist(z.top, z.bot)
                    bool kindOn = z.kind == 0 ? showFvg : z.kind == 1 ? showVi : showSb
                    if not z.mit and kindOn and dz <= maxD and not f_absorbed(store, z) and not f_zoneOwned(z, zd, false)
                        cTop.push(z.top)
                        cBot.push(z.bot)
                        cTm.push(z.tm)
                        cDir.push(zd)
                        cKind.push(z.kind)
                        cDst.push(dz)
                    if z.mit and not z.dead and z.kind == 0 and showIfvg and dz <= maxD and not f_zoneOwned(z, zd, true)
                        cTop.push(z.top)
                        cBot.push(z.bot)
                        cTm.push(z.tm)
                        cDir.push(-zd)
                        cKind.push(3)
                        cDst.push(dz)
        if showBrk and blocks.size() > 0
            for i = 0 to blocks.size() - 1
                Block k = blocks.get(i)
                float dk = f_dist(k.top, k.bot)
                if k.flipped and not k.dead and dk <= maxD and not f_blockOwned(k)
                    cTop.push(k.top)
                    cBot.push(k.bot)
                    cTm.push(k.tm)
                    cDir.push(-k.dir)
                    cKind.push(4)
                    cDst.push(dk)
        int nC = cDst.size()
        if nC > 0
            array<int> ord = cDst.sort_indices(order.ascending)
            int shownBull = 0
            int shownBear = 0
            int zEnd = time + 2 * msPerBar
            int lEnd = time + runwayBars * msPerBar
            for q = 0 to nC - 1
                int  i    = ord.get(q)
                int  dd   = cDir.get(i)
                bool room = dd > 0 ? shownBull < ambMax : shownBear < ambMax
                if room and not f_occOverlaps(cTop.get(i), cBot.get(i))
                    f_occAdd(cTop.get(i), cBot.get(i), cTm.get(i))
                    if dd > 0
                        shownBull += 1
                    else
                        shownBear += 1
                    int   kd   = cKind.get(i)
                    float top  = cTop.get(i)
                    float bot  = cBot.get(i)
                    int   x1   = cTm.get(i)
                    float mid  = math.avg(top, bot)
                    color base = kd == 3 ? invCol : dd > 0 ? C_BULL : C_BEAR
                    string cap = f_arrTag(kd, dd)
                    if kd == 4 and brkMode == 'Levels'
                        float prox = dd > 0 ? top : bot
                        float dist = dd > 0 ? bot : top
                        ambLn.push(f_level(x1, lEnd, prox, color.new(base, 50), 1, line.style_solid))
                        ambLn.push(f_level(x1, lEnd, dist, color.new(base, 50), 1, line.style_dotted))
                        ambLn.push(f_level(x1, lEnd, mid, C_GRAY, 1, line.style_dotted))
                        ambLb.push(f_lbl(lEnd, prox, cap, label.style_label_left))
                    else
                        bool isBlock = kd == 2 or kd == 4
                        [b, l] = f_zone(x1, top, zEnd, bot, base, isBlock ? ambBlockFill : kd == 3 ? ambIfvgFill : ambGapFill, false, cap)
                        // A block is a candle, so its edges show — at half strength, lighter than a setup's.
                        if isBlock
                            box.set_border_color(b, color.new(base, 50))
                        ambBx.push(b)
                        ambLb.push(l)
                        if showCe and kd != 1 and kd != 4
                            ambLn.push(f_level(x1, zEnd, mid, C_GRAY, 1, line.style_dotted))

// ── One name per price: when setups share a level, the newest carries the name ──
if barstate.islast
    // Every setup that can hold a name, oldest first; a swept setup has not joined the history yet.
    array<Setup> named = hist.copy()
    if bull.state == 2
        named.push(bull)
    if bear.state == 2
        named.push(bear)
    int nn = named.size()
    if nn > 0
        for i = 0 to nn - 1
            Setup s = named.get(i)
            bool liqDup = false
            bool mssDup = false
            if i < nn - 1
                for j = i + 1 to nn - 1
                    Setup o = named.get(j)
                    if o.dir == s.dir
                        if not na(o.liqLbl) and o.liqTm == s.liqTm
                            liqDup := true
                        if not na(o.mssLbl) and o.mssRefTm == s.mssRefTm
                            mssDup := true
            if not na(s.liqLbl)
                label.set_text(s.liqLbl, liqDup ? '' : (s.dir > 0 ? 'SSL' : 'BSL') + ' · ERL')
            if not na(s.mssLbl)
                label.set_text(s.mssLbl, mssDup ? '' : 'MSS')

// ── Swing structure: the chart swings the MSS is read from, tagged at the candle that made them ──
if barstate.islast
    while swTags.size() > 0
        label.delete(swTags.pop())
    if showSwings
        // A candle already carrying a setup's name (the MSS, the sweep, the swept level, the draw) is
        // not tagged again.
        array<int> busy = array.new<int>()
        int nh = hist.size()
        if nh > 0
            for i = 0 to nh - 1
                Setup s = hist.get(i)
                busy.push(nz(s.mssRefTm))
                busy.push(nz(s.sweepTm))
                busy.push(nz(s.liqTm))
                busy.push(nz(s.tgtTm))
        for sd = 0 to 1
            Setup s = sd == 0 ? bull : bear
            if s.state >= 2
                busy.push(nz(s.mssRefTm))
                busy.push(nz(s.sweepTm))
                busy.push(nz(s.liqTm))
        for side = 0 to 1
            array<Swing> sw = side == 0 ? cHi : cLo
            int n = sw.size()
            if n > 1
                int startI = math.max(1, n - swingMax)
                for i = startI to n - 1
                    Swing x = sw.get(i)
                    Swing p = sw.get(i - 1)
                    // A swing sitting inside a drawn array reads over that array's caption; the
                    // array is the thing being read there, so the tag gives way.
                    bool inArray = false
                    int no = occTop.size()
                    if no > 0
                        for o = 0 to no - 1
                            if x.px <= occTop.get(o) and x.px >= occBot.get(o) and x.tm >= occLeft.get(o)
                                inArray := true
                    if not busy.includes(x.tm) and not inArray
                        string t = side == 0 ? (x.px > p.px ? 'HH' : x.px < p.px ? 'LH' : 'EH') : (x.px > p.px ? 'HL' : x.px < p.px ? 'LL' : 'EL')
                        swTags.push(f_lbl(x.tm, x.px, t, side == 0 ? label.style_label_down : label.style_label_up))

if showThirds and barstate.islast
    Setup f = f_focus()
    float lo = math.min(f.liq, f.tgt)
    float hi = math.max(f.liq, f.tgt)
    if not na(lo) and not na(hi)
        int   x1 = math.max(f.liqTm, f.tgtTm)
        int   x2 = time + runwayBars * msPerBar
        float t1 = lo + (hi - lo) / 3
        float t2 = lo + 2 * (hi - lo) / 3
        if na(thirdLo)
            thirdLo    := f_level(x1, x2, t1, C_GRAY, 1, line.style_dotted)
            thirdHi    := f_level(x1, x2, t2, C_GRAY, 1, line.style_dotted)
            // Splayed apart: the lower third's name sits below its line, the upper third's above,
            // so neither crosses its own line and the two never meet in the middle.
            thirdLoLbl := f_lbl(x2, t1, '1/3', label.style_label_left)
            thirdHiLbl := f_lbl(x2, t2, '2/3', label.style_label_left)
        else
            line.set_xy1(thirdLo, x1, t1)
            line.set_xy2(thirdLo, x2, t1)
            line.set_xy1(thirdHi, x1, t2)
            line.set_xy2(thirdHi, x2, t2)
            label.set_xy(thirdLoLbl, x2, t1)
            label.set_xy(thirdHiLbl, x2, t2)

// ============================================================================
// CONSOLE — verdict first, silent rows dropped
// ============================================================================
//@function Resolves the console position input.
//@param p (string) The input value
//@returns (string) A position.* constant
f_pos(string p) =>
    switch p
        'Top left'     => position.top_left
        'Bottom right' => position.bottom_right
        'Bottom left'  => position.bottom_left
        =>                position.top_right

// The house table: one title bar across both columns, then a framed grid of name | value rows.
var table con   = na
var int   conN  = 0
const color CON_HEAD = color.new(#cd82ff, 49)
//@variable This bar's console rows, filled on the last bar and written in one pass.
var array<string> conName = array.new<string>()
var array<string> conVal  = array.new<string>()
var array<string> conTip  = array.new<string>()

//@function Queues one console row.
//@param name (string) The name, left
//@param val (string) The value, right
//@param tip (string) Hover text for the row, empty for none
//@returns (bool) Always true
f_row(string name, string val, string tip = '') =>
    conName.push(name)
    conVal.push(val)
    conTip.push(tip)
    true

//@function One peer's state on the target side, as console text.
//@param taken (int) The taken time, or na
//@returns (string)
f_peerWord(int taken) =>
    na(taken) ? 'lags' : 'taken'

//@function The most recent finished setup in the history store, or na.
//@returns (Setup)
f_lastDone() =>
    Setup r = na
    int n = hist.size()
    if n > 0
        for i = 0 to n - 1
            Setup h = hist.get(i)
            if h.state == 4 and (na(r) or h.mssBi > r.mssBi)
                r := h
    r

//@function A price as text at the symbol's tick.
//@param p (float) The price
//@returns (string)
f_px(float p) =>
    str.tostring(p, format.mintick)

//@function Formats a millisecond span as a countdown.
//@param ms (int) Milliseconds remaining
//@returns (string) hh:mm:ss, prefixed with days when over a day
f_countdown(int ms) =>
    int totalSec = math.max(math.floor(ms / 1000), 0)
    int days = math.floor(totalSec / 86400)
    int hrs  = math.floor((totalSec % 86400) / 3600)
    int mins = math.floor((totalSec % 3600) / 60)
    int secs = totalSec % 60
    string hhmmss = str.format('{0,number,00}:{1,number,00}:{2,number,00}', hrs, mins, secs)
    days > 0 ? str.tostring(days) + 'd ' + hhmmss : hhmmss

// ============================================================================
// PO3 CANDLE — the live range-timeframe candle beside price, as PO3 Candle (M1D) draws it
// ============================================================================
// Rebuilt in place on every tick of the last bar, never left as history. Candle-body colours
// (white up, dark down, black outline) — it is a literal candle, not a directional array.
var box   po3Body   = na
var line  po3WickUp = na
var line  po3WickDn = na
var line  po3LvlO   = na
var line  po3LvlH   = na
var line  po3LvlL   = na
var line  po3LvlC   = na
var line  po3Div    = na
var label po3TagO   = na
var label po3TagH   = na
var label po3TagL   = na
var label po3TagC   = na
bool po3Valid = showPo3 and not sameTf

//@function Creates a dotted reference line once, then moves it; removes it when not shown.
//@param existing (line) The stored handle, na on first call
//@param x1 (int) Left bar index
//@param x2 (int) Right bar index
//@param price (float) The level
//@param show (bool) Whether the line should exist
//@returns (line) The live handle, or na
f_po3Level(line existing, int x1, int x2, float price, bool show) =>
    line h = existing
    if not show
        line.delete(h)
        h := na
    else if na(h)
        h := line.new(x1, price, x2, price, xloc = xloc.bar_index, color = po3Edge, width = 1, style = line.style_dotted)
    else
        line.set_xy1(h, x1, price)
        line.set_xy2(h, x2, price)
    h

//@function Creates a price tag once, then moves it; removes it when not shown.
//@param existing (label) The stored handle, na on first call
//@param x (int) Anchor bar index
//@param price (float) The level
//@param show (bool) Whether the tag should exist
//@returns (label) The live handle, or na
f_po3Tag(label existing, int x, float price, bool show) =>
    label h = existing
    if not show
        label.delete(h)
        h := na
    else if na(h)
        h := label.new(x, price, f_px(price), xloc = xloc.bar_index, style = label.style_label_lower_left, color = C_NONE,
            textcolor = C_INK, size = LBL_SZ, textalign = text.align_left)
        label.set_text_font_family(h, font.family_monospace)
    else
        label.set_xy(h, x, price)
        label.set_text(h, f_px(price))
    h

// The candle's live values. On the bar that opens a new range candle the aggregates still hold the
// previous one until that bar confirms, so the bar's own values are used instead.
float po3O  = newCandle ? open : curO
float po3H  = newCandle ? high : math.max(curH, high)
float po3L  = newCandle ? low  : math.min(curL, low)
float po3C  = close
int   po3Ct = newCandle ? htfT : curCt
int   po3Bi = newCandle ? bar_index : curOBi

// A PO3 price sitting on a live ERL is ONE level: the ERL label carries the candle's name for it
// and the candle's own tag and line are dropped, so nothing stacks on the line or gets clipped.
bool po3MergeO = false
bool po3MergeH = false
bool po3MergeL = false
bool po3MergeC = false
// One name per draw: setups of one direction whose draws end at the same price and the same spot
// (both still running to price, or taken on the same candle) share ONE label. The newest carries it,
// with the live setup's grade when one is live, otherwise the best grade among them; the rest go blank.
if barstate.islast and hist.size() > 0
    float tol = syminfo.mintick
    int nHist = hist.size()
    for i = 0 to nHist - 1
        Setup hs = hist.get(i)
        if (hs.state == 3 or hs.state == 4) and not na(hs.tgtLbl)
            bool hsRun  = hs.state == 3 or hs.outcome == 'retired'
            bool shared = false
            int  best   = hs.grade
            int  liveG  = hs.state == 3 ? hs.grade : -1
            for j = 0 to nHist - 1
                if j != i
                    Setup o = hist.get(j)
                    if (o.state == 3 or o.state == 4) and not na(o.tgtLbl) and o.dir == hs.dir and math.abs(o.tgt - hs.tgt) <= tol
                        bool oRun = o.state == 3 or o.outcome == 'retired'
                        if (hsRun and oRun) or (not hsRun and not oRun and label.get_x(o.tgtLbl) == label.get_x(hs.tgtLbl))
                            if j > i
                                shared := true
                            else
                                best := math.max(best, o.grade)
                                if o.state == 3
                                    liveG := math.max(liveG, o.grade)
            if shared
                label.set_text(hs.tgtLbl, '')
                continue
            string extra = ''
            if po3Valid
                if math.abs(po3O - hs.tgt) <= tol
                    extra += ' · ' + RTF_NAME + ' open'
                    po3MergeO := true
                if math.abs(po3H - hs.tgt) <= tol
                    extra += ' · ' + RTF_NAME + ' high'
                    po3MergeH := true
                if math.abs(po3L - hs.tgt) <= tol
                    extra += ' · ' + RTF_NAME + ' low'
                    po3MergeL := true
                if math.abs(po3C - hs.tgt) <= tol
                    extra += ' · ' + RTF_NAME + ' close'
                    po3MergeC := true
            label.set_text(hs.tgtLbl, (hs.dir > 0 ? 'BSL' : 'SSL') + ' · ERL · ' + TF_NAME + ' ' + f_gradeText(liveG >= 0 ? liveG : best) + extra)

if barstate.islast and po3Valid
    // Bar-index coordinates throughout. In future TIME a weekend or the daily halt has no bar slot, so a
    // candle placed across one collapses onto a single slot — on a 4H or 1H chart it drew as a flat
    // outline with no body. Bars count the slots the chart actually shows.
    int   leftX   = bar_index + runwayBars + po3Gap
    int   rightX  = leftX + po3Wide
    int   midX    = leftX + int(math.floor(po3Wide / 2.0))
    int   openX   = math.max(po3Bi, bar_index - 9000)
    bool  isUp    = po3C >= po3O
    color bodyCol = isUp ? po3Up : po3Dn
    float bodyTop = math.max(po3O, po3C)
    float bodyBot = math.min(po3O, po3C)
    if bodyTop - bodyBot < syminfo.mintick
        // A doji still gets a body one tick tall, so the candle never collapses to a line.
        bodyTop := bodyBot + syminfo.mintick
    // Body — a candle IS a block, so it shows a hard edge; the fill says direction.
    if na(po3Body)
        po3Body := box.new(leftX, bodyTop, rightX, bodyBot, xloc = xloc.bar_index, border_color = po3Edge, border_width = 1, bgcolor = bodyCol)
    else
        box.set_lefttop(po3Body, leftX, bodyTop)
        box.set_rightbottom(po3Body, rightX, bodyBot)
        box.set_bgcolor(po3Body, bodyCol)
    // Wicks — from the body to each extreme, up the centre of the body.
    if na(po3WickUp)
        po3WickUp := line.new(midX, bodyTop, midX, po3H, xloc = xloc.bar_index, color = po3Edge, width = 1)
        po3WickDn := line.new(midX, bodyBot, midX, po3L, xloc = xloc.bar_index, color = po3Edge, width = 1)
    else
        line.set_xy1(po3WickUp, midX, bodyTop)
        line.set_xy2(po3WickUp, midX, po3H)
        line.set_xy1(po3WickDn, midX, bodyBot)
        line.set_xy2(po3WickDn, midX, po3L)
    // Reference lines — each price carried back to the bar that opened the candle. The close is
    // the live price, so its line runs only from the live candle to the drawn one.
    po3LvlO := f_po3Level(po3LvlO, openX,     leftX, po3O, po3Levels and not po3MergeO)
    po3LvlH := f_po3Level(po3LvlH, openX,     midX,  po3H, po3Levels and not po3MergeH)
    po3LvlL := f_po3Level(po3LvlL, openX,     midX,  po3L, po3Levels and not po3MergeL)
    po3LvlC := f_po3Level(po3LvlC, bar_index, leftX, po3C, po3Levels and not po3MergeC)
    // Open divider — the left wall of the candle's zone.
    if po3Divider
        if na(po3Div)
            po3Div := line.new(po3Ct, po3H, po3Ct, po3L, xloc = xloc.bar_time, color = po3Edge, width = 1, style = line.style_dotted, extend = po3FullDiv ? extend.both : extend.none)
        else
            line.set_xy1(po3Div, po3Ct, po3H)
            line.set_xy2(po3Div, po3Ct, po3L)
    // Price tags at the candle's right edge.
    po3TagO := f_po3Tag(po3TagO, rightX, po3O, po3Tags and not po3MergeO)
    po3TagH := f_po3Tag(po3TagH, rightX, po3H, po3Tags and not po3MergeH)
    po3TagL := f_po3Tag(po3TagL, rightX, po3L, po3Tags and not po3MergeL)
    po3TagC := f_po3Tag(po3TagC, rightX, po3C, po3Tags and not po3MergeC)

if not showConsole and not na(con)
    table.delete(con)
    con  := na
    conN := 0

if showConsole and barstate.islast
    conName.clear()
    conVal.clear()
    conTip.clear()
    Setup f = f_focus()
    float rLo = math.min(f.liq, f.tgt)
    float rHi = math.max(f.liq, f.tgt)
    string pos = f_position(rLo, rHi)
    string dirWord = f.dir > 0 ? 'Long' : 'Short'
    // ── The setup on this chart — verdict, range, draw, sequence ──
    if f.state == 3
        f_row('Setup · ' + TF_NAME, dirWord + ' · ' + f_gradeText(f.grade))
    else if f.state == 2
        f_row('Setup · ' + TF_NAME, dirWord + (f.waitDisp ? ' · swept, no displacement' : ' · swept, no MSS'))
    else
        f_row('Setup · ' + TF_NAME, f.state == 1 ? 'Armed' : 'No range')
    if not na(rLo) and not na(rHi)
        f_row('Range ' + RTF_NAME, f_px(rLo) + '–' + f_px(rHi) + ' · ' + pos)
        if f.state >= 2
            if f.state == 3
                if f.rrQualified
                    f_row('RR ref', f.rrSource + ' ' + f_px(f.rrReferencePrice) + ' · ' + str.tostring(f.setupRR, '#.0') + 'R ✓')
                else
                    [candidateSource, candidateReferencePrice, candidateRR] = f_resolveRR(f)
                    if candidateSource != '' and not na(candidateReferencePrice) and not na(candidateRR)
                        f_row('RR candidate', candidateSource + ' ' + f_px(candidateReferencePrice) + ' · ' + str.tostring(candidateRR, '#.0') + 'R')
            f_row('Draw', (f.dir > 0 ? 'BSL ' : 'SSL ') + f_px(f.tgt) + ' · ' + f_px(math.abs(f.tgt - close)) + ' away')
        else
            f_row('Draw', 'BSL +' + f_px(rHi - close) + ' · SSL −' + f_px(close - rLo))
    if f.state >= 2
        f_row('Sweep · MSS · OTE', '✓ · ' + (f.state == 3 ? '✓' : '·') + ' · ' + (f.hasOte ? '✓' : '·'))
    if entryOn and f.state == 3
        string currentGrade = f_entryGrade(f)
        string gradeGate = entryMinGrade == 'Off' ? 'Off ✓' : (currentGrade == '' ? 'none / ' + entryMinGrade + ' ·' : currentGrade + ' / ' + entryMinGrade + (f_entryGradeOk(f) ? ' ✓' : ' ·'))
        string oteGate = not entryRequireOte ? 'optional' : not f.hasOte ? 'endpoint pending' : not f.oteLive ? 'invalidated' : f.entryTouchedAt == time ? 'confirmed · touched now' : 'confirmed · waiting touch'
        f_row('Entry gates', (f.rrQualified ? 'RR ✓ · ' : 'RR · ') + 'grade ' + gradeGate)
        f_row('Entry OTE', oteGate)
        string entryWord = switch f.entryState
            1 => 'E' + str.tostring(f.entryAttempt) + ' TOUCHED · ' + f.entrySource
            2 => 'E' + str.tostring(f.entryAttempt) + ' CONFIRMED · ' + f.entrySource
            3 => 'E' + str.tostring(f.entryAttempt) + ' INVALIDATED'
            4 => 'E' + str.tostring(f.entryAttempt) + ' STOPPED'
            5 => 'E' + str.tostring(f.entryAttempt) + ' TARGET TAKEN'
            6 => 'E' + str.tostring(f.entryAttempt) + ' AMBIGUOUS'
            => 'NONE · waiting eligibility/touch'
        f_row('Entry state', entryWord)
        if f.entryState >= 2 and not na(f.entryPrice)
            f_row('Entry · stop', f_px(f.entryPrice) + ' · ' + f_px(f.entryStop))
            f_row('Entry target · R', f_px(f.tgt) + ' · ' + str.tostring(f.entryRR, '#.00') + 'R')
    // ── The peers, then context — draw check, peers, catch-up, last, range candle ──
    if f.xcSet
        bool p1Took = not na(f.p1TgtTaken)
        bool p2Took = not na(f.p2TgtTaken)
        string verdict = f.selfTgtTaken and p1Took and p2Took ? 'Taken · all three' :not f.selfTgtTaken and (p1Took or p2Took) ? 'Laggard ' + selfName + ' · trade' :f.selfTgtTaken and not (p1Took and p2Took) ? 'Peer lags ' + (p1Took ? peer2Name : peer1Name) :'Open draw'
        string smtTxt = ''
        if f.state >= 2 and (na(f.p1LiqTaken) or na(f.p2LiqTaken))
            smtTxt := ' · SMT ' + (na(f.p1LiqTaken) ? peer1Name : peer2Name)
        f_row('Draw check', verdict)
        f_row(peer1Name + ' · ' + peer2Name, f_peerWord(f.p1TgtTaken) + ' · ' + f_peerWord(f.p2TgtTaken) + smtTxt)
        if f_isLaggard(f)
            f_row('Catch-up gap ' + GTF_NAME, f.catchUp ? '✓' : '·')
    Setup last = f_lastDone()
    if not na(last) and last.state == 4 and f.state != 3
        f_row('Last', (last.dir > 0 ? 'Long' : 'Short') + ' · ' + f_gradeText(last.grade) + ' · ' + last.outcome,
            'The most recent setup that has ended.\nTarget taken: a close reached the draw.\nRetired: the retire time in Setup passed after the MSS with the draw still untaken. The setup did not fail; its arrays stay drawn and the draw keeps running to price until a close takes it.\nA setup that closes back through its sweep extreme fails and is removed from the chart, so it never shows here.')
    if po3Valid
        f_row(RTF_NAME + ' candle', f_countdown(time_close(rangeTf) - timenow) + ' · ' + f_px(po3H - po3L) + ' range')
    // ── Write: rebuilt only when the row count changes, so the title merge stays intact ──
    int n = conName.size()
    if na(con) or n != conN
        if not na(con)
            table.delete(con)
        con  := table.new(f_pos(conPos), 2, n + 1, bgcolor = #FFFFFF, frame_color = #000000, frame_width = 1, border_color = #000000, border_width = 1)
        conN := n
        table.cell(con, 0, 0, ' POLR · ERL x IRL ', text_color = #000000, text_size = LBL_SZ, text_halign = text.align_center,
            text_font_family = font.family_monospace, bgcolor = CON_HEAD, text_formatting = text.format_bold)
        table.merge_cells(con, 0, 0, 1, 0)
    if n > 0
        for i = 0 to n - 1
            table.cell(con, 0, i + 1, conName.get(i), text_color = #000000, text_size = LBL_SZ, text_halign = text.align_left,
                text_font_family = font.family_monospace, bgcolor = #FFFFFF, text_formatting = text.format_italic, tooltip = conTip.get(i))
            table.cell(con, 1, i + 1, conVal.get(i), text_color = #000000, text_size = LBL_SZ, text_halign = text.align_right,
                text_font_family = font.family_monospace, bgcolor = #FFFFFF, text_formatting = text.format_bold, tooltip = conTip.get(i))

// ============================================================================
// ALERTS — script scope, confirmed closes only
// ============================================================================
string canonicalLifecycleTickerId = ticker.standard(syminfo.tickerid)

f_lifecycleSetupId(int dir, int mssAt) =>
    string direction = dir > 0 ? 'LONG' : 'SHORT'
    canonicalLifecycleTickerId + '-' + direction + '-' + str.tostring(mssAt)

f_lifecycleEventId(string eventType, int dir, int mssAt) =>
    f_lifecycleSetupId(dir, mssAt) + '-' + eventType

//@function Builds the canonical EDGE POLR lifecycle JSON for one setup transition.
//@param eventType (string) EDGE lifecycle event enum.
//@param dir (int) 1 for LONG, -1 for SHORT.
//@param mssAt (int) Original setup MSS timestamp in milliseconds.
//@param eventAt (int) Lifecycle transition timestamp in milliseconds.
//@param sweepPrice (float) Canonical setup sweep extreme.
//@param targetPrice (float) Canonical setup draw.
//@param grade (string) Canonical A/A+ grade, or empty before a grade exists.
//@param rrQualifiedAt (int) First canonical RR-qualified timestamp, or na.
//@param rrSource (string) Frozen canonical RR source, or empty before qualification.
//@param rrReferencePrice (float) Frozen canonical PD-array RR reference, or na before qualification.
//@param setupRR (float) Frozen canonical setup RR, or na before qualification.
//@param eventPrice (float) Market close on the event bar.
//@returns (string) JSON accepted by POST /api/polr/lifecycle.
f_lifecycleJson(string eventType, int dir, int mssAt, int eventAt, float sweepPrice, float targetPrice, string grade, int rrQualifiedAt, string rrSource, float rrReferencePrice, float setupRR, float eventPrice) =>
    string direction = dir > 0 ? 'LONG' : 'SHORT'
    string setupId = f_lifecycleSetupId(dir, mssAt)
    string targetSide = dir > 0 ? 'BSL' : 'SSL'
    bool isFailure = eventType == 'SETUP_FAILED'
    string messageSide = isFailure ? (dir > 0 ? 'SSL' : 'BSL') : targetSide
    float messagePrice = isFailure ? sweepPrice : targetPrice
    string eventLabel = switch eventType
        'MSS_CONFIRMED' => 'MSS CONFIRMED'
        'RR_QUALIFIED' => 'RR QUALIFIED'
        'GRADE_A' => 'GRADE A'
        'GRADE_A_PLUS' => 'GRADE A+'
        'SETUP_FAILED' => 'SETUP FAILED'
        'SETUP_RETIRED' => 'SETUP RETIRED'
        => 'TARGET TAKEN'
    bool showGrade = eventType == 'SETUP_FAILED' or eventType == 'SETUP_RETIRED' or eventType == 'TARGET_TAKEN'
    string gradeSuffix = showGrade and grade != '' ? ' · ' + grade : ''
    string message = eventType == 'RR_QUALIFIED' ? 'POLR · RR QUALIFIED · ' + syminfo.ticker + ' · ' + direction + ' · ' + rrSource + ' ' + f_px(rrReferencePrice) + ' · ' + str.tostring(setupRR, '#.0') + 'R · ' + targetSide + ' ' + f_px(targetPrice) : 'POLR · ' + eventLabel + ' · ' + syminfo.ticker + ' · ' + direction + ' · ' + messageSide + ' ' + f_px(messagePrice) + gradeSuffix
    string gradeJson = grade == '' ? 'null' : '"' + grade + '"'
    string rrQualifiedAtJson = na(rrQualifiedAt) ? 'null' : str.tostring(rrQualifiedAt)
    string rrSourceJson = rrSource == '' ? 'null' : '"' + rrSource + '"'
    string rrReferencePriceJson = na(rrReferencePrice) ? 'null' : str.tostring(rrReferencePrice)
    string setupRRJson = na(setupRR) ? 'null' : str.tostring(setupRR)
    '{"schema_version":"1.0","event_id":"' + f_lifecycleEventId(eventType, dir, mssAt) + '","setup_id":"' + setupId + '","event_type":"' + eventType + '","symbol":"' + syminfo.ticker + '","direction":"' + direction + '","mss_at":' + str.tostring(mssAt) + ',"event_at":' + str.tostring(eventAt) + ',"sweep_price":' + str.tostring(sweepPrice) + ',"target_price":' + str.tostring(targetPrice) + ',"target_side":"' + targetSide + '","grade":' + gradeJson + ',"rr_qualified_at":' + rrQualifiedAtJson + ',"rr_source":' + rrSourceJson + ',"rr_reference_price":' + rrReferencePriceJson + ',"setup_rr":' + setupRRJson + ',"event_price":' + str.tostring(eventPrice) + ',"chart_timeframe":"' + timeframe.period + '","range_timeframe":"' + rangeTf + '","message":"' + message + '"}'

f_dispatchLifecycle(array<string> dispatchedEventIds, string eventType, int dir, int mssAt, int eventAt, float sweepPrice, float targetPrice, string grade, int rrQualifiedAt, string rrSource, float rrReferencePrice, float setupRR, float eventPrice) =>
    string eventId = f_lifecycleEventId(eventType, dir, mssAt)
    bool shouldDispatch = not dispatchedEventIds.includes(eventId)
    if shouldDispatch
        dispatchedEventIds.push(eventId)
        alert(f_lifecycleJson(eventType, dir, mssAt, eventAt, sweepPrice, targetPrice, grade, rrQualifiedAt, rrSource, rrReferencePrice, setupRR, eventPrice), alert.freq_all)
    shouldDispatch

f_entryId(EntryEvent e) =>
    f_lifecycleSetupId(e.dir, e.mssAt) + '-E' + str.tostring(e.attempt)

f_entryEventId(EntryEvent e) =>
    f_entryId(e) + '-' + e.eventType

f_jsonNumber(float value) =>
    na(value) ? 'null' : str.tostring(value)

f_jsonTime(int value) =>
    na(value) ? 'null' : str.tostring(value)

f_jsonString(string value) =>
    value == '' ? 'null' : '"' + value + '"'

//@function Builds schema 1.1 entry evidence. Setup RR stays the original frozen setup measure;
//          entry_rr is calculated separately from the confirmed close to the same draw.
f_entryLifecycleJson(EntryEvent e) =>
    string direction = e.dir > 0 ? 'LONG' : 'SHORT'
    string targetSide = e.dir > 0 ? 'BSL' : 'SSL'
    string setupId = f_lifecycleSetupId(e.dir, e.mssAt)
    string message = 'POLR · ' + str.replace_all(e.eventType, '_', ' ') + ' · ' + syminfo.ticker + ' · ' + direction + ' · E' + str.tostring(e.attempt)
    '{"schema_version":"1.1","event_id":"' + f_entryEventId(e) + '","setup_id":"' + setupId + '","event_type":"' + e.eventType + '","symbol":"' + syminfo.ticker + '","direction":"' + direction + '","mss_at":' + str.tostring(e.mssAt) + ',"event_at":' + str.tostring(e.eventAt) + ',"sweep_price":' + str.tostring(e.sweepPrice) + ',"target_price":' + str.tostring(e.targetPrice) + ',"target_side":"' + targetSide + '","grade":' + f_jsonString(e.grade) + ',"rr_qualified_at":' + f_jsonTime(e.rrQualifiedAt) + ',"rr_source":' + f_jsonString(e.rrSource) + ',"rr_reference_price":' + f_jsonNumber(e.rrReferencePrice) + ',"setup_rr":' + f_jsonNumber(e.setupRR) + ',"event_price":' + str.tostring(e.eventPrice) + ',"chart_timeframe":"' + timeframe.period + '","range_timeframe":"' + rangeTf + '","message":"' + message + '","entry_id":"' + f_entryId(e) + '","entry_attempt":' + str.tostring(e.attempt) + ',"entry_source":"' + e.source + '","confirmation_method":"' + e.confirmationMethod + '","entry_zone_top":' + str.tostring(e.zoneTop) + ',"entry_zone_bottom":' + str.tostring(e.zoneBottom) + ',"ote_top":' + f_jsonNumber(e.oteTop) + ',"ote_bottom":' + f_jsonNumber(e.oteBottom) + ',"ote_confirmed_at":' + f_jsonTime(e.oteConfirmedAt) + ',"range_low":' + str.tostring(e.rangeLow) + ',"range_high":' + str.tostring(e.rangeHigh) + ',"range_third":"' + e.rangeThird + '","ote_required":' + (entryRequireOte ? 'true' : 'false') + ',"minimum_grade":"' + e.minimumGrade + '","grade_at_touch":' + f_jsonString(e.gradeAtTouch) + ',"grade_at_confirmation":' + f_jsonString(e.gradeAtConfirmation) + ',"entry_touched_at":' + f_jsonTime(e.touchedAt) + ',"entry_confirmed_at":' + f_jsonTime(e.confirmedAt) + ',"entry_price":' + f_jsonNumber(e.entryPrice) + ',"stop_price":' + f_jsonNumber(e.stopPrice) + ',"entry_rr":' + f_jsonNumber(e.entryRR) + '}'

f_dispatchEntryLifecycle(array<string> dispatchedEventIds, EntryEvent e) =>
    string eventId = f_entryEventId(e)
    bool shouldDispatch = not dispatchedEventIds.includes(eventId)
    if shouldDispatch
        dispatchedEventIds.push(eventId)
        alert(f_entryLifecycleJson(e), alert.freq_all)
    shouldDispatch

// A confirmed realtime bar can be evaluated more than once. Keep dispatched IDs across those
// executions, while allowing every distinct lifecycle event on the bar through alert.freq_all.
varip int lifecycleDispatchBar = na
varip array<string> lifecycleDispatchedEventIds = array.new_string()
if na(lifecycleDispatchBar) or lifecycleDispatchBar != bar_index
    lifecycleDispatchBar := bar_index
    lifecycleDispatchedEventIds.clear()

bool alBullCu  = evBull.catchUp
bool alBearCu  = evBear.catchUp

if evBull.mss
    f_dispatchLifecycle(lifecycleDispatchedEventIds, 'MSS_CONFIRMED', bull.dir, bull.mssTm, bull.mssTm, bull.sweepPx, bull.tgt, bull.grade >= gradeAp ? 'A+' : bull.grade >= gradeA ? 'A' : '', na, '', na, na, close)
if evBear.mss
    f_dispatchLifecycle(lifecycleDispatchedEventIds, 'MSS_CONFIRMED', bear.dir, bear.mssTm, bear.mssTm, bear.sweepPx, bear.tgt, bear.grade >= gradeAp ? 'A+' : bear.grade >= gradeA ? 'A' : '', na, '', na, na, close)

if evBull.rrQualified
    f_dispatchLifecycle(lifecycleDispatchedEventIds, 'RR_QUALIFIED', evBull.rrQualifiedDir, evBull.rrQualifiedMssTime, evBull.rrQualifiedTime, evBull.rrQualifiedSweepPrice, evBull.rrQualifiedTargetPrice, evBull.rrQualifiedGrade, evBull.rrQualifiedTime, evBull.rrSource, evBull.rrReferencePrice, evBull.setupRR, close)
if evBear.rrQualified
    f_dispatchLifecycle(lifecycleDispatchedEventIds, 'RR_QUALIFIED', evBear.rrQualifiedDir, evBear.rrQualifiedMssTime, evBear.rrQualifiedTime, evBear.rrQualifiedSweepPrice, evBear.rrQualifiedTargetPrice, evBear.rrQualifiedGrade, evBear.rrQualifiedTime, evBear.rrSource, evBear.rrReferencePrice, evBear.setupRR, close)

if evBull.ap
    f_dispatchLifecycle(lifecycleDispatchedEventIds, 'GRADE_A_PLUS', bull.dir, bull.mssTm, time, bull.sweepPx, bull.tgt, 'A+', bull.rrQualifiedAt, bull.rrSource, bull.rrReferencePrice, bull.setupRR, close)
else if evBull.a
    f_dispatchLifecycle(lifecycleDispatchedEventIds, 'GRADE_A', bull.dir, bull.mssTm, time, bull.sweepPx, bull.tgt, 'A', bull.rrQualifiedAt, bull.rrSource, bull.rrReferencePrice, bull.setupRR, close)

if evBear.ap
    f_dispatchLifecycle(lifecycleDispatchedEventIds, 'GRADE_A_PLUS', bear.dir, bear.mssTm, time, bear.sweepPx, bear.tgt, 'A+', bear.rrQualifiedAt, bear.rrSource, bear.rrReferencePrice, bear.setupRR, close)
else if evBear.a
    f_dispatchLifecycle(lifecycleDispatchedEventIds, 'GRADE_A', bear.dir, bear.mssTm, time, bear.sweepPx, bear.tgt, 'A', bear.rrQualifiedAt, bear.rrSource, bear.rrReferencePrice, bear.setupRR, close)

if targetTakenEvents.size() > 0
    for i = 0 to targetTakenEvents.size() - 1
        Setup targetEvent = targetTakenEvents.get(i)
        string targetGrade = targetEvent.grade >= gradeAp ? 'A+' : targetEvent.grade >= gradeA ? 'A' : ''
        f_dispatchLifecycle(lifecycleDispatchedEventIds, 'TARGET_TAKEN', targetEvent.dir, targetEvent.mssTm, time, targetEvent.sweepPx, targetEvent.tgt, targetGrade, targetEvent.rrQualifiedAt, targetEvent.rrSource, targetEvent.rrReferencePrice, targetEvent.setupRR, close)

if evBull.failed
    f_dispatchLifecycle(lifecycleDispatchedEventIds, 'SETUP_FAILED', evBull.failedDir, evBull.failedMssTime, evBull.failedTime, evBull.failedSweepPrice, evBull.failedTargetPrice, evBull.failedGrade, evBull.failedRrQualifiedAt, evBull.failedRrSource, evBull.failedRrReferencePrice, evBull.failedSetupRR, close)
if evBear.failed
    f_dispatchLifecycle(lifecycleDispatchedEventIds, 'SETUP_FAILED', evBear.failedDir, evBear.failedMssTime, evBear.failedTime, evBear.failedSweepPrice, evBear.failedTargetPrice, evBear.failedGrade, evBear.failedRrQualifiedAt, evBear.failedRrSource, evBear.failedRrReferencePrice, evBear.failedSetupRR, close)

if evBull.retired
    f_dispatchLifecycle(lifecycleDispatchedEventIds, 'SETUP_RETIRED', evBull.retiredDir, evBull.retiredMssTime, evBull.retiredTime, evBull.retiredSweepPrice, evBull.retiredTargetPrice, evBull.retiredGrade, evBull.retiredRrQualifiedAt, evBull.retiredRrSource, evBull.retiredRrReferencePrice, evBull.retiredSetupRR, close)
if evBear.retired
    f_dispatchLifecycle(lifecycleDispatchedEventIds, 'SETUP_RETIRED', evBear.retiredDir, evBear.retiredMssTime, evBear.retiredTime, evBear.retiredSweepPrice, evBear.retiredTargetPrice, evBear.retiredGrade, evBear.retiredRrQualifiedAt, evBear.retiredRrSource, evBear.retiredRrReferencePrice, evBear.retiredSetupRR, close)

if entryEvents.size() > 0
    for i = 0 to entryEvents.size() - 1
        f_dispatchEntryLifecycle(lifecycleDispatchedEventIds, entryEvents.get(i))

alertcondition(alBullCu,  'Bullish catch-up gap',  'ERL x IRL PO3: {{ticker}} is the laggard, bullish catch-up gap printed')
alertcondition(alBearCu,  'Bearish catch-up gap',  'ERL x IRL PO3: {{ticker}} is the laggard, bearish catch-up gap printed')
