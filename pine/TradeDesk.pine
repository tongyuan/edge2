//@version=6
// TD_1.0 + External BSL/SSL Liquidity Context integration
// BSL/SSL is independent of MRZ proximal-evidence filtering; only factual breach alerts are emitted.
indicator("TD_1.0", overlay = true, max_boxes_count = 500, max_labels_count = 200, max_lines_count = 500, max_bars_back = 3000)

string GROUP_CONFIGURATION = "MRZ CONFIGURATION"
string GROUP_SLOT_A = "MRZ SLOT A"
string GROUP_SLOT_B = "MRZ SLOT B"
string GROUP_PREVIOUS_DISPLAY = "PREVIOUS MRZ DISPLAY"
string GROUP_CHART_DISPLAY = "CHART DISPLAY"
string GROUP_EQM_PD_ARRAYS = "MRZ PROXIMAL EVIDENCE"
string GROUP_EQM_INTERACTION = "MRZ EQM INTERACTION"
string GROUP_IPDA_20W = "IPDA 20W"
string GROUP_STATE_TRANSITION_OBSERVER = "State Transition Observer"
string GROUP_EXTERNAL_LIQUIDITY = "EXTERNAL LIQUIDITY"

string configuredSymbol = input.symbol("", "Configured Symbol", group = GROUP_CONFIGURATION, confirm = true)
string activeMrzSlot = input.string("A", "Active MRZ Slot", options = ["A", "B"], group = GROUP_CONFIGURATION)

float slotAUpper = input.float(0.0, "Upper", group = GROUP_SLOT_A, confirm = true)
float slotALower = input.float(0.0, "Lower", group = GROUP_SLOT_A, confirm = true)
int slotAActivationTime = input.time(0, "Activation Time", group = GROUP_SLOT_A, confirm = true)

float slotBUpper = input.float(0.0, "Upper", group = GROUP_SLOT_B, confirm = true)
float slotBLower = input.float(0.0, "Lower", group = GROUP_SLOT_B, confirm = true)
int slotBActivationTime = input.time(0, "Activation Time", group = GROUP_SLOT_B, confirm = true)

bool showPreviousMrz = input.bool(true, "Show Previous MRZ", group = GROUP_PREVIOUS_DISPLAY)

bool showCurrentEnvelope = input.bool(false, "Show Current MRZ 1W / 2W", group = GROUP_CHART_DISPLAY)
bool showPreviousEnvelope = input.bool(false, "Show Previous MRZ 1W / 2W", group = GROUP_CHART_DISPLAY)
bool showEqmProximalZone = input.bool(true, "Show MRZ EQM Proximal Zone", group = GROUP_CHART_DISPLAY)
int eqmProximalZoneWidthPercent = input.int(50, "EQM Proximal Zone Width (%)", minval = 10, maxval = 50, step = 10, group = GROUP_CHART_DISPLAY)

bool enableEqmReachedAlerts = input.bool(true, "Enable EQM Reached Alerts", group = GROUP_EQM_INTERACTION)

bool enableStateTransitionObserver = input.bool(true, "Enable State Transition Observer", group = GROUP_STATE_TRANSITION_OBSERVER)
bool showStateTransitionLabels = input.bool(true, "Show State Transition Labels", group = GROUP_STATE_TRANSITION_OBSERVER)
bool showStateDebugPanel = input.bool(true, "Show State Debug Panel", group = GROUP_STATE_TRANSITION_OBSERVER)

// External Liquidity is intentionally NOT MRZ-proximal evidence.
// It can form anywhere on the chart and remains independent of MRZ geometry.
bool showExternalLiquidity = input.bool(true, "Show BSL / SSL", group = GROUP_EXTERNAL_LIQUIDITY)
string externalLiquidityMode = input.string("Present", "Mode", options = ["Present", "Historical"], group = GROUP_EXTERNAL_LIQUIDITY)
int externalLiquidityDetectionLength = input.int(7, "Detection Length", minval = 3, maxval = 13, group = GROUP_EXTERNAL_LIQUIDITY)
float externalLiquidityMarginInput = input.float(6.9, "Detection Margin", minval = 4.0, maxval = 9.0, step = 0.1, group = GROUP_EXTERNAL_LIQUIDITY)
bool showBuysideLiquidity = input.bool(true, "Show BSL", group = GROUP_EXTERNAL_LIQUIDITY)
bool showSellsideLiquidity = input.bool(true, "Show SSL", group = GROUP_EXTERNAL_LIQUIDITY)
int externalLiquidityVisibleLevels = input.int(3, "Visible Levels / Side", minval = 1, maxval = 50, group = GROUP_EXTERNAL_LIQUIDITY)
bool showLiquidityBreachZones = input.bool(true, "Show Breach Zones", group = GROUP_EXTERNAL_LIQUIDITY)
float buysideBreachAtrMargin = input.float(2.3, "BSL Breach ATR Margin", minval = 1.5, maxval = 10.0, step = 0.1, group = GROUP_EXTERNAL_LIQUIDITY)
float sellsideBreachAtrMargin = input.float(2.3, "SSL Breach ATR Margin", minval = 1.5, maxval = 10.0, step = 0.1, group = GROUP_EXTERNAL_LIQUIDITY)
color buysideLiquidityColor = input.color(color.new(#4caf50, 0), "BSL Color", group = GROUP_EXTERNAL_LIQUIDITY)
color sellsideLiquidityColor = input.color(color.new(#f23645, 0), "SSL Color", group = GROUP_EXTERNAL_LIQUIDITY)
string externalLiquidityLabelSizeInput = input.string("Tiny", "Label Size", options = ["Tiny", "Small", "Normal", "Large"], group = GROUP_EXTERNAL_LIQUIDITY)
bool enableExternalLiquidityBreachAlerts = input.bool(true, "Enable BSL / SSL Breach Alerts", group = GROUP_EXTERNAL_LIQUIDITY)
bool showExternalLiquidityBreachLabels = input.bool(true, "Show BSL / SSL Breach Labels", group = GROUP_EXTERNAL_LIQUIDITY)

// IPDA 20W — source semantics: standalone ipda.pine.
// Only the 20W structural range is merged here; 40W/60W, tables and IPDA alerts are intentionally excluded.
bool showIpda20 = input.bool(true, "Show IPDA 20W", group = GROUP_IPDA_20W)
bool showIpda20Labels = input.bool(true, "Show IPDA 20W Labels", group = GROUP_IPDA_20W)
string ipdaType = input.string("CLASSIC+LTF", "IPDA Data Ranges Type", options = ["CLASSIC", "CLASSIC+LTF", "LTF"], group = GROUP_IPDA_20W, tooltip = "CLASSIC: preserves the standalone IPDA visibility behavior.\n\nCLASSIC+LTF: plots the weekly 20W range regardless of chart timeframe.\n\nLTF: plots the last 20 ranges of the current chart timeframe.")
color ipdaDiscountColor = input.color(color.new(#000000, 0), "Discount / Low", group = GROUP_IPDA_20W, inline = "ipda_colors")
color ipdaEquilibriumColor = input.color(color.new(#000000, 0), "EQM", group = GROUP_IPDA_20W, inline = "ipda_colors")
color ipdaPremiumColor = input.color(color.new(#000000, 0), "Premium / High", group = GROUP_IPDA_20W, inline = "ipda_colors")
color ipdaHalfZoneColor = input.color(color.new(color.gray, 0), "0.25 / 0.75", group = GROUP_IPDA_20W)

bool showProximalDisplacement = input.bool(false, "Show Proximal Displacement", group = GROUP_EQM_PD_ARRAYS)
string displacementType = input.string("Open to Close", "Displacement Type", options = ["Open to Close", "High to Low"], group = GROUP_EQM_PD_ARRAYS)
int displacementStdDevLookback = input.int(100, "StdDev Lookback", minval = 1, group = GROUP_EQM_PD_ARRAYS)
int displacementStdDevMultiplier = input.int(4, "StdDev Multiplier", minval = 0, group = GROUP_EQM_PD_ARRAYS)
bool showDisplacementCe = input.bool(true, "Show Displacement CE", group = GROUP_EQM_PD_ARRAYS)
int maxProximalDisplacementCes = input.int(50, "Max Proximal Displacement CEs", minval = 1, maxval = 400, group = GROUP_EQM_PD_ARRAYS)
color bullishDisplacementCeColor = input.color(color.lime, "Bullish Displacement CE Color", group = GROUP_EQM_PD_ARRAYS)
color bearishDisplacementCeColor = input.color(color.red, "Bearish Displacement CE Color", group = GROUP_EQM_PD_ARRAYS)
color mitigatedDisplacementCeColor = input.color(color.gray, "Mitigated CE Color", group = GROUP_EQM_PD_ARRAYS)

bool showProximalFvg = input.bool(false, "Show Proximal FVG", group = GROUP_EQM_PD_ARRAYS)
bool showFvgCe = input.bool(true, "Show FVG CE", group = GROUP_EQM_PD_ARRAYS)
bool showFvgLabels = input.bool(true, "Show FVG Labels", group = GROUP_EQM_PD_ARRAYS)
int maxProximalFvgs = input.int(20, "Max Proximal FVGs", minval = 1, maxval = 30, group = GROUP_EQM_PD_ARRAYS)
color bullishFvgColor = input.color(color.new(color.lime, 80), "Bullish FVG Color", group = GROUP_EQM_PD_ARRAYS)
color bearishFvgColor = input.color(color.new(color.red, 80), "Bearish FVG Color", group = GROUP_EQM_PD_ARRAYS)
color mitigatedFvgColor = input.color(color.new(color.gray, 82), "Mitigated FVG Color", group = GROUP_EQM_PD_ARRAYS)

bool showProximalVi = input.bool(false, "Show Proximal VI", group = GROUP_EQM_PD_ARRAYS)
bool showViCe = input.bool(true, "Show VI CE", group = GROUP_EQM_PD_ARRAYS)
bool showViLabels = input.bool(true, "Show VI Labels", group = GROUP_EQM_PD_ARRAYS)
int maxProximalVis = input.int(20, "Max Proximal VIs", minval = 1, maxval = 30, group = GROUP_EQM_PD_ARRAYS)
color bullishViColor = input.color(color.new(#00e640, 80), "Bullish VI Color", group = GROUP_EQM_PD_ARRAYS)
color bearishViColor = input.color(color.new(#e30000, 80), "Bearish VI Color", group = GROUP_EQM_PD_ARRAYS)
color mitigatedViColor = input.color(color.new(color.gray, 82), "Mitigated VI Color", group = GROUP_EQM_PD_ARRAYS)

bool showActiveOb = input.bool(false, "Show Active OB", group = GROUP_EQM_PD_ARRAYS)
bool showObCe = input.bool(true, "Show OB CE", group = GROUP_EQM_PD_ARRAYS)
bool showObLabels = input.bool(true, "Show OB Labels", group = GROUP_EQM_PD_ARRAYS)
int maxActiveObs = input.int(20, "Max Active OBs", minval = 1, maxval = 20, group = GROUP_EQM_PD_ARRAYS)
color bullishObColor = input.color(color.new(color.blue, 85), "Bullish OB Color", group = GROUP_EQM_PD_ARRAYS)
color bearishObColor = input.color(color.new(color.red, 85), "Bearish OB Color", group = GROUP_EQM_PD_ARRAYS)
color invalidatedObColor = input.color(color.new(color.gray, 85), "Invalidated OB Color", group = GROUP_EQM_PD_ARRAYS)

// ──────────────────────────────────────────────────────────────────────────────
// IPDA 20W STRUCTURAL RANGE
// Faithful transplant of the standalone ipda.pine 20W calculation.
// Keep request.security() placement and historical offsets unchanged.
// ──────────────────────────────────────────────────────────────────────────────
bool ipdaShowDLTF = ipdaType == "CLASSIC+LTF"
bool ipdaShowLTF = ipdaType == "LTF"
ipdaShowDLTF := ipdaShowLTF ? true : ipdaShowDLTF

int ipda20Time = ipdaShowLTF ? time[20] : request.security(syminfo.tickerid, "W", time[20])
float ipda20Low = ipdaShowLTF ? ta.lowest(low, 20)[1] : request.security(syminfo.tickerid, "W", ta.lowest(low, 20))[1]
float ipda20High = ipdaShowLTF ? ta.highest(high, 20)[1] : request.security(syminfo.tickerid, "W", ta.highest(high, 20))[1]
float ipda20Eqm = (ipda20Low + ipda20High) / 2.0
float ipda20Quarter = (ipda20Low + ipda20Eqm) / 2.0
float ipda20ThreeQuarter = (ipda20Eqm + ipda20High) / 2.0

bool ipda20Ready = not na(ipda20Time) and not na(ipda20Low) and not na(ipda20High)
bool ipda20Visible = showIpda20 and ipda20Ready and (ipdaShowDLTF ? true : timeframe.period == "W")

bool slotAIsActive = activeMrzSlot == "A"
float currentMrzUpper = slotAIsActive ? slotAUpper : slotBUpper
float currentMrzLower = slotAIsActive ? slotALower : slotBLower
int currentActivationTime = slotAIsActive ? slotAActivationTime : slotBActivationTime
float previousMrzUpper = slotAIsActive ? slotBUpper : slotAUpper
float previousMrzLower = slotAIsActive ? slotBLower : slotALower
int previousActivationTime = slotAIsActive ? slotBActivationTime : slotAActivationTime

bool symbolConfigured = configuredSymbol != ""
string configuredTickerId = symbolConfigured ? ticker.standard(configuredSymbol) : ""
string chartTickerId = ticker.standard(syminfo.tickerid)
bool symbolMatches = symbolConfigured and configuredTickerId == chartTickerId

bool currentMrzValid = currentMrzUpper > currentMrzLower
bool previousMrzValid = previousMrzUpper > previousMrzLower
bool currentMrzAvailable = symbolMatches and currentMrzValid and currentActivationTime > 0
bool previousMrzAvailable = symbolMatches and previousMrzValid and previousActivationTime > 0
bool currentMrzVisible = currentMrzAvailable
bool previousMrzVisible = showPreviousMrz and previousMrzAvailable
bool migrationEqmVisible = currentMrzAvailable and previousMrzAvailable
bool currentEnvelopeVisible = currentMrzVisible and showCurrentEnvelope
bool previousEnvelopeVisible = previousMrzVisible and showPreviousEnvelope

// Horizontal plots begin on the first chart bar at or after their activation timestamp.
bool currentPlotVisible = currentMrzVisible and time >= currentActivationTime
bool previousPlotVisible = previousMrzVisible and time >= previousActivationTime
bool activeDealingRangeAvailable = migrationEqmVisible and time >= currentActivationTime
bool migrationEqmPlotVisible = activeDealingRangeAvailable
bool currentEnvelopePlotVisible = currentEnvelopeVisible and time >= currentActivationTime
bool previousEnvelopePlotVisible = previousEnvelopeVisible and time >= previousActivationTime
bool eqmProximalZonePlotVisible = migrationEqmPlotVisible and showEqmProximalZone
// Active two-MRZ geometry begins at current MRZ activation; presentation toggles do not control it.
bool activeEvidenceGeometryAvailable = activeDealingRangeAvailable
// The EQM zone remains visual/attention geometry inside the already-active dealing range.
bool eqmProximalGeometryAvailable = activeDealingRangeAvailable

float currentMrzMidpoint = math.round_to_mintick((currentMrzUpper + currentMrzLower) / 2.0)
float previousMrzMidpoint = math.round_to_mintick((previousMrzUpper + previousMrzLower) / 2.0)
float dealingRangeLow = math.min(currentMrzMidpoint, previousMrzMidpoint)
float dealingRangeHigh = math.max(currentMrzMidpoint, previousMrzMidpoint)
// Migration EQM = midpoint between current-MRZ midpoint and previous-MRZ midpoint.
float migrationEqm = math.round_to_mintick((currentMrzMidpoint + previousMrzMidpoint) / 2.0)
float evidenceEnvelopeLow = math.min(currentMrzLower, previousMrzLower)
float evidenceEnvelopeHigh = math.max(currentMrzUpper, previousMrzUpper)
// Previous midpoint is normalized anchor 0, Current midpoint is anchor 1, and 0.5 is Migration EQM.
// The default 50% proximal interval is 0.25-0.75; the operator may only shrink it symmetrically around 0.5.
float eqmProximalWidthNormalized = eqmProximalZoneWidthPercent / 100.0
float eqmProximalHalfWidth = eqmProximalWidthNormalized / 2.0
float eqmProximalBoundA = 0.5 - eqmProximalHalfWidth
float eqmProximalBoundB = 0.5 + eqmProximalHalfWidth
float midpointAnchorDistance = currentMrzMidpoint - previousMrzMidpoint
float eqmProximalPriceA = previousMrzMidpoint + eqmProximalBoundA * midpointAnchorDistance
float eqmProximalPriceB = previousMrzMidpoint + eqmProximalBoundB * midpointAnchorDistance
float eqmProximalZoneLow = math.round_to_mintick(math.min(eqmProximalPriceA, eqmProximalPriceB))
float eqmProximalZoneHigh = math.round_to_mintick(math.max(eqmProximalPriceA, eqmProximalPriceB))

f_alertSymbol() =>
    syminfo.ticker

// Keep the source displacement definition unchanged; the active evidence envelope only filters displayed events.
float candleDisplacementRange = displacementType == "Open to Close" ? math.abs(open - close) : high - low
float displacementStdDevThreshold = ta.stdev(candleDisplacementRange, displacementStdDevLookback) * displacementStdDevMultiplier
bool displacement = candleDisplacementRange > displacementStdDevThreshold
bool bullishDisplacement = displacement and close > open
bool bearishDisplacement = displacement and close < open
bool displacementIntersectsEvidenceEnvelope = high >= evidenceEnvelopeLow and low <= evidenceEnvelopeHigh
bool activeDisplacementQualified = activeEvidenceGeometryAvailable and displacementIntersectsEvidenceEnvelope and (bullishDisplacement or bearishDisplacement)
bool proximalDisplacement = activeDisplacementQualified
float displacementCe = (high + low) * 0.5
color proximalDisplacementCandleColor = showProximalDisplacement and proximalDisplacement and barstate.isconfirmed ? color.new(bullishDisplacement ? bullishDisplacementCeColor : bearishDisplacementCeColor, 35) : na
barcolor(proximalDisplacementCandleColor, title = "Proximal Displacement Candle")

// Candle overlap decides MRZ relevance; the event's own CE remains its reference.
// CE does not qualify proximity, and CE mitigation is not acceptance or rejection.
float currentMrzWidth = currentMrzUpper - currentMrzLower
float currentPlus1W = math.round_to_mintick(currentMrzUpper + currentMrzWidth)
float currentMinus1W = math.round_to_mintick(currentMrzLower - currentMrzWidth)
float currentPlus2W = math.round_to_mintick(currentMrzUpper + 2.0 * currentMrzWidth)
float currentMinus2W = math.round_to_mintick(currentMrzLower - 2.0 * currentMrzWidth)
float previousMrzWidth = previousMrzUpper - previousMrzLower
float previousPlus1W = math.round_to_mintick(previousMrzUpper + previousMrzWidth)
float previousMinus1W = math.round_to_mintick(previousMrzLower - previousMrzWidth)
float previousPlus2W = math.round_to_mintick(previousMrzUpper + 2.0 * previousMrzWidth)
float previousMinus2W = math.round_to_mintick(previousMrzLower - 2.0 * previousMrzWidth)

// ──────────────────────────────────────────────────────────────────────────────
// EXTERNAL LIQUIDITY CONTEXT — BSL / SSL
// Faithful semantic transplant of the supplied BSL_SSL detector, ported to v6.
// This engine is independent of MRZ/evidence-envelope qualification.
// Standalone detection alerts and unrelated source features are intentionally omitted.
// Detector objects preserve the source BSL_SSL lifecycle. Source/start pivot identity,
// not price proximity, defines an object; nearby and overlapping objects remain independent.
// ──────────────────────────────────────────────────────────────────────────────
const int EXT_LIQ_MAX_PIVOTS = 50
float externalLiquidityAtr = ta.atr(10)
float externalLiquidityMargin = 10.0 / externalLiquidityMarginInput
bool externalLiquidityPeriodEligible = externalLiquidityMode == "Present" ? last_bar_index - bar_index <= 500 : true

externalLiquidityLabelSize = switch externalLiquidityLabelSizeInput
    "Tiny" => size.tiny
    "Small" => size.small
    "Normal" => size.normal
    "Large" => size.large

// A zero-height box can fail to render text reliably after the integration.
// Use a very small invisible vertical text band while preserving the source-style
// transparent box, left alignment, and BSL-below / SSL-above placement.
float externalLiquidityLabelPad = math.max(syminfo.mintick * 2.0, externalLiquidityAtr * 0.03)


f_externalLiquidityBreachPayload(_eventType, _side, _sourceBar, _detectionBar, _level, _zoneTop, _zoneBottom, _observedAt) =>
    string objectId = _side + "|" + str.tostring(_sourceBar) + "|" + str.tostring(_detectionBar) + "|" + str.tostring(_level, format.mintick)
    string payload = '{"alert":"' + f_alertSymbol() + ' · ' + _eventType + '"'
    payload += ',"schema_version":"1.0"'
    payload += ',"event_type":"' + _eventType + '"'
    payload += ',"symbol":"' + syminfo.tickerid + '"'
    payload += ',"liquidity_side":"' + _side + '"'
    payload += ',"object_id":"' + objectId + '"'
    payload += ',"source_bar":' + str.tostring(_sourceBar)
    payload += ',"detection_bar":' + str.tostring(_detectionBar)
    payload += ',"liquidity_level":' + str.tostring(_level, format.mintick)
    payload += ',"zone_top":' + str.tostring(_zoneTop, format.mintick)
    payload += ',"zone_bottom":' + str.tostring(_zoneBottom, format.mintick)
    payload += ',"timeframe":"' + timeframe.period + '"'
    payload += ',"observed_at":' + str.tostring(_observedAt)
    payload += ',"price":' + str.tostring(close, format.mintick) + '}'
    payload


var int[] extLiqPivotDirections = array.new_int(EXT_LIQ_MAX_PIVOTS, 0)
var int[] extLiqPivotBars = array.new_int(EXT_LIQ_MAX_PIVOTS, 0)
var float[] extLiqPivotPrices = array.new_float(EXT_LIQ_MAX_PIVOTS, na)

var int[] extBslLeftBars = array.new_int()
var int[] extBslDetectedBars = array.new_int()
var float[] extBslLevels = array.new_float()
var float[] extBslZoneTops = array.new_float()
var float[] extBslZoneBottoms = array.new_float()
var bool[] extBslBreached = array.new_bool()
var bool[] extBslBreachActive = array.new_bool()
var line[] extBslSolidLines = array.new_line()
var line[] extBslLines = array.new_line() // dotted extension line
var box[] extBslTextBoxes = array.new_box()
var box[] extBslBreachBoxes = array.new_box()

var int[] extSslLeftBars = array.new_int()
var int[] extSslDetectedBars = array.new_int()
var float[] extSslLevels = array.new_float()
var float[] extSslZoneTops = array.new_float()
var float[] extSslZoneBottoms = array.new_float()
var bool[] extSslBreached = array.new_bool()
var bool[] extSslBreachActive = array.new_bool()
var line[] extSslSolidLines = array.new_line()
var line[] extSslLines = array.new_line() // dotted extension line
var box[] extSslTextBoxes = array.new_box()
var box[] extSslBreachBoxes = array.new_box()

float extLiqPivotHigh = ta.pivothigh(externalLiquidityDetectionLength, 1)
float extLiqPivotLow = ta.pivotlow(externalLiquidityDetectionLength, 1)
int extLiqPivotBar = bar_index - 1

if not na(extLiqPivotHigh)
    int extDir = array.get(extLiqPivotDirections, 0)
    float extPrice = nz(high[1])

    if extDir < 1
        array.unshift(extLiqPivotDirections, 1)
        array.unshift(extLiqPivotBars, extLiqPivotBar)
        array.unshift(extLiqPivotPrices, extPrice)
        array.pop(extLiqPivotDirections)
        array.pop(extLiqPivotBars)
        array.pop(extLiqPivotPrices)
    else if extDir == 1 and extLiqPivotHigh > array.get(extLiqPivotPrices, 0)
        array.set(extLiqPivotBars, 0, extLiqPivotBar)
        array.set(extLiqPivotPrices, 0, extPrice)

    if externalLiquidityPeriodEligible
        int extCount = 0
        float extSourceLevel = 0.0
        int extStartBar = 0
        float extMinP = 0.0
        float extMaxP = 10e6

        for i = 0 to EXT_LIQ_MAX_PIVOTS - 1
            if array.get(extLiqPivotDirections, i) == 1
                float pivotPrice = array.get(extLiqPivotPrices, i)
                if pivotPrice > extLiqPivotHigh + (externalLiquidityAtr / externalLiquidityMargin)
                    break
                else if pivotPrice > extLiqPivotHigh - (externalLiquidityAtr / externalLiquidityMargin) and pivotPrice < extLiqPivotHigh + (externalLiquidityAtr / externalLiquidityMargin)
                    extCount += 1
                    extStartBar := array.get(extLiqPivotBars, i)
                    extSourceLevel := pivotPrice
                    if pivotPrice > extMinP
                        extMinP := pivotPrice
                    if pivotPrice < extMaxP
                        extMaxP := pivotPrice

        if extCount > 2
            float zoneCenter = math.avg(extMinP, extMaxP)
            float zoneTop = zoneCenter + (externalLiquidityAtr / externalLiquidityMargin)
            float zoneBottom = zoneCenter - (externalLiquidityAtr / externalLiquidityMargin)
            bool updateExisting = array.size(extBslLeftBars) > 0 and extStartBar == array.get(extBslLeftBars, 0)

            if updateExisting
                // Source parity: same st_B updates bx bounds only. The original st_P
                // remains the displayed/alerted liquidity level for this object.
                array.set(extBslZoneTops, 0, zoneTop)
                array.set(extBslZoneBottoms, 0, zoneBottom)
            else
                // A new source/start pivot is an independent unbreached detector object.
                array.unshift(extBslLeftBars, extStartBar)
                array.unshift(extBslDetectedBars, bar_index - 1)
                array.unshift(extBslLevels, extSourceLevel)
                array.unshift(extBslZoneTops, zoneTop)
                array.unshift(extBslZoneBottoms, zoneBottom)
                array.unshift(extBslBreached, false)
                array.unshift(extBslBreachActive, false)
                array.unshift(extBslSolidLines, na)
                array.unshift(extBslLines, na)
                array.unshift(extBslTextBoxes, na)
                array.unshift(extBslBreachBoxes, na)

                while array.size(extBslLevels) > externalLiquidityVisibleLevels
                    line oldSolidLine = array.pop(extBslSolidLines)
                    if not na(oldSolidLine)
                        line.delete(oldSolidLine)
                    line oldLine = array.pop(extBslLines)
                    if not na(oldLine)
                        line.delete(oldLine)
                    box oldTextBox = array.pop(extBslTextBoxes)
                    if not na(oldTextBox)
                        box.delete(oldTextBox)
                    box oldBox = array.pop(extBslBreachBoxes)
                    if not na(oldBox)
                        box.delete(oldBox)
                    array.pop(extBslLeftBars)
                    array.pop(extBslDetectedBars)
                    array.pop(extBslLevels)
                    array.pop(extBslZoneTops)
                    array.pop(extBslZoneBottoms)
                    array.pop(extBslBreached)
                    array.pop(extBslBreachActive)

if not na(extLiqPivotLow)
    int extDir = array.get(extLiqPivotDirections, 0)
    float extPrice = nz(low[1])

    if extDir > -1
        array.unshift(extLiqPivotDirections, -1)
        array.unshift(extLiqPivotBars, extLiqPivotBar)
        array.unshift(extLiqPivotPrices, extPrice)
        array.pop(extLiqPivotDirections)
        array.pop(extLiqPivotBars)
        array.pop(extLiqPivotPrices)
    else if extDir == -1 and extLiqPivotLow < array.get(extLiqPivotPrices, 0)
        array.set(extLiqPivotBars, 0, extLiqPivotBar)
        array.set(extLiqPivotPrices, 0, extPrice)

    if externalLiquidityPeriodEligible
        int extCount = 0
        float extSourceLevel = 0.0
        int extStartBar = 0
        float extMinP = 0.0
        float extMaxP = 10e6

        for i = 0 to EXT_LIQ_MAX_PIVOTS - 1
            if array.get(extLiqPivotDirections, i) == -1
                float pivotPrice = array.get(extLiqPivotPrices, i)
                if pivotPrice < extLiqPivotLow - (externalLiquidityAtr / externalLiquidityMargin)
                    break
                else if pivotPrice > extLiqPivotLow - (externalLiquidityAtr / externalLiquidityMargin) and pivotPrice < extLiqPivotLow + (externalLiquidityAtr / externalLiquidityMargin)
                    extCount += 1
                    extStartBar := array.get(extLiqPivotBars, i)
                    extSourceLevel := pivotPrice
                    if pivotPrice > extMinP
                        extMinP := pivotPrice
                    if pivotPrice < extMaxP
                        extMaxP := pivotPrice

        if extCount > 2
            float zoneCenter = math.avg(extMinP, extMaxP)
            float zoneTop = zoneCenter + (externalLiquidityAtr / externalLiquidityMargin)
            float zoneBottom = zoneCenter - (externalLiquidityAtr / externalLiquidityMargin)
            bool updateExisting = array.size(extSslLeftBars) > 0 and extStartBar == array.get(extSslLeftBars, 0)

            if updateExisting
                // Source parity: same st_B updates bx bounds only. The original st_P
                // remains the displayed/alerted liquidity level for this object.
                array.set(extSslZoneTops, 0, zoneTop)
                array.set(extSslZoneBottoms, 0, zoneBottom)
            else
                // A new source/start pivot is an independent unbreached detector object.
                array.unshift(extSslLeftBars, extStartBar)
                array.unshift(extSslDetectedBars, bar_index - 1)
                array.unshift(extSslLevels, extSourceLevel)
                array.unshift(extSslZoneTops, zoneTop)
                array.unshift(extSslZoneBottoms, zoneBottom)
                array.unshift(extSslBreached, false)
                array.unshift(extSslBreachActive, false)
                array.unshift(extSslSolidLines, na)
                array.unshift(extSslLines, na)
                array.unshift(extSslTextBoxes, na)
                array.unshift(extSslBreachBoxes, na)

                while array.size(extSslLevels) > externalLiquidityVisibleLevels
                    line oldSolidLine = array.pop(extSslSolidLines)
                    if not na(oldSolidLine)
                        line.delete(oldSolidLine)
                    line oldLine = array.pop(extSslLines)
                    if not na(oldLine)
                        line.delete(oldLine)
                    box oldTextBox = array.pop(extSslTextBoxes)
                    if not na(oldTextBox)
                        box.delete(oldTextBox)
                    box oldBox = array.pop(extSslBreachBoxes)
                    if not na(oldBox)
                        box.delete(oldBox)
                    array.pop(extSslLeftBars)
                    array.pop(extSslDetectedBars)
                    array.pop(extSslLevels)
                    array.pop(extSslZoneTops)
                    array.pop(extSslZoneBottoms)
                    array.pop(extSslBreached)
                    array.pop(extSslBreachActive)

int extBslCount = array.size(extBslLevels)
if extBslCount > 0
    for i = 0 to extBslCount - 1
        int sourceBar = array.get(extBslLeftBars, i)
        int detectionBar = array.get(extBslDetectedBars, i)
        float level = array.get(extBslLevels, i)
        float zoneTop = array.get(extBslZoneTops, i)
        float zoneBottom = array.get(extBslZoneBottoms, i)
        bool breached = array.get(extBslBreached, i)
        bool breachActive = array.get(extBslBreachActive, i)
        bool breachedThisBar = false

        if not breached and barstate.isconfirmed and high > zoneTop
            breached := true
            breachActive := true
            breachedThisBar := true
            array.set(extBslBreached, i, true)
            array.set(extBslBreachActive, i, true)

            if showExternalLiquidityBreachLabels
                label.new(
                     bar_index,
                     high,
                     "BSL BR",
                     xloc = xloc.bar_index,
                     style = label.style_label_down,
                     color = color.new(buysideLiquidityColor, 0),
                     textcolor = color.white,
                     size = size.tiny,
                     tooltip = "BSL_BREACHED\nObject: BSL|" + str.tostring(sourceBar) + "|" + str.tostring(detectionBar) + "|" + str.tostring(level, format.mintick) + "\nLevel: " + str.tostring(level, format.mintick) + "\nSource Bar: " + str.tostring(sourceBar) + "\nDetected Bar: " + str.tostring(detectionBar) + "\nZone Top: " + str.tostring(zoneTop, format.mintick) + "\nZone Bottom: " + str.tostring(zoneBottom, format.mintick)
                )

            if enableExternalLiquidityBreachAlerts
                alert(
                     f_externalLiquidityBreachPayload(
                          "BSL_BREACHED",
                          "BSL",
                          sourceBar,
                          detectionBar,
                          level,
                          zoneTop,
                          zoneBottom,
                          time_close
                     ),
                     alert.freq_once_per_bar_close
                )

        else if breached and breachActive
            bool remainsInBreachGeometry = low > level - buysideBreachAtrMargin * externalLiquidityAtr and high < level + buysideBreachAtrMargin * externalLiquidityAtr
            if not remainsInBreachGeometry
                breachActive := false
                array.set(extBslBreachActive, i, false)

        bool visible = showExternalLiquidity and showBuysideLiquidity and i < externalLiquidityVisibleLevels
        line solidLine = array.get(extBslSolidLines, i)
        line levelLine = array.get(extBslLines, i)
        box levelTextBox = array.get(extBslTextBoxes, i)
        box breachBox = array.get(extBslBreachBoxes, i)

        if visible
            int leftBar = sourceBar
            int detectedBar = detectionBar

            // Match original BSL_SSL presentation:
            // solid segment from first qualifying pivot to detection,
            // then dotted extension from detection forward.
            if na(solidLine)
                solidLine := line.new(leftBar, level, detectedBar, level, xloc = xloc.bar_index, color = color.new(buysideLiquidityColor, 0), style = line.style_solid, width = 1)
                array.set(extBslSolidLines, i, solidLine)
            else
                line.set_x1(solidLine, leftBar)
                line.set_x2(solidLine, detectedBar)
                line.set_y1(solidLine, level)
                line.set_y2(solidLine, level)
                line.set_color(solidLine, color.new(buysideLiquidityColor, 0))
                line.set_style(solidLine, line.style_solid)

            // The source reaches bar_index on the breach candle, then bar_index + 1
            // on later candles while brZ remains active.
            int extensionRight = breached and breachActive and not breachedThisBar ? bar_index + 1 : bar_index
            if na(levelLine)
                levelLine := line.new(detectedBar, level, extensionRight, level, xloc = xloc.bar_index, color = color.new(buysideLiquidityColor, 0), style = line.style_dotted, width = 1)
                array.set(extBslLines, i, levelLine)
            else
                if not breached or breachActive
                    line.set_x2(levelLine, extensionRight)
                line.set_x1(levelLine, detectedBar)
                line.set_y1(levelLine, level)
                line.set_y2(levelLine, level)
                line.set_color(levelLine, color.new(buysideLiquidityColor, 0))
                line.set_style(levelLine, line.style_dotted)

            // Match the source BSL_SSL.pine label presentation:
            // transparent text box, left-aligned, BSL text below the level.
            if na(levelTextBox)
                levelTextBox := box.new(leftBar, level + externalLiquidityLabelPad, detectedBar + 11, level, xloc = xloc.bar_index, text = "BSL", text_size = externalLiquidityLabelSize, text_halign = text.align_left, text_valign = text.align_bottom, text_color = color.new(buysideLiquidityColor, 10), bgcolor = color.new(color.white, 100), border_color = color.new(color.white, 100))
                array.set(extBslTextBoxes, i, levelTextBox)
            else
                box.set_left(levelTextBox, leftBar)
                box.set_right(levelTextBox, detectedBar + 11)
                box.set_top(levelTextBox, level + externalLiquidityLabelPad)
                box.set_bottom(levelTextBox, level)
                box.set_text_color(levelTextBox, color.new(buysideLiquidityColor, 10))

            if showLiquidityBreachZones and breached and breachActive
                float breachTop = math.min(level + buysideBreachAtrMargin * externalLiquidityAtr, high)
                if na(breachBox)
                    breachBox := box.new(bar_index - 1, breachTop, bar_index + 1, level, xloc = xloc.bar_index, bgcolor = color.new(buysideLiquidityColor, 82), border_color = na)
                    array.set(extBslBreachBoxes, i, breachBox)
                else
                    box.set_right(breachBox, bar_index + 1)
                    box.set_top(breachBox, math.max(box.get_top(breachBox), breachTop))
            else if not na(breachBox) and not showLiquidityBreachZones
                box.delete(breachBox)
                array.set(extBslBreachBoxes, i, na)
        else
            if not na(solidLine)
                line.delete(solidLine)
                array.set(extBslSolidLines, i, na)
            if not na(levelLine)
                line.delete(levelLine)
                array.set(extBslLines, i, na)
            if not na(levelTextBox)
                box.delete(levelTextBox)
                array.set(extBslTextBoxes, i, na)
            if not na(breachBox)
                box.delete(breachBox)
                array.set(extBslBreachBoxes, i, na)

int extSslCount = array.size(extSslLevels)
if extSslCount > 0
    for i = 0 to extSslCount - 1
        int sourceBar = array.get(extSslLeftBars, i)
        int detectionBar = array.get(extSslDetectedBars, i)
        float level = array.get(extSslLevels, i)
        float zoneTop = array.get(extSslZoneTops, i)
        float zoneBottom = array.get(extSslZoneBottoms, i)
        bool breached = array.get(extSslBreached, i)
        bool breachActive = array.get(extSslBreachActive, i)
        bool breachedThisBar = false

        if not breached and barstate.isconfirmed and low < zoneBottom
            breached := true
            breachActive := true
            breachedThisBar := true
            array.set(extSslBreached, i, true)
            array.set(extSslBreachActive, i, true)

            if showExternalLiquidityBreachLabels
                label.new(
                     bar_index,
                     low,
                     "SSL BR",
                     xloc = xloc.bar_index,
                     style = label.style_label_up,
                     color = color.new(sellsideLiquidityColor, 0),
                     textcolor = color.white,
                     size = size.tiny,
                     tooltip = "SSL_BREACHED\nObject: SSL|" + str.tostring(sourceBar) + "|" + str.tostring(detectionBar) + "|" + str.tostring(level, format.mintick) + "\nLevel: " + str.tostring(level, format.mintick) + "\nSource Bar: " + str.tostring(sourceBar) + "\nDetected Bar: " + str.tostring(detectionBar) + "\nZone Top: " + str.tostring(zoneTop, format.mintick) + "\nZone Bottom: " + str.tostring(zoneBottom, format.mintick)
                )

            if enableExternalLiquidityBreachAlerts
                alert(
                     f_externalLiquidityBreachPayload(
                          "SSL_BREACHED",
                          "SSL",
                          sourceBar,
                          detectionBar,
                          level,
                          zoneTop,
                          zoneBottom,
                          time_close
                     ),
                     alert.freq_once_per_bar_close
                )

        else if breached and breachActive
            bool remainsInBreachGeometry = low > level - sellsideBreachAtrMargin * externalLiquidityAtr and high < level + sellsideBreachAtrMargin * externalLiquidityAtr
            if not remainsInBreachGeometry
                breachActive := false
                array.set(extSslBreachActive, i, false)

        bool visible = showExternalLiquidity and showSellsideLiquidity and i < externalLiquidityVisibleLevels
        line solidLine = array.get(extSslSolidLines, i)
        line levelLine = array.get(extSslLines, i)
        box levelTextBox = array.get(extSslTextBoxes, i)
        box breachBox = array.get(extSslBreachBoxes, i)

        if visible
            int leftBar = sourceBar
            int detectedBar = detectionBar

            // Match original BSL_SSL presentation:
            // solid segment from first qualifying pivot to detection,
            // then dotted extension from detection forward.
            if na(solidLine)
                solidLine := line.new(leftBar, level, detectedBar, level, xloc = xloc.bar_index, color = color.new(sellsideLiquidityColor, 0), style = line.style_solid, width = 1)
                array.set(extSslSolidLines, i, solidLine)
            else
                line.set_x1(solidLine, leftBar)
                line.set_x2(solidLine, detectedBar)
                line.set_y1(solidLine, level)
                line.set_y2(solidLine, level)
                line.set_color(solidLine, color.new(sellsideLiquidityColor, 0))
                line.set_style(solidLine, line.style_solid)

            // The source reaches bar_index on the breach candle, then bar_index + 1
            // on later candles while brZ remains active.
            int extensionRight = breached and breachActive and not breachedThisBar ? bar_index + 1 : bar_index
            if na(levelLine)
                levelLine := line.new(detectedBar, level, extensionRight, level, xloc = xloc.bar_index, color = color.new(sellsideLiquidityColor, 0), style = line.style_dotted, width = 1)
                array.set(extSslLines, i, levelLine)
            else
                if not breached or breachActive
                    line.set_x2(levelLine, extensionRight)
                line.set_x1(levelLine, detectedBar)
                line.set_y1(levelLine, level)
                line.set_y2(levelLine, level)
                line.set_color(levelLine, color.new(sellsideLiquidityColor, 0))
                line.set_style(levelLine, line.style_dotted)

            // Match the source BSL_SSL.pine label presentation:
            // transparent text box, left-aligned, SSL text above the level.
            if na(levelTextBox)
                levelTextBox := box.new(leftBar, level, detectedBar + 11, level - externalLiquidityLabelPad, xloc = xloc.bar_index, text = "SSL", text_size = externalLiquidityLabelSize, text_halign = text.align_left, text_valign = text.align_top, text_color = color.new(sellsideLiquidityColor, 10), bgcolor = color.new(color.white, 100), border_color = color.new(color.white, 100))
                array.set(extSslTextBoxes, i, levelTextBox)
            else
                box.set_left(levelTextBox, leftBar)
                box.set_right(levelTextBox, detectedBar + 11)
                box.set_top(levelTextBox, level)
                box.set_bottom(levelTextBox, level - externalLiquidityLabelPad)
                box.set_text_color(levelTextBox, color.new(sellsideLiquidityColor, 10))

            if showLiquidityBreachZones and breached and breachActive
                float breachBottom = math.max(level - sellsideBreachAtrMargin * externalLiquidityAtr, low)
                if na(breachBox)
                    breachBox := box.new(bar_index - 1, level, bar_index + 1, breachBottom, xloc = xloc.bar_index, bgcolor = color.new(sellsideLiquidityColor, 82), border_color = na)
                    array.set(extSslBreachBoxes, i, breachBox)
                else
                    box.set_right(breachBox, bar_index + 1)
                    box.set_bottom(breachBox, math.min(box.get_bottom(breachBox), breachBottom))
            else if not na(breachBox) and not showLiquidityBreachZones
                box.delete(breachBox)
                array.set(extSslBreachBoxes, i, na)
        else
            if not na(solidLine)
                line.delete(solidLine)
                array.set(extSslSolidLines, i, na)
            if not na(levelLine)
                line.delete(levelLine)
                array.set(extSslLines, i, na)
            if not na(levelTextBox)
                box.delete(levelTextBox)
                array.set(extSslTextBoxes, i, na)
            if not na(breachBox)
                box.delete(breachBox)
                array.set(extSslBreachBoxes, i, na)

float nearestActiveBslAbove = na
float nearestActiveSslBelow = na

if extBslCount > 0
    for i = 0 to extBslCount - 1
        if not array.get(extBslBreached, i)
            float level = array.get(extBslLevels, i)
            if level > close and (na(nearestActiveBslAbove) or level < nearestActiveBslAbove)
                nearestActiveBslAbove := level

if extSslCount > 0
    for i = 0 to extSslCount - 1
        if not array.get(extSslBreached, i)
            float level = array.get(extSslLevels, i)
            if level < close and (na(nearestActiveSslBelow) or level > nearestActiveSslBelow)
                nearestActiveSslBelow := level


// Minimal direction-neutral structural-anchor observer. Authoritative geometry
// describes the environment; confirmed prospective contacts describe the path.
const int OBS_STATE_PRE_ACTIVATION = 0
const int OBS_STATE_OBSERVE_ANCHORS = 1
const int OBS_ANCHOR_NONE = 0
const int OBS_ANCHOR_CURRENT_MIDPOINT = 1
const int OBS_ANCHOR_MIGRATION_EQM = 2
const int OBS_ANCHOR_PREVIOUS_MIDPOINT = 3
const int OBS_ANCHOR_MULTIPLE = 4
const int OBS_CONTACT_CURRENT_MIDPOINT = 1
const int OBS_CONTACT_MIGRATION_EQM = 2
const int OBS_CONTACT_PREVIOUS_MIDPOINT = 4
const int MAX_STATE_OBSERVER_LABELS = 100

f_observerStateText(_state) =>
    _state == OBS_STATE_OBSERVE_ANCHORS ? "OBSERVE_ANCHORS" : "PRE_ACTIVATION"

f_observerPriceText(_value) =>
    na(_value) ? "-" : str.tostring(_value, format.mintick)

f_observerTimeText(_value) =>
    na(_value) ? "-" : str.format_time(_value, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")

f_observerPanelTimeText(_value) =>
    na(_value) ? "-" : str.format_time(_value, "dd MMM yyyy '·' HH:mm", "UTC-4") + " UTC−4"

f_observerAnchorName(_anchor) =>
    _anchor == OBS_ANCHOR_CURRENT_MIDPOINT ? "CURRENT MIDPOINT" : _anchor == OBS_ANCHOR_MIGRATION_EQM ? "MIGRATION EQM" : _anchor == OBS_ANCHOR_PREVIOUS_MIDPOINT ? "PREVIOUS MIDPOINT" : _anchor == OBS_ANCHOR_MULTIPLE ? "COINCIDENT MIDPOINT ANCHORS" : "NONE"

f_observerLastAnchorText(_anchor) =>
    _anchor == OBS_ANCHOR_CURRENT_MIDPOINT ? "CURRENT MRZ MIDPOINT" : _anchor == OBS_ANCHOR_MIGRATION_EQM ? "MIGRATION EQM" : _anchor == OBS_ANCHOR_PREVIOUS_MIDPOINT ? "PREVIOUS MRZ MIDPOINT" : _anchor == OBS_ANCHOR_MULTIPLE ? "MULTIPLE / AMBIGUOUS" : "NONE"

f_observerAdjacentText(_anchor, _price) =>
    _anchor == OBS_ANCHOR_NONE ? "NONE" : f_observerAnchorName(_anchor) + " @ " + f_observerPriceText(_price)

f_observerBetweenExclusive(_price, _anchorA, _anchorB) =>
    _price > math.min(_anchorA, _anchorB) and _price < math.max(_anchorA, _anchorB)

f_observerPriceRegion(_price, _currentLower, _currentUpper, _currentMid, _eqm, _previousLower, _previousUpper, _previousMid) =>
    bool insideCurrentMrz = _price >= _currentLower and _price <= _currentUpper
    bool insidePreviousMrz = _price >= _previousLower and _price <= _previousUpper
    bool atCurrentMid = _price == _currentMid
    bool atEqm = _price == _eqm
    bool atPreviousMid = _price == _previousMid
    int matchedAnchors = (atCurrentMid ? 1 : 0) + (atEqm ? 1 : 0) + (atPreviousMid ? 1 : 0)
    string lowerEndpointMrz = _currentMid < _previousMid ? "CURRENT" : _previousMid < _currentMid ? "PREVIOUS" : "COINCIDENT"
    string upperEndpointMrz = _currentMid > _previousMid ? "CURRENT" : _previousMid > _currentMid ? "PREVIOUS" : "COINCIDENT"
    matchedAnchors > 1 ? "AT COINCIDENT MIDPOINT ANCHORS" : atCurrentMid ? "AT CURRENT MIDPOINT" : atEqm ? "AT MIGRATION EQM" : atPreviousMid ? "AT PREVIOUS MIDPOINT" : insideCurrentMrz and insidePreviousMrz ? "INSIDE OVERLAPPING MRZS" : insideCurrentMrz ? "INSIDE CURRENT MRZ" : insidePreviousMrz ? "INSIDE PREVIOUS MRZ" : f_observerBetweenExclusive(_price, _currentMid, _eqm) ? "BETWEEN CURRENT MIDPOINT AND EQM" : f_observerBetweenExclusive(_price, _eqm, _previousMid) ? "BETWEEN EQM AND PREVIOUS MIDPOINT" : _price < math.min(_currentMid, _previousMid) ? "BELOW " + lowerEndpointMrz + " MRZ" : _price > math.max(_currentMid, _previousMid) ? "ABOVE " + upperEndpointMrz + " MRZ" : "BETWEEN STRUCTURAL ANCHORS"

f_observerContactList(_currentMidContact, _eqmContact, _previousMidContact) =>
    string contactList = ""
    if _currentMidContact
        contactList := "CURRENT MRZ MIDPOINT"
    if _eqmContact
        contactList := contactList == "" ? "MIGRATION EQM" : contactList + " + MIGRATION EQM"
    if _previousMidContact
        contactList := contactList == "" ? "PREVIOUS MRZ MIDPOINT" : contactList + " + PREVIOUS MRZ MIDPOINT"
    contactList

f_mrzContextId() =>
    configuredTickerId + "|S|" + activeMrzSlot + "|C|" + str.tostring(currentActivationTime) + "|" + str.tostring(currentMrzLower, format.mintick) + "|" + str.tostring(currentMrzUpper, format.mintick) + "|P|" + str.tostring(previousActivationTime) + "|" + str.tostring(previousMrzLower, format.mintick) + "|" + str.tostring(previousMrzUpper, format.mintick)

f_mrzMigration() =>
    not currentMrzAvailable or not previousMrzAvailable ? "UNAVAILABLE" : currentMrzMidpoint > previousMrzMidpoint ? "HIGHER" : currentMrzMidpoint < previousMrzMidpoint ? "LOWER" : "COINCIDENT"

f_observerEqmReachedPayload(_encounterMechanism, _previousContact, _currentContact, _previousContactMask, _currentContactMask, _lastReachedAnchor, _previousReachedAnchor, _pathStep, _eqmContactCount, _observedAt) =>
    string payload = '{"alert":"' + f_alertSymbol() + ' · MIG EQM REACHED"'
    payload += ',"schema_version":"1.0"'
    payload += ',"event_type":"MRZ_EQM_REACHED"'
    payload += ',"symbol":"' + syminfo.tickerid + '"'
    payload += ',"mrz_context_id":"' + f_mrzContextId() + '"'
    payload += ',"encounter_mechanism":"' + _encounterMechanism + '"'
    payload += ',"active_mrz_slot":"' + activeMrzSlot + '"'
    payload += ',"current_mrz_lower":' + str.tostring(currentMrzLower, format.mintick)
    payload += ',"current_mrz_upper":' + str.tostring(currentMrzUpper, format.mintick)
    payload += ',"current_mrz_midpoint":' + str.tostring(currentMrzMidpoint, format.mintick)
    payload += ',"current_activation_time":' + str.tostring(currentActivationTime)
    payload += ',"previous_mrz_lower":' + str.tostring(previousMrzLower, format.mintick)
    payload += ',"previous_mrz_upper":' + str.tostring(previousMrzUpper, format.mintick)
    payload += ',"previous_mrz_midpoint":' + str.tostring(previousMrzMidpoint, format.mintick)
    payload += ',"previous_activation_time":' + str.tostring(previousActivationTime)
    payload += ',"migration_eqm":' + str.tostring(migrationEqm, format.mintick)
    payload += ',"mrz_migration":"' + f_mrzMigration() + '"'
    payload += ',"nearest_active_bsl_above":' + (na(nearestActiveBslAbove) ? "null" : str.tostring(nearestActiveBslAbove, format.mintick))
    payload += ',"nearest_active_ssl_below":' + (na(nearestActiveSslBelow) ? "null" : str.tostring(nearestActiveSslBelow, format.mintick))
    payload += ',"eqm_contact_count":' + str.tostring(_eqmContactCount)
    payload += ',"path_step":' + str.tostring(_pathStep)
    payload += ',"previous_contact":"' + _previousContact + '"'
    payload += ',"current_contact":"' + _currentContact + '"'
    payload += ',"previous_contact_mask":' + str.tostring(_previousContactMask)
    payload += ',"current_contact_mask":' + str.tostring(_currentContactMask)
    payload += ',"last_reached_anchor":"' + f_observerLastAnchorText(_lastReachedAnchor) + '"'
    payload += ',"previous_reached_anchor":"' + f_observerLastAnchorText(_previousReachedAnchor) + '"'
    payload += ',"timeframe":"' + timeframe.period + '"'
    payload += ',"observed_at":' + str.tostring(_observedAt)
    payload += ',"price":' + str.tostring(close, format.mintick) + '}'
    payload

f_observerEndpointEqmReachedPayload(_eventType, _alertLabel, _eqmAnchor, _anchorPrice, _armSide, _armLevel, _previousContact, _currentContact, _previousContactMask, _currentContactMask, _lastReachedAnchor, _previousReachedAnchor, _pathStep, _observedAt) =>
    string payload = '{"alert":"' + f_alertSymbol() + ' · ' + _alertLabel + '"'
    payload += ',"schema_version":"1.0"'
    payload += ',"event_type":"' + _eventType + '"'
    payload += ',"symbol":"' + syminfo.tickerid + '"'
    payload += ',"mrz_context_id":"' + f_mrzContextId() + '"'
    payload += ',"eqm_anchor":"' + _eqmAnchor + '"'
    payload += ',"encounter_mechanism":"2W_ARMED_RETURN"'
    payload += ',"arm_reference":"2W"'
    payload += ',"arm_side":"' + _armSide + '"'
    payload += ',"arm_level":' + str.tostring(_armLevel, format.mintick)
    payload += ',"anchor_price":' + str.tostring(_anchorPrice, format.mintick)
    payload += ',"active_mrz_slot":"' + activeMrzSlot + '"'
    payload += ',"current_mrz_lower":' + str.tostring(currentMrzLower, format.mintick)
    payload += ',"current_mrz_upper":' + str.tostring(currentMrzUpper, format.mintick)
    payload += ',"current_mrz_midpoint":' + str.tostring(currentMrzMidpoint, format.mintick)
    payload += ',"current_activation_time":' + str.tostring(currentActivationTime)
    payload += ',"previous_mrz_lower":' + str.tostring(previousMrzLower, format.mintick)
    payload += ',"previous_mrz_upper":' + str.tostring(previousMrzUpper, format.mintick)
    payload += ',"previous_mrz_midpoint":' + str.tostring(previousMrzMidpoint, format.mintick)
    payload += ',"previous_activation_time":' + str.tostring(previousActivationTime)
    payload += ',"migration_eqm":' + str.tostring(migrationEqm, format.mintick)
    payload += ',"mrz_migration":"' + f_mrzMigration() + '"'
    payload += ',"nearest_active_bsl_above":' + (na(nearestActiveBslAbove) ? "null" : str.tostring(nearestActiveBslAbove, format.mintick))
    payload += ',"nearest_active_ssl_below":' + (na(nearestActiveSslBelow) ? "null" : str.tostring(nearestActiveSslBelow, format.mintick))
    payload += ',"path_step":' + str.tostring(_pathStep)
    payload += ',"previous_contact":"' + _previousContact + '"'
    payload += ',"current_contact":"' + _currentContact + '"'
    payload += ',"previous_contact_mask":' + str.tostring(_previousContactMask)
    payload += ',"current_contact_mask":' + str.tostring(_currentContactMask)
    payload += ',"last_reached_anchor":"' + f_observerLastAnchorText(_lastReachedAnchor) + '"'
    payload += ',"previous_reached_anchor":"' + f_observerLastAnchorText(_previousReachedAnchor) + '"'
    payload += ',"timeframe":"' + timeframe.period + '"'
    payload += ',"observed_at":' + str.tostring(_observedAt)
    payload += ',"price":' + str.tostring(close, format.mintick) + '}'
    payload

bool stateObserverGeometryAvailable = enableStateTransitionObserver and activeDealingRangeAvailable and currentMrzWidth > 0

int observerUpperAdjacentAnchor = OBS_ANCHOR_NONE
float observerUpperAdjacentPrice = na
int observerLowerAdjacentAnchor = OBS_ANCHOR_NONE
float observerLowerAdjacentPrice = na

if stateObserverGeometryAvailable
    if currentMrzMidpoint > close
        observerUpperAdjacentAnchor := OBS_ANCHOR_CURRENT_MIDPOINT
        observerUpperAdjacentPrice := currentMrzMidpoint
    if migrationEqm > close
        if na(observerUpperAdjacentPrice) or migrationEqm < observerUpperAdjacentPrice
            observerUpperAdjacentAnchor := OBS_ANCHOR_MIGRATION_EQM
            observerUpperAdjacentPrice := migrationEqm
        else if migrationEqm == observerUpperAdjacentPrice
            observerUpperAdjacentAnchor := OBS_ANCHOR_MULTIPLE
    if previousMrzMidpoint > close
        if na(observerUpperAdjacentPrice) or previousMrzMidpoint < observerUpperAdjacentPrice
            observerUpperAdjacentAnchor := OBS_ANCHOR_PREVIOUS_MIDPOINT
            observerUpperAdjacentPrice := previousMrzMidpoint
        else if previousMrzMidpoint == observerUpperAdjacentPrice
            observerUpperAdjacentAnchor := OBS_ANCHOR_MULTIPLE

    if currentMrzMidpoint < close
        observerLowerAdjacentAnchor := OBS_ANCHOR_CURRENT_MIDPOINT
        observerLowerAdjacentPrice := currentMrzMidpoint
    if migrationEqm < close
        if na(observerLowerAdjacentPrice) or migrationEqm > observerLowerAdjacentPrice
            observerLowerAdjacentAnchor := OBS_ANCHOR_MIGRATION_EQM
            observerLowerAdjacentPrice := migrationEqm
        else if migrationEqm == observerLowerAdjacentPrice
            observerLowerAdjacentAnchor := OBS_ANCHOR_MULTIPLE
    if previousMrzMidpoint < close
        if na(observerLowerAdjacentPrice) or previousMrzMidpoint > observerLowerAdjacentPrice
            observerLowerAdjacentAnchor := OBS_ANCHOR_PREVIOUS_MIDPOINT
            observerLowerAdjacentPrice := previousMrzMidpoint
        else if previousMrzMidpoint == observerLowerAdjacentPrice
            observerLowerAdjacentAnchor := OBS_ANCHOR_MULTIPLE

string observerPriceRegion = stateObserverGeometryAvailable ? f_observerPriceRegion(close, currentMrzLower, currentMrzUpper, currentMrzMidpoint, migrationEqm, previousMrzLower, previousMrzUpper, previousMrzMidpoint) : "UNAVAILABLE"
// These panel fields expose deterministic structural context so downstream
// discretionary analysis does not need to re-derive known facts.
string observerMrzMigration = f_mrzMigration()
string observerIpda20Zone = not ipda20Ready or na(close) ? "UNAVAILABLE" : close < ipda20Low ? "BELOW 20W LOW" : close < ipda20Quarter ? "DEEP DISCOUNT" : close < ipda20Eqm ? "SHALLOW DISCOUNT" : close < ipda20ThreeQuarter ? "SHALLOW PREMIUM" : close <= ipda20High ? "DEEP PREMIUM" : "ABOVE 20W HIGH"

var int observerState = OBS_STATE_PRE_ACTIVATION
var int observerLastReachedAnchor = OBS_ANCHOR_NONE
var int observerPreviousReachedAnchor = OBS_ANCHOR_NONE
var int observerLastContactMask = 0
var string observerLastContactSummary = "NONE"
var int observerLastReachedAt = na
var int observerLastReachedBar = na
var int observerObservedPathSteps = 0
var int observerEqmDistinctContactCount = 0
var bool observerCurrentMidContactActive = false
var bool observerEqmContactActive = false
var bool observerPreviousMidContactActive = false
var bool observerStructureIdentityStored = false
var string observerStoredActiveMrzSlot = ""
var string observerStoredTickerId = ""
var float observerStoredCurrentLower = na
var float observerStoredCurrentUpper = na
var int observerStoredCurrentActivation = na
var float observerStoredPreviousLower = na
var float observerStoredPreviousUpper = na
var int observerStoredPreviousActivation = na
var label[] observerStateLabels = array.new_label()

// CUR/PRE EQM attention events use their owning MRZ ±2W envelope as a re-arm.
// A confirmed candle range reaching either ±2W arms the midpoint for one later
// clean midpoint contact. The arm is consumed until another ±2W excursion.
var bool observerCurrentEqmArmed = false
var string observerCurrentEqmArmSide = "NONE"
var float observerCurrentEqmArmLevel = na
var bool observerPreviousEqmArmed = false
var string observerPreviousEqmArmSide = "NONE"
var float observerPreviousEqmArmLevel = na

bool observerCurrentMidReachedEvent = false
bool observerEqmReachedEvent = false
bool observerPreviousMidReachedEvent = false
bool observerMultiAnchorContactEvent = false
bool observerAttentionTransition = false
bool observerEqmEncounterEvent = false
int observerPriorContactMaskForEvent = 0
string observerPriorContactSummaryForEvent = "NONE"
string observerContactSummary = ""
string observerEqmEncounterMechanism = "NONE"
float observerMultiAnchorLabelPrice = na
bool observerCurrentEqmReachedAttentionEvent = false
bool observerPreviousEqmReachedAttentionEvent = false
string observerCurrentEqmArmSideForEvent = "NONE"
float observerCurrentEqmArmLevelForEvent = na
string observerPreviousEqmArmSideForEvent = "NONE"
float observerPreviousEqmArmLevelForEvent = na

bool observerStructureChanged = stateObserverGeometryAvailable and (not observerStructureIdentityStored or observerStoredActiveMrzSlot != activeMrzSlot or observerStoredTickerId != configuredTickerId or observerStoredCurrentLower != currentMrzLower or observerStoredCurrentUpper != currentMrzUpper or observerStoredCurrentActivation != currentActivationTime or observerStoredPreviousLower != previousMrzLower or observerStoredPreviousUpper != previousMrzUpper or observerStoredPreviousActivation != previousActivationTime)

if not stateObserverGeometryAvailable
    observerState := OBS_STATE_PRE_ACTIVATION
    observerLastReachedAnchor := OBS_ANCHOR_NONE
    observerPreviousReachedAnchor := OBS_ANCHOR_NONE
    observerLastContactMask := 0
    observerLastContactSummary := "NONE"
    observerLastReachedAt := na
    observerLastReachedBar := na
    observerObservedPathSteps := 0
    observerEqmDistinctContactCount := 0
    observerCurrentMidContactActive := false
    observerEqmContactActive := false
    observerPreviousMidContactActive := false
    observerStructureIdentityStored := false
    observerStoredActiveMrzSlot := ""
    observerStoredTickerId := ""
    observerStoredCurrentLower := na
    observerStoredCurrentUpper := na
    observerStoredCurrentActivation := na
    observerStoredPreviousLower := na
    observerStoredPreviousUpper := na
    observerStoredPreviousActivation := na
    observerCurrentEqmArmed := false
    observerCurrentEqmArmSide := "NONE"
    observerCurrentEqmArmLevel := na
    observerPreviousEqmArmed := false
    observerPreviousEqmArmSide := "NONE"
    observerPreviousEqmArmLevel := na
    while array.size(observerStateLabels) > 0
        label inactiveObserverLabel = array.shift(observerStateLabels)
        if not na(inactiveObserverLabel)
            label.delete(inactiveObserverLabel)
else if barstate.isconfirmed
    bool observerCurrentMidContactOnBar = low <= currentMrzMidpoint and high >= currentMrzMidpoint
    bool observerEqmContactOnBar = low <= migrationEqm and high >= migrationEqm
    bool observerPreviousMidContactOnBar = low <= previousMrzMidpoint and high >= previousMrzMidpoint
    bool observerCurrentUpper2WReachedOnBar = high >= currentPlus2W
    bool observerCurrentLower2WReachedOnBar = low <= currentMinus2W
    bool observerPreviousUpper2WReachedOnBar = high >= previousPlus2W
    bool observerPreviousLower2WReachedOnBar = low <= previousMinus2W

    if observerStructureChanged
        // Start the new structure prospectively. Contacts on this reset bar are
        // baselined, not emitted or inferred from price's existing location.
        observerState := OBS_STATE_OBSERVE_ANCHORS
        observerLastReachedAnchor := OBS_ANCHOR_NONE
        observerPreviousReachedAnchor := OBS_ANCHOR_NONE
        observerLastContactMask := 0
        observerLastContactSummary := "NONE"
        observerLastReachedAt := na
        observerLastReachedBar := na
        observerObservedPathSteps := 0
        observerEqmDistinctContactCount := 0
        observerCurrentMidContactActive := observerCurrentMidContactOnBar
        observerEqmContactActive := observerEqmContactOnBar
        observerPreviousMidContactActive := observerPreviousMidContactOnBar
        observerStructureIdentityStored := true
        observerStoredActiveMrzSlot := activeMrzSlot
        observerStoredTickerId := configuredTickerId
        observerStoredCurrentLower := currentMrzLower
        observerStoredCurrentUpper := currentMrzUpper
        observerStoredCurrentActivation := currentActivationTime
        observerStoredPreviousLower := previousMrzLower
        observerStoredPreviousUpper := previousMrzUpper
        observerStoredPreviousActivation := previousActivationTime
        observerCurrentEqmArmed := false
        observerCurrentEqmArmSide := "NONE"
        observerCurrentEqmArmLevel := na
        observerPreviousEqmArmed := false
        observerPreviousEqmArmSide := "NONE"
        observerPreviousEqmArmLevel := na
        while array.size(observerStateLabels) > 0
            label oldStructureObserverLabel = array.shift(observerStateLabels)
            if not na(oldStructureObserverLabel)
                label.delete(oldStructureObserverLabel)
    else
        if observerState == OBS_STATE_PRE_ACTIVATION
            observerState := OBS_STATE_OBSERVE_ANCHORS

        bool observerCurrentMidContactStarted = observerCurrentMidContactOnBar and not observerCurrentMidContactActive
        bool observerEqmContactStarted = observerEqmContactOnBar and not observerEqmContactActive
        bool observerPreviousMidContactStarted = observerPreviousMidContactOnBar and not observerPreviousMidContactActive
        // A wholly opposite-side bar following a confirmed close across EQM is
        // an encounter even when neither candle range contains the EQM price.
        bool observerEqmGapCrossFromBelow = not observerEqmContactActive and not na(close[1]) and close[1] < migrationEqm and low > migrationEqm
        bool observerEqmGapCrossFromAbove = not observerEqmContactActive and not na(close[1]) and close[1] > migrationEqm and high < migrationEqm
        bool observerEqmGapCross = not observerEqmContactOnBar and (observerEqmGapCrossFromBelow or observerEqmGapCrossFromAbove)
        bool observerEqmEncounterStarted = observerEqmContactStarted or observerEqmGapCross
        int observerAnchorContactsStarted = (observerCurrentMidContactStarted ? 1 : 0) + (observerEqmEncounterStarted ? 1 : 0) + (observerPreviousMidContactStarted ? 1 : 0)

        if observerAnchorContactsStarted > 0
            int observerNewContactMask = (observerCurrentMidContactStarted ? OBS_CONTACT_CURRENT_MIDPOINT : 0) + (observerEqmEncounterStarted ? OBS_CONTACT_MIGRATION_EQM : 0) + (observerPreviousMidContactStarted ? OBS_CONTACT_PREVIOUS_MIDPOINT : 0)
            observerPriorContactMaskForEvent := observerLastContactMask
            observerPriorContactSummaryForEvent := observerLastContactSummary
            observerAttentionTransition := observerPriorContactMaskForEvent == 0 or observerNewContactMask != observerPriorContactMaskForEvent
            observerPreviousReachedAnchor := observerLastReachedAnchor
            observerLastReachedAnchor := observerAnchorContactsStarted > 1 ? OBS_ANCHOR_MULTIPLE : observerCurrentMidContactStarted ? OBS_ANCHOR_CURRENT_MIDPOINT : observerEqmEncounterStarted ? OBS_ANCHOR_MIGRATION_EQM : OBS_ANCHOR_PREVIOUS_MIDPOINT
            observerLastContactMask := observerNewContactMask
            observerLastReachedAt := time_close
            observerLastReachedBar := bar_index
            observerObservedPathSteps += 1
            if observerEqmEncounterStarted
                observerEqmDistinctContactCount += 1
                observerEqmEncounterEvent := true
                observerEqmEncounterMechanism := observerEqmGapCross ? "GAP_CROSS" : "NORMAL_CONTACT"
            observerContactSummary := f_observerContactList(observerCurrentMidContactStarted, observerEqmEncounterStarted, observerPreviousMidContactStarted)
            observerLastContactSummary := observerContactSummary
            observerCurrentMidReachedEvent := observerAnchorContactsStarted == 1 and observerCurrentMidContactStarted
            observerEqmReachedEvent := observerAnchorContactsStarted == 1 and observerEqmEncounterStarted
            observerPreviousMidReachedEvent := observerAnchorContactsStarted == 1 and observerPreviousMidContactStarted
            observerMultiAnchorContactEvent := observerAnchorContactsStarted > 1
            if observerMultiAnchorContactEvent
                float contactedLow = observerCurrentMidContactStarted ? currentMrzMidpoint : observerEqmEncounterStarted ? migrationEqm : previousMrzMidpoint
                float contactedHigh = contactedLow
                if observerEqmEncounterStarted
                    contactedLow := math.min(contactedLow, migrationEqm)
                    contactedHigh := math.max(contactedHigh, migrationEqm)
                if observerPreviousMidContactStarted
                    contactedLow := math.min(contactedLow, previousMrzMidpoint)
                    contactedHigh := math.max(contactedHigh, previousMrzMidpoint)
                observerMultiAnchorLabelPrice := math.round_to_mintick((contactedLow + contactedHigh) / 2.0)

        // CUR / PRE EQM attention lifecycle.
        // Consume an existing arm on the first later clean single-anchor midpoint contact.
        if observerCurrentMidReachedEvent and observerCurrentEqmArmed
            observerCurrentEqmReachedAttentionEvent := true
            observerCurrentEqmArmSideForEvent := observerCurrentEqmArmSide
            observerCurrentEqmArmLevelForEvent := observerCurrentEqmArmLevel

        if observerPreviousMidReachedEvent and observerPreviousEqmArmed
            observerPreviousEqmReachedAttentionEvent := true
            observerPreviousEqmArmSideForEvent := observerPreviousEqmArmSide
            observerPreviousEqmArmLevelForEvent := observerPreviousEqmArmLevel

        if observerCurrentEqmReachedAttentionEvent
            observerCurrentEqmArmed := false
            observerCurrentEqmArmSide := "NONE"
            observerCurrentEqmArmLevel := na
        else
            // Do not arm from a bar that also contacts CUR EQM: intrabar ordering is unknowable.
            bool observerCurrentEqmArmCandidate = not observerCurrentMidContactOnBar and (observerCurrentUpper2WReachedOnBar or observerCurrentLower2WReachedOnBar)
            if observerCurrentEqmArmCandidate
                observerCurrentEqmArmed := true
                if observerCurrentUpper2WReachedOnBar
                    observerCurrentEqmArmSide := "UPPER"
                    observerCurrentEqmArmLevel := currentPlus2W
                else
                    observerCurrentEqmArmSide := "LOWER"
                    observerCurrentEqmArmLevel := currentMinus2W

        if observerPreviousEqmReachedAttentionEvent
            observerPreviousEqmArmed := false
            observerPreviousEqmArmSide := "NONE"
            observerPreviousEqmArmLevel := na
        else
            // Do not arm from a bar that also contacts PRE EQM: intrabar ordering is unknowable.
            bool observerPreviousEqmArmCandidate = not observerPreviousMidContactOnBar and (observerPreviousUpper2WReachedOnBar or observerPreviousLower2WReachedOnBar)
            if observerPreviousEqmArmCandidate
                observerPreviousEqmArmed := true
                if observerPreviousUpper2WReachedOnBar
                    observerPreviousEqmArmSide := "UPPER"
                    observerPreviousEqmArmLevel := previousPlus2W
                else
                    observerPreviousEqmArmSide := "LOWER"
                    observerPreviousEqmArmLevel := previousMinus2W

        observerCurrentMidContactActive := observerCurrentMidContactOnBar
        observerEqmContactActive := observerEqmContactOnBar
        observerPreviousMidContactActive := observerPreviousMidContactOnBar

bool observerTransitionedIntoEqm = observerEqmEncounterEvent and observerPreviousReachedAnchor != OBS_ANCHOR_MIGRATION_EQM and observerLastReachedAnchor == OBS_ANCHOR_MIGRATION_EQM

if observerTransitionedIntoEqm and showStateTransitionLabels
    string observerEqmTooltip = "Path Step: " + str.tostring(observerObservedPathSteps) + "\nEvent: MIG EQM REACHED\nTimestamp: " + f_observerTimeText(observerLastReachedAt) + "\nContact: " + observerContactSummary + "\nPrior Contact: " + observerPriorContactSummaryForEvent + "\nPrior Reached Anchor: " + f_observerLastAnchorText(observerPreviousReachedAnchor) + "\nAnchor: " + f_observerPriceText(migrationEqm)
    bool observerEqmLabelAbove = migrationEqm >= close
    label observerEqmLabel = label.new(bar_index, observerEqmLabelAbove ? high : low, "MIG EQM", xloc = xloc.bar_index, style = observerEqmLabelAbove ? label.style_label_down : label.style_label_up, color = color.new(color.purple, 15), textcolor = color.white, size = size.tiny, tooltip = observerEqmTooltip)
    array.push(observerStateLabels, observerEqmLabel)

if enableEqmReachedAlerts and observerTransitionedIntoEqm and barstate.isconfirmed
    alert(f_observerEqmReachedPayload(observerEqmEncounterMechanism, observerPriorContactSummaryForEvent, observerContactSummary, observerPriorContactMaskForEvent, observerLastContactMask, observerLastReachedAnchor, observerPreviousReachedAnchor, observerObservedPathSteps, observerEqmDistinctContactCount, observerLastReachedAt), alert.freq_once_per_bar_close)

if observerCurrentEqmReachedAttentionEvent and showStateTransitionLabels
    string observerCurrentEqmTooltip = "Event: CURRENT_EQM_REACHED\nTimestamp: " + f_observerTimeText(observerLastReachedAt) + "\nAnchor: " + f_observerPriceText(currentMrzMidpoint) + "\nArmed By: " + observerCurrentEqmArmSideForEvent + " 2W\n2W Level: " + f_observerPriceText(observerCurrentEqmArmLevelForEvent) + "\nPath Step: " + str.tostring(observerObservedPathSteps)
    bool observerCurrentEqmLabelAbove = currentMrzMidpoint >= close
    label observerCurrentEqmLabel = label.new(bar_index, observerCurrentEqmLabelAbove ? high : low, "CUR EQM", xloc = xloc.bar_index, style = observerCurrentEqmLabelAbove ? label.style_label_down : label.style_label_up, color = color.new(color.purple, 15), textcolor = color.white, size = size.tiny, tooltip = observerCurrentEqmTooltip)
    array.push(observerStateLabels, observerCurrentEqmLabel)

if observerPreviousEqmReachedAttentionEvent and showStateTransitionLabels
    string observerPreviousEqmTooltip = "Event: PREVIOUS_EQM_REACHED\nTimestamp: " + f_observerTimeText(observerLastReachedAt) + "\nAnchor: " + f_observerPriceText(previousMrzMidpoint) + "\nArmed By: " + observerPreviousEqmArmSideForEvent + " 2W\n2W Level: " + f_observerPriceText(observerPreviousEqmArmLevelForEvent) + "\nPath Step: " + str.tostring(observerObservedPathSteps)
    bool observerPreviousEqmLabelAbove = previousMrzMidpoint >= close
    label observerPreviousEqmLabel = label.new(bar_index, observerPreviousEqmLabelAbove ? high : low, "PRE EQM", xloc = xloc.bar_index, style = observerPreviousEqmLabelAbove ? label.style_label_down : label.style_label_up, color = color.new(color.gray, 15), textcolor = color.white, size = size.tiny, tooltip = observerPreviousEqmTooltip)
    array.push(observerStateLabels, observerPreviousEqmLabel)

if enableEqmReachedAlerts and observerCurrentEqmReachedAttentionEvent and barstate.isconfirmed
    alert(f_observerEndpointEqmReachedPayload("CURRENT_EQM_REACHED", "CUR EQM REACHED", "CURRENT", currentMrzMidpoint, observerCurrentEqmArmSideForEvent, observerCurrentEqmArmLevelForEvent, observerPriorContactSummaryForEvent, observerContactSummary, observerPriorContactMaskForEvent, observerLastContactMask, observerLastReachedAnchor, observerPreviousReachedAnchor, observerObservedPathSteps, observerLastReachedAt), alert.freq_once_per_bar_close)

if enableEqmReachedAlerts and observerPreviousEqmReachedAttentionEvent and barstate.isconfirmed
    alert(f_observerEndpointEqmReachedPayload("PREVIOUS_EQM_REACHED", "PRE EQM REACHED", "PREVIOUS", previousMrzMidpoint, observerPreviousEqmArmSideForEvent, observerPreviousEqmArmLevelForEvent, observerPriorContactSummaryForEvent, observerContactSummary, observerPriorContactMaskForEvent, observerLastContactMask, observerLastReachedAnchor, observerPreviousReachedAnchor, observerObservedPathSteps, observerLastReachedAt), alert.freq_once_per_bar_close)

while array.size(observerStateLabels) > MAX_STATE_OBSERVER_LABELS
    label oldestObserverLabel = array.shift(observerStateLabels)
    if not na(oldestObserverLabel)
        label.delete(oldestObserverLabel)

var table stateObserverPanel = table.new(position.bottom_right, 2, 14)
if barstate.islast and showStateDebugPanel
    color observerPanelBackground = color.new(color.black, 18)
    color observerPanelLabelColor = color.new(color.silver, 0)
    table.cell(stateObserverPanel, 0, 0, "Observer Status", text_color = observerPanelLabelColor, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 1, 0, f_observerStateText(observerState), text_color = color.white, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 0, 1, "MRZ Migration", text_color = observerPanelLabelColor, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 1, 1, observerMrzMigration, text_color = color.white, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 0, 2, "IPDA 20W Zone", text_color = observerPanelLabelColor, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 1, 2, observerIpda20Zone, text_color = color.white, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 0, 3, "Price Region", text_color = observerPanelLabelColor, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 1, 3, observerPriceRegion, text_color = color.white, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 0, 4, "Upper Anchor", text_color = observerPanelLabelColor, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 1, 4, f_observerAdjacentText(observerUpperAdjacentAnchor, observerUpperAdjacentPrice), text_color = color.white, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 0, 5, "Lower Anchor", text_color = observerPanelLabelColor, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 1, 5, f_observerAdjacentText(observerLowerAdjacentAnchor, observerLowerAdjacentPrice), text_color = color.white, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 0, 6, "Last Reached Anchor", text_color = observerPanelLabelColor, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 1, 6, f_observerLastAnchorText(observerLastReachedAnchor), text_color = color.white, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 0, 7, "Previous Reached Anchor", text_color = observerPanelLabelColor, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 1, 7, f_observerLastAnchorText(observerPreviousReachedAnchor), text_color = color.white, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 0, 8, "Path Step #", text_color = observerPanelLabelColor, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 1, 8, str.tostring(observerObservedPathSteps), text_color = color.white, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 0, 9, "Distinct EQM Contacts", text_color = observerPanelLabelColor, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 1, 9, str.tostring(observerEqmDistinctContactCount), text_color = color.white, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 0, 10, "Last Contact At", text_color = observerPanelLabelColor, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 1, 10, f_observerPanelTimeText(observerLastReachedAt), text_color = color.white, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 0, 11, "Last Contact", text_color = observerPanelLabelColor, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 1, 11, observerLastContactSummary, text_color = color.white, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 0, 12, "Nearest Active BSL", text_color = observerPanelLabelColor, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 1, 12, f_observerPriceText(nearestActiveBslAbove), text_color = color.white, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 0, 13, "Nearest Active SSL", text_color = observerPanelLabelColor, bgcolor = observerPanelBackground)
    table.cell(stateObserverPanel, 1, 13, f_observerPriceText(nearestActiveSslBelow), text_color = color.white, bgcolor = observerPanelBackground)

color currentUpperColor = color.rgb(214, 80, 80)
color currentMidpointColor = color.new(color.purple, 0)
color currentLowerColor = color.rgb(65, 145, 220)
color migrationEqmColor = color.new(color.rgb(142, 109, 201), 0)
color eqmProximalBoundaryColor = color.new(migrationEqmColor, 65)
color eqmProximalZoneColor = color.new(migrationEqmColor, 90)
color previousBoundaryColor = color.new(color.gray, 45)
color previousMidpointColor = color.new(color.silver, 0)
color previousEnvelopeColor = color.new(color.gray, 60)
color currentZoneColor = color.new(currentMidpointColor, 95)
color previousZoneColor = color.new(color.gray, 95)

currentUpperPlot = plot(currentPlotVisible ? currentMrzUpper : na, "Current MRZ Upper", color = currentUpperColor, linewidth = 1, style = plot.style_linebr)
plot(currentPlotVisible ? currentMrzMidpoint : na, "Current MRZ Midpoint", color = currentMidpointColor, linewidth = 1, style = plot.style_linebr)
currentLowerPlot = plot(currentPlotVisible ? currentMrzLower : na, "Current MRZ Lower", color = currentLowerColor, linewidth = 1, style = plot.style_linebr)
fill(currentUpperPlot, currentLowerPlot, color = currentZoneColor, title = "Current MRZ Zone", fillgaps = false)

plot(currentEnvelopePlotVisible ? currentPlus1W : na, "Current MRZ +1W", color = color.new(currentUpperColor, 0), linewidth = 1, style = plot.style_linebr)
plot(currentEnvelopePlotVisible ? currentPlus2W : na, "Current MRZ +2W", color = color.new(currentUpperColor, 28), linewidth = 2, style = plot.style_linebr)
plot(currentEnvelopePlotVisible ? currentMinus1W : na, "Current MRZ -1W", color = color.new(currentLowerColor, 0), linewidth = 1, style = plot.style_linebr)
plot(currentEnvelopePlotVisible ? currentMinus2W : na, "Current MRZ -2W", color = color.new(currentLowerColor, 28), linewidth = 2, style = plot.style_linebr)

eqmProximalLowPlot = plot(eqmProximalZonePlotVisible ? eqmProximalZoneLow : na, "MRZ EQM Proximal Low", color = eqmProximalBoundaryColor, linewidth = 1, style = plot.style_linebr)
eqmProximalHighPlot = plot(eqmProximalZonePlotVisible ? eqmProximalZoneHigh : na, "MRZ EQM Proximal High", color = eqmProximalBoundaryColor, linewidth = 1, style = plot.style_linebr)
fill(eqmProximalLowPlot, eqmProximalHighPlot, color = eqmProximalZoneColor, title = "MRZ EQM Proximal Zone", fillgaps = false)
plot(migrationEqmPlotVisible ? migrationEqm : na, "Migration EQM", color = migrationEqmColor, linewidth = 1, style = plot.style_linebr)
previousUpperPlot = plot(previousPlotVisible ? previousMrzUpper : na, "Previous MRZ Upper", color = previousBoundaryColor, linewidth = 1, style = plot.style_linebr)
plot(previousPlotVisible ? previousMrzMidpoint : na, "Previous MRZ Midpoint", color = previousMidpointColor, linewidth = 1, style = plot.style_linebr)
previousLowerPlot = plot(previousPlotVisible ? previousMrzLower : na, "Previous MRZ Lower", color = previousBoundaryColor, linewidth = 1, style = plot.style_linebr)
fill(previousUpperPlot, previousLowerPlot, color = previousZoneColor, title = "Previous MRZ Zone", fillgaps = false)

plot(previousEnvelopePlotVisible ? previousPlus1W : na, "Previous MRZ +1W", color = previousEnvelopeColor, linewidth = 1, style = plot.style_linebr)
plot(previousEnvelopePlotVisible ? previousPlus2W : na, "Previous MRZ +2W", color = previousEnvelopeColor, linewidth = 2, style = plot.style_linebr)
plot(previousEnvelopePlotVisible ? previousMinus1W : na, "Previous MRZ -1W", color = previousEnvelopeColor, linewidth = 1, style = plot.style_linebr)
plot(previousEnvelopePlotVisible ? previousMinus2W : na, "Previous MRZ -2W", color = previousEnvelopeColor, linewidth = 2, style = plot.style_linebr)

// ──────────────────────────────────────────────────────────────────────────────
// IPDA 20W DISPLAY
// Uses persistent objects so the merged MRZ display does not recreate objects on
// every last-bar update. Price levels come directly from the standalone IPDA logic.
// ──────────────────────────────────────────────────────────────────────────────
var line ipda20HighLine = na
var line ipda20ThreeQuarterLine = na
var line ipda20EqmLine = na
var line ipda20QuarterLine = na
var line ipda20LowLine = na

var label ipda20HighLabel = na
var label ipda20ThreeQuarterLabel = na
var label ipda20EqmLabel = na
var label ipda20QuarterLabel = na
var label ipda20LowLabel = na

if barstate.islast
    int ipda20RightTime = na(time[1]) ? time : time[1]

    if ipda20Visible
        if na(ipda20HighLine)
            ipda20HighLine := line.new(ipda20Time, ipda20High, ipda20RightTime, ipda20High, xloc = xloc.bar_time, color = ipdaPremiumColor, width = 1, extend = extend.right)
        else
            line.set_xy1(ipda20HighLine, ipda20Time, ipda20High)
            line.set_xy2(ipda20HighLine, ipda20RightTime, ipda20High)
            line.set_color(ipda20HighLine, ipdaPremiumColor)

        if na(ipda20ThreeQuarterLine)
            ipda20ThreeQuarterLine := line.new(ipda20Time, ipda20ThreeQuarter, ipda20RightTime, ipda20ThreeQuarter, xloc = xloc.bar_time, color = ipdaHalfZoneColor, width = 1, style = line.style_dashed, extend = extend.right)
        else
            line.set_xy1(ipda20ThreeQuarterLine, ipda20Time, ipda20ThreeQuarter)
            line.set_xy2(ipda20ThreeQuarterLine, ipda20RightTime, ipda20ThreeQuarter)
            line.set_color(ipda20ThreeQuarterLine, ipdaHalfZoneColor)
            line.set_style(ipda20ThreeQuarterLine, line.style_dashed)

        if na(ipda20EqmLine)
            ipda20EqmLine := line.new(ipda20Time, ipda20Eqm, ipda20RightTime, ipda20Eqm, xloc = xloc.bar_time, color = ipdaEquilibriumColor, width = 1, extend = extend.right)
        else
            line.set_xy1(ipda20EqmLine, ipda20Time, ipda20Eqm)
            line.set_xy2(ipda20EqmLine, ipda20RightTime, ipda20Eqm)
            line.set_color(ipda20EqmLine, ipdaEquilibriumColor)

        if na(ipda20QuarterLine)
            ipda20QuarterLine := line.new(ipda20Time, ipda20Quarter, ipda20RightTime, ipda20Quarter, xloc = xloc.bar_time, color = ipdaHalfZoneColor, width = 1, style = line.style_dashed, extend = extend.right)
        else
            line.set_xy1(ipda20QuarterLine, ipda20Time, ipda20Quarter)
            line.set_xy2(ipda20QuarterLine, ipda20RightTime, ipda20Quarter)
            line.set_color(ipda20QuarterLine, ipdaHalfZoneColor)
            line.set_style(ipda20QuarterLine, line.style_dashed)

        if na(ipda20LowLine)
            ipda20LowLine := line.new(ipda20Time, ipda20Low, ipda20RightTime, ipda20Low, xloc = xloc.bar_time, color = ipdaDiscountColor, width = 1, extend = extend.right)
        else
            line.set_xy1(ipda20LowLine, ipda20Time, ipda20Low)
            line.set_xy2(ipda20LowLine, ipda20RightTime, ipda20Low)
            line.set_color(ipda20LowLine, ipdaDiscountColor)

        if showIpda20Labels
            if na(ipda20HighLabel)
                ipda20HighLabel := label.new(last_bar_index, ipda20High, "20w hi", xloc = xloc.bar_index, yloc = yloc.price, color = na, style = label.style_label_left, textcolor = ipdaPremiumColor, textalign = text.align_right, tooltip = "ipda20 premium")
            else
                label.set_x(ipda20HighLabel, last_bar_index)
                label.set_y(ipda20HighLabel, ipda20High)
                label.set_textcolor(ipda20HighLabel, ipdaPremiumColor)

            if na(ipda20ThreeQuarterLabel)
                ipda20ThreeQuarterLabel := label.new(last_bar_index, ipda20ThreeQuarter, "20w 0.75", xloc = xloc.bar_index, yloc = yloc.price, color = na, style = label.style_label_left, textcolor = ipdaHalfZoneColor, textalign = text.align_right, tooltip = "ipda20 upper half premium")
            else
                label.set_x(ipda20ThreeQuarterLabel, last_bar_index)
                label.set_y(ipda20ThreeQuarterLabel, ipda20ThreeQuarter)
                label.set_textcolor(ipda20ThreeQuarterLabel, ipdaHalfZoneColor)

            if na(ipda20EqmLabel)
                ipda20EqmLabel := label.new(last_bar_index, ipda20Eqm, "20w eqm", xloc = xloc.bar_index, yloc = yloc.price, color = na, style = label.style_label_left, textcolor = ipdaEquilibriumColor, textalign = text.align_right, tooltip = "ipda20 eqm")
            else
                label.set_x(ipda20EqmLabel, last_bar_index)
                label.set_y(ipda20EqmLabel, ipda20Eqm)
                label.set_textcolor(ipda20EqmLabel, ipdaEquilibriumColor)

            if na(ipda20QuarterLabel)
                ipda20QuarterLabel := label.new(last_bar_index, ipda20Quarter, "20w 0.25", xloc = xloc.bar_index, yloc = yloc.price, color = na, style = label.style_label_left, textcolor = ipdaHalfZoneColor, textalign = text.align_right, tooltip = "ipda20 lower half discount")
            else
                label.set_x(ipda20QuarterLabel, last_bar_index)
                label.set_y(ipda20QuarterLabel, ipda20Quarter)
                label.set_textcolor(ipda20QuarterLabel, ipdaHalfZoneColor)

            if na(ipda20LowLabel)
                ipda20LowLabel := label.new(last_bar_index, ipda20Low, "20w lo", xloc = xloc.bar_index, yloc = yloc.price, color = na, style = label.style_label_left, textcolor = ipdaDiscountColor, textalign = text.align_right, tooltip = "ipda20 discount")
            else
                label.set_x(ipda20LowLabel, last_bar_index)
                label.set_y(ipda20LowLabel, ipda20Low)
                label.set_textcolor(ipda20LowLabel, ipdaDiscountColor)
        else
            if not na(ipda20HighLabel)
                label.delete(ipda20HighLabel)
                ipda20HighLabel := na
            if not na(ipda20ThreeQuarterLabel)
                label.delete(ipda20ThreeQuarterLabel)
                ipda20ThreeQuarterLabel := na
            if not na(ipda20EqmLabel)
                label.delete(ipda20EqmLabel)
                ipda20EqmLabel := na
            if not na(ipda20QuarterLabel)
                label.delete(ipda20QuarterLabel)
                ipda20QuarterLabel := na
            if not na(ipda20LowLabel)
                label.delete(ipda20LowLabel)
                ipda20LowLabel := na
    else
        if not na(ipda20HighLine)
            line.delete(ipda20HighLine)
            ipda20HighLine := na
        if not na(ipda20ThreeQuarterLine)
            line.delete(ipda20ThreeQuarterLine)
            ipda20ThreeQuarterLine := na
        if not na(ipda20EqmLine)
            line.delete(ipda20EqmLine)
            ipda20EqmLine := na
        if not na(ipda20QuarterLine)
            line.delete(ipda20QuarterLine)
            ipda20QuarterLine := na
        if not na(ipda20LowLine)
            line.delete(ipda20LowLine)
            ipda20LowLine := na
        if not na(ipda20HighLabel)
            label.delete(ipda20HighLabel)
            ipda20HighLabel := na
        if not na(ipda20ThreeQuarterLabel)
            label.delete(ipda20ThreeQuarterLabel)
            ipda20ThreeQuarterLabel := na
        if not na(ipda20EqmLabel)
            label.delete(ipda20EqmLabel)
            ipda20EqmLabel := na
        if not na(ipda20QuarterLabel)
            label.delete(ipda20QuarterLabel)
            ipda20QuarterLabel := na
        if not na(ipda20LowLabel)
            label.delete(ipda20LowLabel)
            ipda20LowLabel := na

// One confirmed proximal displacement creates at most one persistent CE entry.
// Stage A retains factual evidence independently from Stage B object visibility.
var line[] proximalDisplacementCeLines = array.new_line()
var float[] proximalDisplacementCeLevels = array.new_float()
var int[] proximalDisplacementCreationBars = array.new_int()
var int[] proximalDisplacementDirections = array.new_int()
var bool[] proximalDisplacementMitigated = array.new_bool()
var int lastProximalDisplacementBar = na

bool displacementBarNotRegistered = na(lastProximalDisplacementBar) or bar_index != lastProximalDisplacementBar
bool createProximalDisplacement = proximalDisplacement and barstate.isconfirmed and displacementBarNotRegistered
if createProximalDisplacement
    int displacementDirection = bullishDisplacement ? 1 : -1
    array.push(proximalDisplacementCeLines, na)
    array.push(proximalDisplacementCeLevels, displacementCe)
    array.push(proximalDisplacementCreationBars, bar_index)
    array.push(proximalDisplacementDirections, displacementDirection)
    array.push(proximalDisplacementMitigated, false)
    lastProximalDisplacementBar := bar_index

    while array.size(proximalDisplacementCeLevels) > maxProximalDisplacementCes
        line oldestCeLine = array.shift(proximalDisplacementCeLines)
        if not na(oldestCeLine)
            line.delete(oldestCeLine)
        array.shift(proximalDisplacementCeLevels)
        array.shift(proximalDisplacementCreationBars)
        array.shift(proximalDisplacementDirections)
        array.shift(proximalDisplacementMitigated)

// Only a later candle body can mitigate CE; wick-only and creation-bar contact do not count.
int proximalDisplacementCount = array.size(proximalDisplacementCeLevels)
if proximalDisplacementCount > 0
    float bodyLow = math.min(open, close)
    float bodyHigh = math.max(open, close)
    for displacementIndex = 0 to proximalDisplacementCount - 1
        bool isMitigated = array.get(proximalDisplacementMitigated, displacementIndex)
        int creationBar = array.get(proximalDisplacementCreationBars, displacementIndex)
        float ceLevel = array.get(proximalDisplacementCeLevels, displacementIndex)
        bool bodyTouchesCe = bodyLow <= ceLevel and bodyHigh >= ceLevel
        if not isMitigated and bar_index > creationBar and bodyTouchesCe
            array.set(proximalDisplacementMitigated, displacementIndex, true)
            isMitigated := true

        // Presentation objects are disposable; retained arrays above are canonical.
        line displacementCeLine = array.get(proximalDisplacementCeLines, displacementIndex)
        bool displacementCeVisible = showProximalDisplacement and showDisplacementCe
        int displacementDirection = array.get(proximalDisplacementDirections, displacementIndex)
        color displacementDisplayColor = isMitigated ? color.new(mitigatedDisplacementCeColor, 35) : displacementDirection == 1 ? bullishDisplacementCeColor : bearishDisplacementCeColor
        if displacementCeVisible
            if na(displacementCeLine)
                displacementCeLine := line.new(creationBar, ceLevel, creationBar + 1, ceLevel, xloc = xloc.bar_index, extend = extend.right, color = displacementDisplayColor, style = isMitigated ? line.style_dashed : line.style_dotted, width = 1)
                array.set(proximalDisplacementCeLines, displacementIndex, displacementCeLine)
            else
                line.set_color(displacementCeLine, displacementDisplayColor)
                line.set_style(displacementCeLine, isMitigated ? line.style_dashed : line.style_dotted)
                line.set_extend(displacementCeLine, extend.right)
        else if not na(displacementCeLine)
            line.delete(displacementCeLine)
            array.set(proximalDisplacementCeLines, displacementIndex, na)

// Canonical chart-timeframe FVG conditions remain unchanged.
bool bearishFvgBreakaway = low[2] <= open[1] and high >= close[1] and close < low[1] and low[2] - high > 0
bool bearishFvgRunaway = low[2] <= open[1] and high >= close[1] and close > low[1] and low[2] - high > 0
bool bullishFvgBreakaway = high[2] >= open[1] and low <= close[1] and close > high[1] and low - high[2] > 0
bool bullishFvgRunaway = high[2] >= open[1] and low <= close[1] and close < high[1] and low - high[2] > 0

bool bearishFvgIntersectsEvidenceEnvelope = low[2] >= evidenceEnvelopeLow and high <= evidenceEnvelopeHigh
bool bullishFvgIntersectsEvidenceEnvelope = low >= evidenceEnvelopeLow and high[2] <= evidenceEnvelopeHigh
bool bearishRunawayFromActiveDisplacement = bearishFvgRunaway and bearishDisplacement[1] and displacementIntersectsEvidenceEnvelope[1] and activeEvidenceGeometryAvailable[1] and bearishFvgIntersectsEvidenceEnvelope
bool bullishRunawayFromActiveDisplacement = bullishFvgRunaway and bullishDisplacement[1] and displacementIntersectsEvidenceEnvelope[1] and activeEvidenceGeometryAvailable[1] and bullishFvgIntersectsEvidenceEnvelope
bool bearishBreakerFvgQualified = bearishFvgBreakaway and bearishFvgIntersectsEvidenceEnvelope
bool bullishBreakerFvgQualified = bullishFvgBreakaway and bullishFvgIntersectsEvidenceEnvelope
bool createBearishProximalFvg = activeEvidenceGeometryAvailable and barstate.isconfirmed and (bearishRunawayFromActiveDisplacement or bearishBreakerFvgQualified)
bool createBullishProximalFvg = activeEvidenceGeometryAvailable and barstate.isconfirmed and (bullishRunawayFromActiveDisplacement or bullishBreakerFvgQualified)

var line[] proximalFvgCeLines = array.new_line()
var label[] proximalFvgLabels = array.new_label()
var float[] proximalFvgTops = array.new_float()
var float[] proximalFvgBottoms = array.new_float()
var float[] proximalFvgCeLevels = array.new_float()
var int[] proximalFvgDirections = array.new_int()
var int[] proximalFvgCreationBars = array.new_int()
var bool[] proximalFvgMitigated = array.new_bool()
var int[] proximalFvgMitigationBars = array.new_int()

if createBearishProximalFvg or createBullishProximalFvg
    int fvgDirection = createBullishProximalFvg ? 1 : -1
    float fvgTop = fvgDirection == 1 ? low : low[2]
    float fvgBottom = fvgDirection == 1 ? high[2] : high
    float fvgCe = (fvgTop + fvgBottom) / 2.0
    array.push(proximalFvgCeLines, na)
    array.push(proximalFvgLabels, na)
    array.push(proximalFvgTops, fvgTop)
    array.push(proximalFvgBottoms, fvgBottom)
    array.push(proximalFvgCeLevels, fvgCe)
    array.push(proximalFvgDirections, fvgDirection)
    array.push(proximalFvgCreationBars, bar_index)
    array.push(proximalFvgMitigated, false)
    array.push(proximalFvgMitigationBars, na)

    while array.size(proximalFvgCeLevels) > maxProximalFvgs
        line oldestFvgCeLine = array.shift(proximalFvgCeLines)
        if not na(oldestFvgCeLine)
            line.delete(oldestFvgCeLine)
        label oldestFvgLabel = array.shift(proximalFvgLabels)
        if not na(oldestFvgLabel)
            label.delete(oldestFvgLabel)
        array.shift(proximalFvgTops)
        array.shift(proximalFvgBottoms)
        array.shift(proximalFvgCeLevels)
        array.shift(proximalFvgDirections)
        array.shift(proximalFvgCreationBars)
        array.shift(proximalFvgMitigated)
        array.shift(proximalFvgMitigationBars)

int proximalFvgCount = array.size(proximalFvgCeLevels)
if proximalFvgCount > 0
    for fvgIndex = 0 to proximalFvgCount - 1
        // Stage A: advance the retained lifecycle before rendering its current state.
        bool fvgMitigated = array.get(proximalFvgMitigated, fvgIndex)
        int fvgCreationBar = array.get(proximalFvgCreationBars, fvgIndex)
        int fvgDirection = array.get(proximalFvgDirections, fvgIndex)
        float fvgCe = array.get(proximalFvgCeLevels, fvgIndex)
        int fvgMitigationBar = array.get(proximalFvgMitigationBars, fvgIndex)
        if barstate.isconfirmed and not fvgMitigated and bar_index > fvgCreationBar
            bool fvgCloseThroughCe = fvgDirection == 1 ? close < fvgCe : close > fvgCe
            if fvgCloseThroughCe
                array.set(proximalFvgMitigated, fvgIndex, true)
                array.set(proximalFvgMitigationBars, fvgIndex, bar_index)
                fvgMitigated := true
                fvgMitigationBar := bar_index

        // Stage B: create, update, or delete presentation objects only.
        color fvgColor = fvgDirection == 1 ? bullishFvgColor : bearishFvgColor
        line fvgCeLine = array.get(proximalFvgCeLines, fvgIndex)
        if showProximalFvg and showFvgCe
            int fvgCeRightBar = fvgMitigated and not na(fvgMitigationBar) ? fvgMitigationBar : fvgCreationBar + 1
            if na(fvgCeLine)
                fvgCeLine := line.new(fvgCreationBar, fvgCe, fvgCeRightBar, fvgCe, xloc = xloc.bar_index, extend = fvgMitigated ? extend.none : extend.right, color = fvgMitigated ? color.new(mitigatedFvgColor, 20) : color.new(fvgColor, 20), style = line.style_dashed, width = 1)
                array.set(proximalFvgCeLines, fvgIndex, fvgCeLine)
            else
                line.set_extend(fvgCeLine, fvgMitigated ? extend.none : extend.right)
                line.set_x2(fvgCeLine, fvgCeRightBar)
                line.set_color(fvgCeLine, fvgMitigated ? color.new(mitigatedFvgColor, 20) : color.new(fvgColor, 20))
        else if not na(fvgCeLine)
            line.delete(fvgCeLine)
            array.set(proximalFvgCeLines, fvgIndex, na)

        label fvgLabel = array.get(proximalFvgLabels, fvgIndex)
        if showProximalFvg and showFvgLabels
            if na(fvgLabel)
                fvgLabel := label.new(fvgCreationBar, fvgCe, "FVG", xloc = xloc.bar_index, style = label.style_none, textcolor = fvgMitigated ? color.new(mitigatedFvgColor, 0) : color.new(fvgColor, 0), size = size.tiny)
                array.set(proximalFvgLabels, fvgIndex, fvgLabel)
            else
                label.set_textcolor(fvgLabel, fvgMitigated ? color.new(mitigatedFvgColor, 0) : color.new(fvgColor, 0))
        else if not na(fvgLabel)
            label.delete(fvgLabel)
            array.set(proximalFvgLabels, fvgIndex, na)

// Canonical Classic Type 1 current-timeframe VI conditions and structural bounds.
bool bullishViSignal = open > close[1] and low <= high[1] and close > open and close[1] > open[1]
bool bearishViSignal = open < close[1] and high >= low[1] and close < open and close[1] < open[1]

float viTop = math.max(open, close[1])
float viBottom = math.min(open, close[1])
bool viIntersectsEvidenceEnvelope = viTop >= evidenceEnvelopeLow and viBottom <= evidenceEnvelopeHigh
bool createBullishProximalVi = activeEvidenceGeometryAvailable and barstate.isconfirmed and bullishViSignal and viIntersectsEvidenceEnvelope
bool createBearishProximalVi = activeEvidenceGeometryAvailable and barstate.isconfirmed and bearishViSignal and viIntersectsEvidenceEnvelope

var line[] proximalViCeLines = array.new_line()
var label[] proximalViLabels = array.new_label()
var float[] proximalViTops = array.new_float()
var float[] proximalViBottoms = array.new_float()
var float[] proximalViCeLevels = array.new_float()
var int[] proximalViDirections = array.new_int()
var int[] proximalViCreationBars = array.new_int()
var bool[] proximalViMitigated = array.new_bool()
var int[] proximalViMitigationBars = array.new_int()

if createBullishProximalVi or createBearishProximalVi
    int viDirection = createBullishProximalVi ? 1 : -1
    float viCe = (viTop + viBottom) / 2.0
    array.push(proximalViCeLines, na)
    array.push(proximalViLabels, na)
    array.push(proximalViTops, viTop)
    array.push(proximalViBottoms, viBottom)
    array.push(proximalViCeLevels, viCe)
    array.push(proximalViDirections, viDirection)
    array.push(proximalViCreationBars, bar_index)
    array.push(proximalViMitigated, false)
    array.push(proximalViMitigationBars, na)

    while array.size(proximalViCeLevels) > maxProximalVis
        line oldestViCeLine = array.shift(proximalViCeLines)
        if not na(oldestViCeLine)
            line.delete(oldestViCeLine)
        label oldestViLabel = array.shift(proximalViLabels)
        if not na(oldestViLabel)
            label.delete(oldestViLabel)
        array.shift(proximalViTops)
        array.shift(proximalViBottoms)
        array.shift(proximalViCeLevels)
        array.shift(proximalViDirections)
        array.shift(proximalViCreationBars)
        array.shift(proximalViMitigated)
        array.shift(proximalViMitigationBars)

int proximalViCount = array.size(proximalViCeLevels)
if proximalViCount > 0
    for viIndex = 0 to proximalViCount - 1
        // Stage A: advance the retained lifecycle before rendering its current state.
        bool viMitigated = array.get(proximalViMitigated, viIndex)
        int viCreationBar = array.get(proximalViCreationBars, viIndex)
        int viDirection = array.get(proximalViDirections, viIndex)
        float viCe = array.get(proximalViCeLevels, viIndex)
        int viMitigationBar = array.get(proximalViMitigationBars, viIndex)
        if barstate.isconfirmed and not viMitigated and bar_index > viCreationBar
            bool viCloseThroughCe = viDirection == 1 ? close < viCe : close > viCe
            if viCloseThroughCe
                array.set(proximalViMitigated, viIndex, true)
                array.set(proximalViMitigationBars, viIndex, bar_index)
                viMitigated := true
                viMitigationBar := bar_index

        // Stage B: create, update, or delete presentation objects only.
        color viColor = viDirection == 1 ? bullishViColor : bearishViColor
        line viCeLine = array.get(proximalViCeLines, viIndex)
        if showProximalVi and showViCe
            int viCeRightBar = viMitigated and not na(viMitigationBar) ? viMitigationBar : viCreationBar + 1
            if na(viCeLine)
                viCeLine := line.new(viCreationBar, viCe, viCeRightBar, viCe, xloc = xloc.bar_index, extend = viMitigated ? extend.none : extend.right, color = viMitigated ? color.new(mitigatedViColor, 20) : color.new(viColor, 20), style = line.style_solid, width = 1)
                array.set(proximalViCeLines, viIndex, viCeLine)
            else
                line.set_extend(viCeLine, viMitigated ? extend.none : extend.right)
                line.set_x2(viCeLine, viCeRightBar)
                line.set_color(viCeLine, viMitigated ? color.new(mitigatedViColor, 20) : color.new(viColor, 20))
        else if not na(viCeLine)
            line.delete(viCeLine)
            array.set(proximalViCeLines, viIndex, na)

        label viLabel = array.get(proximalViLabels, viIndex)
        if showProximalVi and showViLabels
            if na(viLabel)
                viLabel := label.new(viCreationBar, viCe, "VI", xloc = xloc.bar_index, style = label.style_none, textcolor = viMitigated ? color.new(mitigatedViColor, 0) : color.new(viColor, 0), size = size.tiny)
                array.set(proximalViLabels, viIndex, viLabel)
            else
                label.set_textcolor(viLabel, viMitigated ? color.new(mitigatedViColor, 0) : color.new(viColor, 0))
        else if not na(viLabel)
            label.delete(viLabel)
            array.set(proximalViLabels, viIndex, na)

// Canonical current-timeframe OB pattern from pine/OB.pine. The opposite candle at [3]
// supplies the structural bounds; the signal is registered only on its confirmed edge.
bool bullishObSignal = close[4] > open[4] and close[3] < open[3] and close[2] > open[2] and close[1] > open[1] and close > open
bool bearishObSignal = close[4] < open[4] and close[3] > open[3] and close[2] < open[2] and close[1] < open[1] and close < open
bool newBullishObSignal = barstate.isconfirmed and bullishObSignal and not bullishObSignal[1]
bool newBearishObSignal = barstate.isconfirmed and bearishObSignal and not bearishObSignal[1]
float obTop = high[3]
float obBottom = low[3]
bool obIntersectsEvidenceEnvelope = obTop >= evidenceEnvelopeLow and obBottom <= evidenceEnvelopeHigh
bool bullishActiveObQualified = activeEvidenceGeometryAvailable and newBullishObSignal and obIntersectsEvidenceEnvelope
bool bearishActiveObQualified = activeEvidenceGeometryAvailable and newBearishObSignal and obIntersectsEvidenceEnvelope
bool createBullishActiveOb = bullishActiveObQualified
bool createBearishActiveOb = bearishActiveObQualified

var box[] activeObBoxes = array.new_box()
var line[] activeObCeLines = array.new_line()
var label[] activeObLabels = array.new_label()
var float[] activeObTops = array.new_float()
var float[] activeObBottoms = array.new_float()
var int[] activeObDirections = array.new_int()
var color[] activeObBaseColors = array.new_color()
var int[] activeObCreationBars = array.new_int()
var int[] activeObLeftTimes = array.new_int()
var bool[] activeObInteracted = array.new_bool()
var bool[] activeObCeInteracted = array.new_bool()
var bool[] activeObInvalidated = array.new_bool()

if createBullishActiveOb or createBearishActiveOb
    int obDirection = createBullishActiveOb ? 1 : -1
    float activeObCe = (obTop + obBottom) / 2.0
    color activeObColor = obDirection == 1 ? bullishObColor : bearishObColor
    // Clamp the canonical source-candle start to the active episode boundary.
    int activeObLeftTime = math.max(time[3], currentActivationTime)
    array.push(activeObBoxes, na)
    array.push(activeObCeLines, na)
    array.push(activeObLabels, na)
    array.push(activeObTops, obTop)
    array.push(activeObBottoms, obBottom)
    array.push(activeObDirections, obDirection)
    array.push(activeObBaseColors, activeObColor)
    array.push(activeObCreationBars, bar_index)
    array.push(activeObLeftTimes, activeObLeftTime)
    array.push(activeObInteracted, false)
    array.push(activeObCeInteracted, false)
    array.push(activeObInvalidated, false)

    while array.size(activeObTops) > maxActiveObs
        box oldestObBox = array.shift(activeObBoxes)
        if not na(oldestObBox)
            box.delete(oldestObBox)
        line oldestObCeLine = array.shift(activeObCeLines)
        if not na(oldestObCeLine)
            line.delete(oldestObCeLine)
        label oldestObLabel = array.shift(activeObLabels)
        if not na(oldestObLabel)
            label.delete(oldestObLabel)
        array.shift(activeObTops)
        array.shift(activeObBottoms)
        array.shift(activeObDirections)
        array.shift(activeObBaseColors)
        array.shift(activeObCreationBars)
        array.shift(activeObLeftTimes)
        array.shift(activeObInteracted)
        array.shift(activeObCeInteracted)
        array.shift(activeObInvalidated)

// OB interaction and CE interaction are observational, latched states. A confirmed
// distal-bound close permanently invalidates the OB; later reclaims cannot resurrect it.
int activeObCount = array.size(activeObTops)
if activeObCount > 0
    for obIndex = 0 to activeObCount - 1
        box activeObBox = array.get(activeObBoxes, obIndex)
        line activeObCeLine = array.get(activeObCeLines, obIndex)
        label activeObLabel = array.get(activeObLabels, obIndex)
        float activeObTop = array.get(activeObTops, obIndex)
        float activeObBottom = array.get(activeObBottoms, obIndex)
        int activeObDirection = array.get(activeObDirections, obIndex)
        color activeObBaseColor = array.get(activeObBaseColors, obIndex)
        int activeObCreationBar = array.get(activeObCreationBars, obIndex)
        int activeObLeftTime = array.get(activeObLeftTimes, obIndex)
        bool obInvalidated = array.get(activeObInvalidated, obIndex)
        if barstate.isconfirmed and bar_index > activeObCreationBar and not obInvalidated
            float activeObCe = (activeObTop + activeObBottom) / 2.0
            bool obRangeInteracted = high >= activeObBottom and low <= activeObTop
            bool obCeWasInteracted = low <= activeObCe and high >= activeObCe
            if obRangeInteracted
                array.set(activeObInteracted, obIndex, true)
            if obCeWasInteracted
                array.set(activeObCeInteracted, obIndex, true)
            bool obInvalidationConfirmed = activeObDirection == 1 ? close < activeObBottom : close > activeObTop
            if obInvalidationConfirmed
                array.set(activeObInvalidated, obIndex, true)
                obInvalidated := true
        // Stage B renders the retained terminal lifecycle state without mutating it.
        color activeObDisplayColor = obInvalidated ? invalidatedObColor : activeObBaseColor

        if showActiveOb
            if na(activeObBox)
                activeObBox := box.new(activeObLeftTime, activeObTop, time, activeObBottom, xloc = xloc.bar_time, bgcolor = activeObDisplayColor, border_color = obInvalidated ? na : color.new(activeObBaseColor, 0))
                array.set(activeObBoxes, obIndex, activeObBox)
            else
                box.set_right(activeObBox, time)
                box.set_bgcolor(activeObBox, activeObDisplayColor)
                box.set_border_color(activeObBox, obInvalidated ? na : color.new(activeObBaseColor, 0))
        else if not na(activeObBox)
            box.delete(activeObBox)
            array.set(activeObBoxes, obIndex, na)

        if showActiveOb and showObCe
            float activeObCe = (activeObTop + activeObBottom) / 2.0
            if na(activeObCeLine)
                activeObCeLine := line.new(activeObLeftTime, activeObCe, time, activeObCe, xloc = xloc.bar_time, extend = extend.right, color = color.new(activeObDisplayColor, obInvalidated ? 65 : 20), style = line.style_dotted, width = 1)
                array.set(activeObCeLines, obIndex, activeObCeLine)
            else
                line.set_color(activeObCeLine, color.new(activeObDisplayColor, obInvalidated ? 65 : 20))
                line.set_extend(activeObCeLine, extend.right)
        else if not na(activeObCeLine)
            line.delete(activeObCeLine)
            array.set(activeObCeLines, obIndex, na)

        if showActiveOb and showObLabels
            float activeObCe = (activeObTop + activeObBottom) / 2.0
            if na(activeObLabel)
                activeObLabel := label.new(activeObLeftTime, activeObCe, activeObDirection == 1 ? "OB+" : "OB-", xloc = xloc.bar_time, style = label.style_none, textcolor = color.new(activeObDisplayColor, obInvalidated ? 55 : 0), size = size.tiny)
                array.set(activeObLabels, obIndex, activeObLabel)
            else
                label.set_textcolor(activeObLabel, color.new(activeObDisplayColor, obInvalidated ? 55 : 0))
        else if not na(activeObLabel)
            label.delete(activeObLabel)
            array.set(activeObLabels, obIndex, na)

var line currentActivationLine = na
var line previousActivationLine = na
if barstate.islast
    if currentMrzVisible
        if na(currentActivationLine)
            currentActivationLine := line.new(currentActivationTime, currentMrzLower, currentActivationTime, currentMrzUpper, xloc = xloc.bar_time, extend = extend.both, color = color.new(currentMidpointColor, 10), style = line.style_dashed, width = 1)
        else
            line.set_xy1(currentActivationLine, currentActivationTime, currentMrzLower)
            line.set_xy2(currentActivationLine, currentActivationTime, currentMrzUpper)
    else if not na(currentActivationLine)
        line.delete(currentActivationLine)
        currentActivationLine := na

    if previousMrzVisible
        if na(previousActivationLine)
            previousActivationLine := line.new(previousActivationTime, previousMrzLower, previousActivationTime, previousMrzUpper, xloc = xloc.bar_time, extend = extend.both, color = previousBoundaryColor, style = line.style_dashed, width = 1)
        else
            line.set_xy1(previousActivationLine, previousActivationTime, previousMrzLower)
            line.set_xy2(previousActivationLine, previousActivationTime, previousMrzUpper)
    else if not na(previousActivationLine)
        line.delete(previousActivationLine)
        previousActivationLine := na

var table symbolGuard = table.new(position.top_right, 1, 1)
if barstate.islast
    string guardText = not symbolConfigured ? "Configure MRZ symbol" : not symbolMatches ? "MRZ hidden — configured for " + configuredSymbol : ""
    color guardBackground = not symbolConfigured ? color.new(color.orange, 15) : not symbolMatches ? color.new(color.red, 15) : color.new(color.black, 100)
    table.cell(symbolGuard, 0, 0, guardText, text_color = color.white, bgcolor = guardBackground)
